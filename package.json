{
  "name": "giftbox-game",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "start:cluster": "pm2 start ecosystem.config.cjs --env production",
    "restart:cluster": "pm2 reload ecosystem.config.cjs --env production",
    "db:preflight": "node migrations/preflight-check.js",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand --forceExit",
    "verify:runtime": "node tools/verify-runtime.js",
    "i18n:extract": "py -3 tools/extract_i18n_manual.py --root . --out-dir config",
    "i18n:backfill": "node tools/backfill_i18n_from_dictionary.js",
    "i18n:extract:admin": "npm run i18n:extract && node tools/build_admin_i18n_scope.js",
    "check:encoding": "node tools/check-hardcoded-encoding.js",
    "i18n:admin:refresh": "npm run i18n:extract && npm run i18n:backfill && node tools/build_admin_i18n_scope.js",
    "i18n:admin:csv": "npm run i18n:admin:refresh && node tools/prioritize_admin_i18n_todo.js && node tools/export_admin_i18n_csv.js",
    "i18n:admin:import-csv": "node tools/import_admin_i18n_csv.js",
    "i18n:admin:translate-top100": "node tools/apply_admin_top100_manual_batch.js && node tools/build_admin_i18n_scope.js && node tools/prioritize_admin_i18n_todo.js",
    "build:js": "babel public/js --out-dir public/build-legacy --ignore \"**/*.min.js,**/*.min.js.gz,**/*.min.js.br,**/*.react.jsx\"",
    "build:js:watch": "babel public/js --out-dir public/build-legacy --ignore \"**/*.min.js,**/*.min.js.gz,**/*.min.js.br,**/*.react.jsx\" --watch",
    "build:legacy": "node tools/build-assets.js",
    "build:modern": "node tools/build-modern.js",
    "build:assets": "node tools/build-assets.js",
    "build:clean": "node tools/build-assets.js --clean",
    "build": "node tools/build-assets.js",
    "postinstall": "node tools/build-assets.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "abortcontroller-polyfill": "^1.7.8",
    "adm-zip": "^0.5.17",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.2",
    "compression": "^1.8.1",
    "connect-session-sequelize": "^8.0.5",
    "cookie-parser": "^1.4.7",
    "core-js": "^3.49.0",
    "core-js-bundle": "^3.49.0",
    "dotenv": "^17.2.4",
    "ejs": "^4.0.1",
    "emoji-mart": "^5.6.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.19.0",
    "express-validator": "^7.0.0",
    "multer": "^2.0.2",
    "mysql2": "^3.16.3",
    "node-fetch": "^3.3.2",
    "regenerator-runtime": "^0.14.1",
    "sequelize": "^6.37.7",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "whatwg-fetch": "^3.6.20",
    "ws": "^8.19.0",
    "xss": "^1.0.14"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "clean-css": "^5.3.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "sharp": "^0.34.5",
    "sqlite3": "^5.1.6",
    "supertest": "^6.3.3",
    "terser": "^5.46.1"
  }
}
