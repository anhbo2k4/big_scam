/* ===== FLOATING NOTIFICATION ===== */
.floating-notice {
  position: fixed;
  right: 14px;
  bottom: 14px;
  width: min(420px, calc(100vw - 16px));
  border-radius: 16px;
  border: 1px solid rgba(148,163,184,.36);
  background:
    radial-gradient(130% 130% at 100% 0%, rgba(56,189,248,.16) 0%, rgba(15,23,42,.04) 60%),
    linear-gradient(160deg, rgba(9,18,33,.98), rgba(11,21,40,.97));
  box-shadow: 0 24px 52px rgba(2,8,22,.5);
  color: #e2e8f0;
  z-index: 2000;
  overflow: hidden;
}
.floating-notice::before {
  content: '';
  position: absolute;
  inset: -1px;
  border-radius: inherit;
  border: 1px solid rgba(255,255,255,.07);
  pointer-events: none;
}
.floating-notice.show {
  display: block !important;
  animation: noticeSlideIn .28s cubic-bezier(.22,.92,.26,1);
}
.floating-notice.hide {
  animation: noticeSlideOut .26s ease forwards;
}
.floating-notice-body {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 11px;
  align-items: start;
  padding: 12px 13px 11px;
}
.floating-notice-glow {
  position: absolute;
  right: -34px;
  top: -34px;
  width: 120px;
  height: 120px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(56,189,248,.24), transparent 72%);
  pointer-events: none;
}
.floating-notice-icon {
  width: 36px;
  height: 36px;
  border-radius: 11px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 17px;
  background: rgba(59,130,246,.16);
  border: 1px solid rgba(125,211,252,.35);
}
.floating-notice-content {
  min-width: 0;
}
.floating-notice-meta {
  display: flex;
  align-items: center;
  gap: 7px;
  flex-wrap: wrap;
  margin-bottom: 2px;
}
.floating-notice-tag {
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .04em;
  color: #dbeafe;
  border: 1px solid rgba(147,197,253,.35);
  background: rgba(59,130,246,.16);
  border-radius: 999px;
  padding: 1px 7px;
}
.floating-notice-time {
  font-size: 10px;
  font-weight: 700;
  color: #9fb2cc;
}
.floating-notice-title {
  font-size: 13px;
  font-weight: 800;
  color: #f1f5f9;
}
.floating-notice-message {
  margin-top: 2px;
  font-size: 12px;
  color: #c1d4ea;
  line-height: 1.45;
}
.floating-notice-close {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  border: 1px solid rgba(148,163,184,.35);
  background: rgba(15,23,42,.65);
  color: #cbd5e1;
  cursor: pointer;
}
.floating-notice-close:hover {
  background: rgba(30,41,59,.9);
}
.floating-notice-progress {
  height: 3px;
  background: rgba(148,163,184,.2);
}
.floating-notice-progress > span {
  display: block;
  height: 100%;
  width: 100%;
  background: linear-gradient(90deg, #22d3ee, #3b82f6);
  transform-origin: left;
  animation: noticeProgress 4.2s linear forwards;
}
.floating-notice.success .floating-notice-icon { background: rgba(34,197,94,.2); }
.floating-notice.success .floating-notice-tag { color: #bbf7d0; border-color: rgba(74,222,128,.36); background: rgba(22,163,74,.18); }
.floating-notice.success .floating-notice-progress > span { background: linear-gradient(90deg, #22c55e, #4ade80); }
.floating-notice.error .floating-notice-icon { background: rgba(239,68,68,.2); }
.floating-notice.error .floating-notice-tag { color: #fecaca; border-color: rgba(248,113,113,.36); background: rgba(185,28,28,.2); }
.floating-notice.error .floating-notice-progress > span { background: linear-gradient(90deg, #ef4444, #f97316); }
.floating-notice.warning .floating-notice-icon { background: rgba(250,204,21,.2); }
.floating-notice.warning .floating-notice-tag { color: #fde68a; border-color: rgba(245,158,11,.36); background: rgba(180,83,9,.2); }
.floating-notice.warning .floating-notice-progress > span { background: linear-gradient(90deg, #f59e0b, #eab308); }

@media (max-width: 980px) {
  .floating-notice {
    right: 8px;
    left: 8px;
    bottom: calc(8px + env(safe-area-inset-bottom));
    width: auto;
  }
}

@keyframes noticeSlideIn {
  from { opacity: 0; transform: translateX(22px) scale(.97); }
  to { opacity: 1; transform: translateX(0) scale(1); }
}
@keyframes noticeSlideOut {
  from { opacity: 1; transform: translateX(0) scale(1); }
  to { opacity: 0; transform: translateX(36px) scale(.96); }
}
@keyframes noticeProgress {
  from { transform: scaleX(1); }
  to { transform: scaleX(0); }
}

/* ===== SCALE HOVER EFFECT - TARGETED ===== */
.template-card, .wd-card-item, .session-card,
.btn-user-action, .btn-gen-code, .icon-btn, .box-order-item,
.prize-box-card,
.toggle-track, .radio-label, .file-card, .notification-item {
