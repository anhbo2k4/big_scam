  background: linear-gradient(90deg, rgba(99,102,241,0.14), rgba(99,102,241,0.03));
  border: 1.5px solid rgba(99,102,241,0.35); border-radius: 10px; padding: 8px 14px;
}
.icon-preview-emoji {
  font-size: 28px; line-height: 1;
  filter: drop-shadow(0 2px 8px rgba(99,102,241,0.55));
  transition: all 0.25s cubic-bezier(0.34,1.56,0.64,1);
}
.icon-preview-text { font-size: 12px; color: #9ca3af; }
.icon-preview-name {
  color: #fef3c7;
  font-weight: 800;
  font-size: 20px;
  margin-left: 4px;
  transition: all 0.2s;
  background: linear-gradient(135deg, rgba(185,28,28,0.85), rgba(234,88,12,0.85));
  border: 1px solid rgba(251,191,36,0.5);
  border-radius: 999px;
  padding: 2px 10px;
  display: inline-flex;
  align-items: center;
  min-height: 28px;
}
.icon-grid {
  display: grid !important; grid-template-columns: repeat(9, minmax(0, 1fr)) !important; gap: 1px;
  background: linear-gradient(135deg, #0d1424 0%, #111827 100%);
  border: 1.5px solid rgba(99,102,241,0.22); border-radius: 12px; padding: 8px;
  width: 100%; box-sizing: border-box; max-height: 200px; overflow-y: auto;
  scrollbar-width: thin; scrollbar-color: rgba(99,102,241,0.4) transparent;
}
.icon-grid::-webkit-scrollbar { width: 4px; }
.icon-grid::-webkit-scrollbar-thumb { background: rgba(99,102,241,0.4); border-radius: 4px; }
.icon-grid .icon-btn {
  width: 100%; aspect-ratio: 1; border-radius: 8px;
  background: rgba(255,255,255,0.04); border: 1.5px solid transparent;
  font-size: 20px; cursor: pointer; transition: background 0.16s ease, border-color 0.16s ease, box-shadow 0.16s ease;
  display: flex; align-items: center; justify-content: center;
  outline: none; position: relative;
  min-height: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
  line-height: 1;
  transform: none !important;
}
.icon-grid .icon-btn:hover {
  background: rgba(99,102,241,0.18); border-color: rgba(99,102,241,0.5);
  transform: none !important;
  box-shadow: 0 4px 14px rgba(99,102,241,0.3);
}
.icon-grid .icon-btn.active {
  border-color: #6366f1; background: rgba(99,102,241,0.26);
  transform: none !important;
  box-shadow: 0 0 0 2.5px rgba(99,102,241,0.45), 0 4px 18px rgba(99,102,241,0.35);
}

.icon-grid .icon-btn.lucky-red {
  background: linear-gradient(160deg, rgba(220,38,38,0.34), rgba(234,88,12,0.26));
  border-color: rgba(251,191,36,0.35);
}

.icon-grid .icon-btn.lucky-red:hover {
  background: linear-gradient(160deg, rgba(239,68,68,0.44), rgba(249,115,22,0.3));
  border-color: rgba(251,191,36,0.7);
  box-shadow: 0 4px 14px rgba(239,68,68,0.28);
}

.icon-grid .icon-btn.lucky-red.active {
  border-color: #fbbf24;
  box-shadow: 0 0 0 2.5px rgba(251,191,36,0.45), 0 5px 16px rgba(239,68,68,0.35);
}

.icon-grid .icon-btn:active {
  transform: none !important;
}

.icon-grid .icon-btn::after {
  display: none;
}

/* Pagination Styles */
.pagination-wrap {
  display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 30px; flex-wrap: wrap;
}
.pagination-btn {
  padding: 8px 12px; border: 1px solid rgba(255,255,255,0.2); background: #111827; color: #e5e7eb;
  border-radius: 6px; cursor: pointer; transition: all 0.2s; font-size: 13px;
}
.pagination-btn:hover { border-color: var(--blue); background: rgba(59,130,246,0.1); }
.pagination-btn.active {
  background: var(--blue); color: white; border-color: var(--blue);
}
.pagination-btn:disabled {
  opacity: 0.5; cursor: not-allowed;
}
.pagination-info {
  color: #9ca3af; font-size: 13px; margin: 0 8px;
}

/* Enhanced Session Card */
/* ── Session Card ───────────────────────── */
.session-card-wrap {
  transition: transform .22s; overflow: visible; min-width: 0;
}
.session-card-wrap:hover { transform: translateY(-2px); }
.session-card {
  background: #1e293b;
  color: #e2e8f0;
  border: 1px solid #334155;
  border-left: 3px solid #3b82f6;
  border-radius: 10px;
  padding: 0;
  cursor: pointer;
  position: relative;
  overflow: visible;
  display: flex;
  flex-direction: column;
  box-shadow: 0 2px 10px rgba(0,0,0,.4);
  min-width: 0;
  transition: box-shadow .22s;
}
.session-card:hover { box-shadow: 0 6px 24px rgba(0,0,0,.55); }
.session-card::before { display: none; }

/* Header */
.session-card-header { padding: 16px 18px 10px; }
.session-header-top {
  display: flex; justify-content: space-between; align-items: flex-start;
  gap: 8px; margin-bottom: 10px;
}
.session-code-row { display: flex; align-items: center; gap: 7px; }
.session-card .session-code {
  font-size: 1.1rem !important; font-weight: 800 !important;
  color: #f1f5f9; line-height: 1.2;
}
.session-card .copy-btn {
  background: none; border: none; color: #475569; border-radius: 4px;
  width: 22px; height: 22px; padding: 2px;
  cursor: pointer; display: flex; align-items: center; justify-content: center;
  transition: color .15s; flex-shrink: 0;
}
.session-card .copy-btn:hover { color: #94a3b8; }
.session-meta-col { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }
.session-header-date { display: flex; align-items: center; gap: 4px; font-size: 0.67rem; color: #64748b; }
.session-header-right-row { display: flex; align-items: center; gap: 6px; }
.session-header-admin { display: flex; align-items: center; gap: 3px; font-size: 0.67rem; color: #64748b; }
.session-score-badge {
  background: #052e16; border: 1px solid #166534; border-radius: 5px;
  padding: 2px 7px; display: inline-flex; align-items: center; gap: 4px;
  font-size: 0.68rem; font-weight: 700; color: #22c55e;
}
.session-score-badge.mid { background: rgba(161,98,7,0.15); border-color: rgba(161,98,7,0.5); color: #fbbf24; }
.session-score-badge.low { background: rgba(127,29,29,0.25); border-color: rgba(239,68,68,0.45); color: #f87171; }
.session-wallet-header-badge {
  display: inline-flex; align-items: center; gap: 4px;
  background: rgba(34,197,94,.08); border: 1px solid rgba(34,197,94,.25);
  border-radius: 5px; padding: 2px 7px;
  font-size: 0.68rem; font-weight: 700; color: #22c55e;
}
.trust-edit-btn {
  border: none; background: none; color: #374151;
  width: 14px; height: 14px; cursor: pointer;
  display: inline-flex; align-items: center; justify-content: center; font-size: 9px; padding: 0;
}
.trust-edit-btn:hover { color: #3b82f6; }

/* Status badge — white pill, inside header */
.session-status-row { margin-top: 4px; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.session-chip {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 3px 10px; border-radius: 999px; font-size: 0.7rem; font-weight: 600;
  background: #fff; border: 1px solid #e2e8f0; color: #0f172a; white-space: nowrap;
}
.session-chip-status.paused { background: #1e293b; border-color: #475569; color: #94a3b8; }
.session-chip-dot { display: none; }
.session-chip-owner { background: rgba(59,130,246,0.12); border-color: rgba(96,165,250,0.3); color: #93c5fd; }
.session-chip-row { display: none; }
.session-card-meta { display: flex; gap: 8px; flex-wrap: wrap; font-size: 11.5px; color: var(--text3); }

/* Body */
.session-card-body { padding: 0 18px 14px; display: flex; flex-direction: column; gap: 12px; }

/* Progress box */
.session-progress-wrap { background: #0f172a; border-radius: 8px; padding: 10px 14px; border: 1px solid #2d3f55; }
.session-progress-label { display: flex; justify-content: space-between; align-items: center; margin-bottom: 7px; }
.session-progress-title { font-size: 0.76rem; font-weight: 600; color: #cbd5e1; }
.session-progress-value {
  font-size: 0.72rem; font-weight: 700; color: #60a5fa;
  background: rgba(96,165,250,.12); padding: 1px 8px;
  border-radius: 999px; border: 1px solid rgba(96,165,250,.2);
}
.session-progress-bar { width: 100%; height: 5px; background: #1e3a5f; border-radius: 999px; overflow: hidden; }
.session-progress-fill {
  height: 100%; border-radius: 999px;
  background: linear-gradient(90deg, #3b82f6, #8b5cf6);
  box-shadow: 0 0 6px rgba(59,130,246,.4); transition: width .3s ease;
}
.session-progress-footer { display: flex; justify-content: space-between; margin-top: 7px; font-size: 0.67rem; color: #64748b; }

/* Wallet row */
.session-wallet-row {
  display: flex; justify-content: space-between; align-items: center;
  margin-top: 8px; padding-top: 7px; border-top: 1px solid #2d3f55;
}
.session-wallet-label {
  display: flex; align-items: center; gap: 4px;
  font-size: 0.67rem; color: #64748b;
}
.session-wallet-amount {
  font-size: 0.72rem; font-weight: 700; color: #22c55e;
  background: rgba(34,197,94,.08); padding: 1px 8px;
  border-radius: 999px; border: 1px solid rgba(34,197,94,.18);
}
.session-wallet-edit-btn {
  display: inline-flex; align-items: center; justify-content: center;
  width: 20px; height: 20px; border: none; border-radius: 5px;
  background: none; cursor: pointer; color: #64748b; padding: 0;
  transition: color .15s, background .15s; flex-shrink: 0; margin-left: 4px;
}
.session-wallet-edit-btn:hover { color: #94a3b8; background: rgba(148,163,184,.12); }

/* Special approval */
.session-special-wrap {
  margin: 0; padding: 12px; border-radius: 10px;
  border: 1px solid rgba(245,158,11,0.52);
  background: linear-gradient(145deg, rgba(92,38,6,0.45), rgba(20,30,52,0.72));
  cursor: pointer; transition: border-color .2s, box-shadow .2s;
}
.session-special-wrap:hover { border-color: rgba(245,158,11,0.8); box-shadow: 0 0 22px rgba(245,158,11,0.2); }
.session-special-head { display: flex; justify-content: space-between; align-items: center; font-size: 13px; font-weight: 800; color: #facc15; margin-bottom: 8px; }
.session-special-count { min-width: 24px; height: 24px; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center; background: rgba(250,204,21,0.2); border: 1px solid rgba(250,204,21,0.55); color: #fde68a; }
.session-special-item { display: flex; align-items: center; justify-content: space-between; gap: 8px; background: rgba(100,116,139,0.22); border: 1px solid rgba(148,163,184,0.36); border-radius: 8px; padding: 6px 8px; }
.session-special-item + .session-special-item { margin-top: 5px; }
.session-special-item-meta { font-size: 11px; color: #94a3b8; }
.session-special-item-name { font-size: 13px; font-weight: 700; color: #e2e8f0; line-height: 1.25; }
.session-special-item-actions { display: flex; gap: 8px; }
.session-special-act { width: 28px; height: 28px; border-radius: 7px; border: 1px solid transparent; background: rgba(15,23,42,0.7); color: #e2e8f0; cursor: pointer; font-size: 12px; transition: all .18s; }
.session-special-act:hover { transform: scale(1.12); }
.session-special-act.ok { border-color: rgba(34,197,94,0.55); color: #4ade80; }
.session-special-act.ok:hover { background: rgba(34,197,94,0.22); border-color: rgba(34,197,94,0.8); }
.session-special-act.no { border-color: rgba(239,68,68,0.55); color: #f87171; }
.session-special-act.no:hover { background: rgba(239,68,68,0.22); border-color: rgba(239,68,68,0.8); }

/* Actions — inside body, last item */
.session-card-actions { display: flex; gap: 5px; }
.session-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 4px;
  height: 32px; padding: 0 10px; border-radius: 7px;
  font-size: 0.7rem; font-weight: 500; cursor: pointer;
  background: #1e293b; border: 1px solid #334155; color: #cbd5e1;
  transition: all .15s; white-space: nowrap; font-family: inherit;
}
.session-btn:hover { background: #253347; border-color: #475569; }
.session-btn:active { transform: scale(.96); }
.session-btn-copy-wide { flex: 1; justify-content: center; }
.session-btn-icon { width: 32px; min-width: 32px; padding: 0; flex-shrink: 0; }
.session-btn-edit { }
.session-btn-toggle.pause { color: #f97316; }
.session-btn-toggle.pause:hover { background: rgba(249,115,22,.08); border-color: rgba(249,115,22,.3); }
.session-btn-toggle.resume { color: #34d399; }
.session-btn-toggle.resume:hover { background: rgba(52,211,153,.08); border-color: rgba(52,211,153,.3); }
.session-btn-delete { color: #ef4444; }
.session-btn-delete:hover { background: rgba(239,68,68,.08); border-color: rgba(239,68,68,.3); }


#sessionsContainer {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
  align-items: start;
  overflow: visible;
}

@media (max-width: 1024px) {
  #sessionsContainer { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  #sessionsContainer { grid-template-columns: 1fr; }
}

/* Prize Preview Grid */
.prize-preview-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px;
  overflow: visible; padding-top: 8px;
}
.prize-preview-cell {
  display: flex; flex-direction: column; gap: 4px;
  min-width: 0; position: relative;
}
.prize-num-badge {
  position: absolute; top: -8px; left: -8px;
  background: #3b82f6; color: #fff;
  font-size: 0.58rem; font-weight: 800;
  width: 19px; height: 19px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  z-index: 10; box-shadow: 0 2px 6px rgba(59,130,246,.5);
  outline: 2px solid #1e293b;
}

.session-card .prize-preview-grid { display: grid !important; visibility: visible !important; opacity: 1 !important; }
.session-card .prize-preview-item { display: flex !important; visibility: visible !important; opacity: 1 !important; }
.prize-preview-item {
  background: #0f172a;
  border: 1px solid #2d3f55;
  border-radius: 8px;
  padding: 13px 6px 8px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  height: 116px;
  overflow: visible;
  min-width: 0;
  transition: border-color .18s;
}
.prize-preview-item:hover { border-color: #475569; }
.prize-icon-wrap {
  display: flex; justify-content: center; align-items: center;
  height: 27px; margin-bottom: 4px; position: relative;
  width: 100%; flex-shrink: 0;
}
.prize-icon-crown {
  position: absolute; top: -2px; right: calc(50% - 19px);
  color: #f5c542; filter: drop-shadow(0 0 3px rgba(245,197,66,.6));
  font-size: 11px; line-height: 1;
}
.prize-preview-icon { font-size: 1.15rem; line-height: 1; }
.prize-preview-name {
  font-size: 0.6rem; color: #64748b;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  margin-bottom: 3px; flex-shrink: 0;
  width: 100%; min-width: 0;
}
.prize-preview-amount {
  font-size: 0.64rem; color: #22c55e; font-weight: 600;
  display: flex; align-items: center; justify-content: center; gap: 3px;
  flex-shrink: 0; width: 100%; min-width: 0; overflow: hidden;
}
.prize-preview-amount > span {
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0;
}
.prize-amount-edit-btn {
  border: none; width: 14px; height: 14px;
  background: none; color: #374151;
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 9px; cursor: pointer; flex-shrink: 0; padding: 0;
  transition: color .15s;
}
.prize-amount-edit-btn:hover { color: #3b82f6; }
.prize-inv-lock {
  margin-top: auto; font-size: 0.6rem; color: #374151; flex-shrink: 0; text-align: center;
}
.prize-inv-lock.opened {
  color: #22c55e; background: rgba(34,197,94,.07);
  padding: 2px 7px; border-radius: 999px;
  border: 1px solid rgba(34,197,94,.15); display: inline-block;
}
.prize-dollar-btn-wrap {
  display: flex; justify-content: center; align-items: center;
  margin-top: auto; flex-shrink: 0;
}
.prize-dollar-btn {
  background: none; border: none; cursor: pointer;
  color: #64748b; padding: 3px; border-radius: 4px;
  display: flex; align-items: center; transition: color .15s;
}
.prize-dollar-btn:hover { color: #22c55e; }
.prize-preview-inv {
  display: block; width: 100%; padding: 3px 6px; border-radius: 999px;
  font-size: 9px; font-weight: 700;
  background: rgba(148,163,184,0.12); color: #64748b;
  letter-spacing: .02em; white-space: nowrap; overflow: hidden;
  text-overflow: ellipsis; text-align: center;
}
.prize-preview-inv.inv-ok { background: rgba(34,197,94,0.15); color: #4ade80; }
.prize-preview-inv.inv-pending { background: rgba(234,179,8,0.15); color: #facc15; }
.prize-preview-inv.inv-bad { background: rgba(239,68,68,0.15); color: #f87171; }
.prize-preview-inv.inv-unopened { background: rgba(148,163,184,0.22); color: #cbd5e1; }
.session-finance-modal .modal-title {
  display: flex;
  align-items: center;
  gap: 8px;
}
.session-finance-subtitle {
  font-size: 12px;
  color: var(--text3);
  margin-bottom: 12px;
}
.session-finance-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}
.session-finance-group {
  background: rgba(15,23,42,0.45);
  border: 1px solid rgba(148,163,184,0.22);
  border-radius: 10px;
  padding: 10px;
}
.session-finance-group h6 {
  margin: 0 0 8px;
  font-size: 12px;
  color: var(--text2);
  font-weight: 700;
}
.session-finance-boxes {
  margin-top: 10px;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}
.session-finance-box-item {
  background: rgba(30,41,59,0.65);
  border: 1px solid rgba(99,102,241,0.32);
  border-radius: 10px;
  padding: 10px;
}
.session-finance-box-item .box-label {
  font-size: 11px;
  color: #cbd5e1;
  margin-bottom: 6px;
  font-weight: 700;
}
.session-finance-box-item .box-inline {
  display: grid;
  gap: 8px;
}
.session-finance-box-item .status-select {
  width: 100%;
  height: 34px;
  background: rgba(15,23,42,0.82);
  border: 1px solid rgba(148,163,184,0.35);
  border-radius: 8px;
  color: var(--text);
  font-size: 12px;
  padding: 0 10px;
}
.session-finance-box-item .status-select:focus {
  outline: none;
  border-color: rgba(34,197,94,0.55);
  box-shadow: 0 0 0 2px rgba(34,197,94,0.12);
}
.session-finance-box-item .finance-note {
  font-size: 11px;
  color: var(--text3);
  min-height: 14px;
}
.session-finance-box-item.is-unlucky {
  border-color: rgba(239,68,68,0.45);
  background: rgba(60,13,18,0.38);
}
.session-finance-actions {
  display: flex;
  gap: 10px;
  justify-content: flex-end;
  margin-top: 14px;
}

/* Force very clear visual contrast between dark/light for inputs and all cards */
:root[data-theme="light"] .form-input,
:root[data-theme="light"] .form-select,
:root[data-theme="light"] input[type="text"],
:root[data-theme="light"] input[type="email"],
:root[data-theme="light"] input[type="password"],
:root[data-theme="light"] input[type="number"],
:root[data-theme="light"] input[type="date"],
:root[data-theme="light"] input[type="time"],
:root[data-theme="light"] textarea,
:root[data-theme="light"] select {
  background: #ffffff !important;
  color: #0b1220 !important;
  border: 1px solid rgba(15, 23, 42, 0.28) !important;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.95) !important;
}

:root[data-theme="light"] .form-input::placeholder,
:root[data-theme="light"] input::placeholder,
:root[data-theme="light"] textarea::placeholder {
  color: #64748b !important;
}

:root[data-theme="light"] .form-input:focus,
:root[data-theme="light"] .form-select:focus,
:root[data-theme="light"] input:focus,
:root[data-theme="light"] textarea:focus,
:root[data-theme="light"] select:focus {
  border-color: #2563eb !important;
  box-shadow: 0 0 0 3px rgba(37,99,235,0.18) !important;
}

:root[data-theme="dark"] .form-input,
:root[data-theme="dark"] .form-select,
:root[data-theme="dark"] input[type="text"],
:root[data-theme="dark"] input[type="email"],
:root[data-theme="dark"] input[type="password"],
:root[data-theme="dark"] input[type="number"],
:root[data-theme="dark"] input[type="date"],
:root[data-theme="dark"] input[type="time"],
:root[data-theme="dark"] textarea,
:root[data-theme="dark"] select {
  background: #0b1220 !important;
  color: #e2e8f0 !important;
  border: 1px solid rgba(148, 163, 184, 0.3) !important;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.04) !important;
}

:root[data-theme="dark"] .form-input:focus,
:root[data-theme="dark"] .form-select:focus,
:root[data-theme="dark"] input:focus,
:root[data-theme="dark"] textarea:focus,
:root[data-theme="dark"] select:focus {
  border-color: #60a5fa !important;
  box-shadow: 0 0 0 3px rgba(59,130,246,0.2) !important;
}

:root[data-theme="light"] .card,
:root[data-theme="light"] .stat-card,
:root[data-theme="light"] .session-card,
:root[data-theme="light"] .session-card-wrap .session-card,
:root[data-theme="light"] .wd-card-item,
:root[data-theme="light"] .gift-card-item {
  background: #ffffff !important;
  border: 1px solid rgba(15,23,42,0.2) !important;
  color: #0f172a !important;
  box-shadow: 0 4px 20px rgba(0,0,0,0.08) !important;
}
:root[data-theme="light"] .session-card {
  border-left: 3px solid #3b82f6 !important;
}

:root[data-theme="dark"] .card,
:root[data-theme="dark"] .stat-card,
:root[data-theme="dark"] .session-card,
:root[data-theme="dark"] .session-card-wrap .session-card,
:root[data-theme="dark"] .wd-card-item,
:root[data-theme="dark"] .gift-card-item {
  background: #1e293b !important;
  border: 1px solid #334155 !important;
  color: #e2e8f0 !important;
  box-shadow: 0 2px 10px rgba(0,0,0,.4) !important;
}
:root[data-theme="dark"] .session-card {
  border-left: 3px solid #3b82f6 !important;
}

:root[data-theme="light"] .session-card:hover,
:root[data-theme="light"] .wd-card-item:hover,
:root[data-theme="light"] .gift-card-item:hover {
  box-shadow: 0 6px 24px rgba(0,0,0,.15) !important;
}

:root[data-theme="dark"] .session-card:hover,
:root[data-theme="dark"] .wd-card-item:hover,
:root[data-theme="dark"] .gift-card-item:hover {
  box-shadow: 0 6px 24px rgba(0,0,0,.55) !important;
}

:root[data-theme="light"] .session-card *,
:root[data-theme="light"] .wd-card-item *,
:root[data-theme="light"] .gift-card-item * {
  color: #0f172a !important;
}
/* Preserve coloured elements in light mode */
:root[data-theme="light"] .session-card .prize-preview-amount { color: #16a34a !important; }
:root[data-theme="light"] .session-card .prize-preview-amount > span { color: #16a34a !important; }
:root[data-theme="light"] .session-card .prize-inv-lock { color: #94a3b8 !important; }
:root[data-theme="light"] .session-card .prize-inv-lock.opened { color: #16a34a !important; }
:root[data-theme="light"] .session-card .prize-preview-name { color: #4b5563 !important; }
:root[data-theme="light"] .session-card .prize-dollar-btn { color: #3b82f6 !important; }
:root[data-theme="light"] .session-card .session-score-badge { color: #16a34a !important; }
:root[data-theme="light"] .session-card .session-score-badge.mid { color: #b45309 !important; }
:root[data-theme="light"] .session-card .session-score-badge.low { color: #dc2626 !important; }

:root[data-theme="light"] .session-card .session-chip {
  background: #fff !important;
  border-color: #e2e8f0 !important;
  color: #0f172a !important;
}
:root[data-theme="light"] .session-card .session-chip.paused {
  background: #f1f5f9 !important; border-color: #cbd5e1 !important; color: #64748b !important;
}
:root[data-theme="light"] .session-card .session-progress-wrap {
  background: #f0f4ff !important;
  border-color: rgba(15,23,42,0.1) !important;
}
:root[data-theme="light"] .session-card .session-progress-bar {
  background: #dbeafe !important;
}
:root[data-theme="light"] .session-card .session-progress-fill {
  background: linear-gradient(90deg, #3b82f6, #8b5cf6) !important;
}
:root[data-theme="light"] .session-card .session-btn {
  background: #f8fafc !important;
  border-color: rgba(15,23,42,0.14) !important;
  color: #0f172a !important;
}
:root[data-theme="light"] .session-card .session-btn-delete { color: #dc2626 !important; }
:root[data-theme="light"] .session-card .session-btn-edit { color: #0284c7 !important; }
:root[data-theme="light"] .session-card .session-btn-toggle.pause { color: #c2410c !important; }
:root[data-theme="light"] .session-card .prize-preview-item {
  background: #f0f4ff !important;
  border-color: rgba(15,23,42,0.1) !important;
}
:root[data-theme="light"] .session-card .prize-num-badge { outline-color: #ffffff !important; }
:root[data-theme="light"] .session-finance-group,
:root[data-theme="light"] .session-finance-box-item,
:root[data-theme="light"] .session-finance-box-item .status-select {
  background: #ffffff !important;
  border-color: rgba(15,23,42,0.18) !important;
}
@media (max-width: 768px) {
  .session-finance-grid,
  .session-finance-boxes {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 1024px) {
  .content {
    margin: 0;
    padding: 0;
  }

  .panel-header {
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
  }

  .custom-tabs {
    flex-wrap: wrap;
    gap: 8px;
  }

  .custom-tab {
    flex: 1 1 220px;
    min-height: 42px;
  }

  .template-grid,
  .prize-boxes-grid,
  .box-order-grid,
  .stats-grid,
  #withdrawalsCardsContainer,
  #giftsCardsContainer,
  #conversionsCardsContainer,
  #usersCardsContainer,
  #filesGridContainer,
  #sessionsContainer {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }

  .table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .table {
    min-width: 720px;
  }
}

@media (max-width: 768px) {
  .header {
    margin: 0 0 10px;
    padding: 10px;
  }

  .header-top {
    flex-direction: column;
    align-items: stretch;
  }

  .header-controls {
    width: 100%;
    justify-content: space-between;
  }

  .header-controls > * {
    flex: 1 1 auto;
  }

  .btn-change-pass {
    width: 100%;
    justify-content: center;
  }

  .content {
    margin: 0;
    padding: 0;
    border-radius: 10px;
  }

  .stats-grid,
  .template-grid,
  .prize-boxes-grid,
  .box-order-grid,
  #withdrawalsCardsContainer,
  #giftsCardsContainer,
  #conversionsCardsContainer,
  #usersCardsContainer,
  #filesGridContainer,
  #sessionsContainer {
    grid-template-columns: minmax(0, 1fr) !important;
    gap: 10px !important;
  }

  .session-card-actions,
  .modal-actions,
  .filter-actions,
  .admin-action-grid {
    grid-template-columns: minmax(0, 1fr) !important;
    flex-direction: column;
    align-items: stretch;
  }

  .session-card-wrap,
  .session-card,
  .session-card-body,
  .session-card-actions {
    min-width: 0 !important;
    overflow-x: hidden !important;
  }

  .session-card-actions {
    display: grid !important;
    grid-template-columns: 1fr !important;
    gap: 8px !important;
  }

  .session-card-actions .session-btn,
  .session-card-actions .session-btn-copy-wide,
  .session-card-actions .session-btn-icon {
    width: 100% !important;
    min-width: 0 !important;
    height: 44px !important;
    justify-content: center !important;
  }

  .session-btn,
  .btn,
  button {
    min-height: 42px;
  }

  .modal,
  .modal-content {
    width: 96vw !important;
    max-width: 96vw !important;
    margin: 0 auto;
    max-height: 90vh;
    overflow-y: auto;
  }

  .table {
    min-width: 640px;
    font-size: 12px;
  }
}

/* ===== iPad / Tablet + Medium Laptop responsive (769px – 1100px) ===== */
@media (min-width: 769px) and (max-width: 1100px) {
  :root { --dashboard-side-gap: 12px; }

  .admin-shell {
    width: min(var(--dashboard-shell-max), calc(100% - 24px));
    margin: 20px auto;
  }

  /* Header: keep controls inline but allow wrapping */
  .header-controls { flex-wrap: wrap; gap: 6px; }
  .header-controls > * { flex: 0 1 auto; }

  /* Stats / cards grids: max 3-column on iPad */
  .stats-grid,
  #sessionsContainer,
  #withdrawalsCardsContainer,
  #giftsCardsContainer {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 12px !important;
  }

  /* Prize / icon grids stay 3-column */
  .prize-boxes-grid,
  .box-order-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  }

  .icon-grid {
    grid-template-columns: repeat(7, minmax(0, 1fr)) !important;
    gap: 2px !important;
  }

  /* Panel header: allow wrapping on narrow tablets */
  .panel-header {
    flex-wrap: wrap;
    gap: 8px;
  }
  .panel-header .filter-row { flex-wrap: wrap; }

  /* Tables: always horizontal scroll on iPad */
  .table-wrapper { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .table { min-width: 700px; }

  /* Modals: wider on iPad */
  .modal, .modal-content {
    width: min(760px, 94vw) !important;
    max-width: 94vw !important;
  }

  /* Customer care panel: keep mobile-like single column up to 1100px */
  #panel-customer-care .cc-layout {
    display: grid;
    grid-template-columns: 1fr;
  }

  /* Tabs: ensure horizontal scroll without text overflow */
  .tab-nav { padding: 8px; }
  .tab-btn { padding: 7px 12px; font-size: 12px; }
  .tab-btn .tab-label { max-width: 80px; }
}

/* Between 700px-768px: narrow tablet / large phone landscape */
@media (min-width: 700px) and (max-width: 768px) {
  .notif-dropdown { width: min(760px, calc(100vw - 12px)); min-width: 0; right: 0; }
  .header-controls { flex-wrap: wrap; gap: 5px; }
  .notif-bell-label { display: none; }
  .stats-grid {
    grid-template-columns: repeat(2, minmax(0,1fr)) !important;
    gap: 10px !important;
  }
  #sessionsContainer, #withdrawalsCardsContainer, #giftsCardsContainer {
    grid-template-columns: repeat(2, minmax(0,1fr)) !important;
  }
  .panel-header { flex-wrap: wrap; gap: 8px; }
  .table-wrapper { overflow-x: auto; }
  .table { min-width: 620px; }
}

/* 1025px-1199px: medium laptop — prevent layout from getting too tight */
@media (min-width: 1025px) and (max-width: 1199px) {
  .stats-grid { grid-template-columns: repeat(3, minmax(0,1fr)) !important; }
  .header-controls { gap: 7px; }
  .notif-dropdown { width: min(760px, calc(100vw - 20px)); }
}

/* =====================================================================
   RESPONSIVE: 1281–1500px — sessions 2-col (cards need room for prize grid)
   ===================================================================== */
@media (min-width: 1281px) and (max-width: 1500px) {
  #sessionsContainer {
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
}

/* =====================================================================
   RESPONSIVE: 1281–1600px — stats grid and card compact
   ===================================================================== */
@media (min-width: 1281px) and (max-width: 1599px) {
  .stats-grid {
    gap: 10px;
  }

  .stat-card {
    padding: 12px;
  }

  .stat-value {
    font-size: 20px;
  }
}

/* =====================================================================
   RESPONSIVE: 1600–1800px — presence sidebar restored to 280px but
   sessions can expand to 3 nice columns
   ===================================================================== */
@media (min-width: 1600px) and (max-width: 1800px) {
  #sessionsContainer {
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
}
