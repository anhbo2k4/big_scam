  }
}

// Setup close button and overlay event listeners for edit modal
function setupEditModalCloseHandlers() {
  var editModalOverlay = document.getElementById('editModalOverlay');
  var closeBtn = document.querySelector('#editSessionModal .modal-close');

  if (closeBtn) {
    closeBtn.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      closeEditModal();
    }, true);
  }

  if (editModalOverlay) {
    editModalOverlay.addEventListener('click', function (e) {
      if (e.target === this) {
        closeEditModal();
      }
    });
  }

  // Close edit modal with Escape key
  var editKeydownHandler = function editKeydownHandler(e) {
    if (e.key === 'Escape') {
      var modal = document.getElementById('editSessionModal');
      if (modal && modal.classList.contains('open')) {
        closeEditModal();
      }
    }
  };

  document.removeEventListener('keydown', setupEditModalCloseHandlers.modalKeydownHandler);
  setupEditModalCloseHandlers.modalKeydownHandler = editKeydownHandler;
  document.addEventListener('keydown', editKeydownHandler);
}

