<script>
/**
 * NOTIFICATION SYSTEM - Manages all notifications
 */
window.__adminRuntimeI18nCache = window.__adminRuntimeI18nCache || {};
function translateAdminRuntimeText(text) {
  var lang = window.__activeAdminLang || 'vi';
  var src = String(text || '');
  if (!src || lang === 'vi') return Promise.resolve(src);
  var ck = lang + '::' + src;
  if (window.__adminRuntimeI18nCache[ck]) return Promise.resolve(window.__adminRuntimeI18nCache[ck]);
  var map = window._adminI18n || {};
  var textMap = window._adminTextMap || {};
  var out = map[src] || textMap[src] || src;
  window.__adminRuntimeI18nCache[ck] = out;
  return Promise.resolve(out);
}

function showNotification(title, message) {var type = arguments.length > 2 && arguments[2] !== undefined ? arguments[2] : 'info';var callback = arguments.length > 3 && arguments[3] !== undefined ? arguments[3] : null;
  var floating = document.getElementById('floatingNotice');
  var floatingTitle = document.getElementById('floatingNoticeTitle');
  var floatingMessage = document.getElementById('floatingNoticeMessage');
  var floatingIcon = document.getElementById('floatingNoticeIcon');
  var floatingTag = document.getElementById('floatingNoticeTag');
  var floatingTime = document.getElementById('floatingNoticeTime');
  var floatingProgress = document.getElementById('floatingNoticeProgress');

  var modal = document.getElementById('notificationModal');
  var overlay = document.getElementById('notificationOverlay');
  var titleEl = document.getElementById('notificationTitle');
  var msgEl = document.getElementById('notificationMessage');
  var iconEl = document.getElementById('notificationIcon');
  var btnEl = document.getElementById('notificationBtn');

  var canUseFloating = !!(floating && floatingTitle && floatingMessage && floatingIcon && floatingProgress);
  var canUseLegacyModal = !!(modal && overlay && titleEl && msgEl && iconEl && btnEl);
  if (!canUseFloating && !canUseLegacyModal) {
    return;
  }

  var messageText = String(message || '');
  var isComplexHtml = /<(div|table|button|img|h\d|ul|ol|a|br)\b/i.test(messageText);
  var lang = window.__activeAdminLang || 'vi';

  // Set icon and color based on type
  var icons = {
    success: '✅',
    error: '❌',
    warning: '⚠️',
    info: 'ℹ️',
    question: '❓',
    loading: '⟳'
  };
  var tags = {
    success: 'Thành công',
    error: 'Lỗi',
    warning: 'Cảnh báo',
    info: 'Thông báo',
    question: 'Xác nhận',
    loading: 'Đang xử lý'
  };

  var colors = {
    success: 'var(--green)',
    error: 'var(--red)',
    warning: 'var(--yellow)',
    info: 'var(--blue)',
    question: 'var(--blue)',
    loading: 'var(--blue)'
  };

  window.notificationCallback = callback;

  if (window.notificationTimer) {
    clearTimeout(window.notificationTimer);
  }

  if (canUseFloating && !isComplexHtml) {
    var typeClass = ['success', 'error', 'warning', 'info', 'question', 'loading'].includes(type) ? type : 'info';
    floating.className = "floating-notice ".concat(typeClass);
    // Force runtime visual style so legacy/custom CSS cannot keep old purple block.
    floating.style.background = 'radial-gradient(130% 130% at 100% 0%, rgba(56,189,248,.16) 0%, rgba(15,23,42,.04) 60%), linear-gradient(160deg, rgba(9,18,33,.98), rgba(11,21,40,.97))';
    floating.style.border = '1px solid rgba(148,163,184,.36)';
    floating.style.borderRadius = '16px';
    floating.style.boxShadow = '0 24px 52px rgba(2,8,22,.5)';
    floating.style.color = '#e2e8f0';
    floating.style.right = window.matchMedia('(max-width: 980px)').matches ? '8px' : '14px';
    floating.style.left = window.matchMedia('(max-width: 980px)').matches ? '8px' : 'auto';
    floating.style.bottom = window.matchMedia('(max-width: 980px)').matches ? 'calc(8px + env(safe-area-inset-bottom))' : '14px';
    floating.style.width = window.matchMedia('(max-width: 980px)').matches ? 'auto' : 'min(420px, calc(100vw - 16px))';
    floatingTitle.textContent = title || 'Thông báo';
    floatingMessage.textContent = messageText.replace(/<[^>]+>/g, '').trim();
    if (lang !== 'vi') {
      translateAdminRuntimeText(floatingTitle.textContent).then(function (v) {if (v) floatingTitle.textContent = v;}).catch(function () {});
      translateAdminRuntimeText(floatingMessage.textContent).then(function (v) {if (v) floatingMessage.textContent = v;}).catch(function () {});
    }
    floatingIcon.textContent = icons[type] || icons.info;
    if (floatingTag) floatingTag.textContent = tags[type] || tags.info;
    if (floatingTime) {
      floatingTime.textContent = new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
    }
    floating.style.display = 'block';

    // Restart progress animation each time
    floatingProgress.style.animation = 'none';
    // Force reflow so animation resets
    void floatingProgress.offsetWidth;
    floatingProgress.style.animation = 'noticeProgress 4.2s linear forwards';

    floating.classList.remove('hide');
    floating.classList.add('show');

    window.notificationTimer = setTimeout(function () {
      closeNotification();
    }, 4200);
    return;
  }

  if (!canUseLegacyModal) {
    return;
  }

  titleEl.textContent = title;
  msgEl.innerHTML = message;
  if (lang !== 'vi' && !isComplexHtml) {
    translateAdminRuntimeText(titleEl.textContent).then(function (v) {if (v) titleEl.textContent = v;}).catch(function () {});
    translateAdminRuntimeText(String(message || '').replace(/<[^>]+>/g, '').trim()).then(function (v) {if (v) msgEl.textContent = v;}).catch(function () {});
  }
  iconEl.textContent = icons[type] || icons.info;
  btnEl.style.background = colors[type] || colors.info;

  // Show modals with proper display properties
  overlay.classList.add('show');
  overlay.style.display = 'block';
  modal.classList.add('show');
  modal.style.display = 'flex';

  // Setup close handlers for notification modal
  setupNotificationCloseHandlers();

  // Prevent body scroll
  document.body.classList.add('modal-open');

  // Auto close
  window.notificationTimer = setTimeout(function () {
    closeNotification();
  }, 5000);
}

// Setup close handlers for notification modal
function setupNotificationCloseHandlers() {
  var notificationOverlay = document.getElementById('notificationOverlay');
  var notificationModal = document.getElementById('notificationModal');
  var closeBtn = document.querySelector('#notificationModal .modal-close');

  // Overlay click closes notification
  if (notificationOverlay) {
    notificationOverlay.onclick = function (e) {
      if (e.target === this) {
        closeNotification();
        return false;
      }
    };
  }

  // Prevent clicks inside modal from triggering overlay close
  if (notificationModal) {
    notificationModal.onclick = function (e) {
      e.stopPropagation();
    };
  }

  // Close button
  if (closeBtn) {
    closeBtn.onclick = function (e) {
      e.preventDefault();
      e.stopPropagation();
      closeNotification();
      return false;
    };
  }
}

function closeNotification() {
  var floating = document.getElementById('floatingNotice');
  var modal = document.getElementById('notificationModal');
  var overlay = document.getElementById('notificationOverlay');

  var didCloseAny = false;

  if (floating && floating.style.display !== 'none') {
    floating.classList.remove('show');
    floating.classList.add('hide');
    didCloseAny = true;
    setTimeout(function () {
      if (floating.classList.contains('hide')) {
        floating.style.display = 'none';
        floating.classList.remove('hide');
      }
    }, 260);
  }

  if (modal) {
    var modalWasVisible = modal.style.display !== 'none' && modal.style.display !== '';
    modal.classList.remove('show');
    modal.style.display = 'none';
    if (modalWasVisible) didCloseAny = true;
  }
  if (overlay) {
    var overlayWasVisible = overlay.style.display !== 'none' && overlay.style.display !== '';
    overlay.classList.remove('show');
    overlay.style.display = 'none';
    if (overlayWasVisible) didCloseAny = true;
  }

  // Only remove body scroll lock if no modals are visible
  if (!hasVisibleModals()) {
    document.body.classList.remove('modal-open');
  }

  clearTimeout(window.notificationTimer);

  if (didCloseAny && window.notificationCallback) {
    window.notificationCallback();
    window.notificationCallback = null;
  }
}

/**
 * WITHDRAWAL MODAL - Handle payment method selection
 */
document.addEventListener('DOMContentLoaded', function () {
  var withdrawalMethod = document.getElementById('withdrawalMethod');
  var bankFields = document.getElementById('bankFields');
  var walletFields = document.getElementById('walletFields');
  var methodFields = document.getElementById('withdrawalMethodFields');

  if (withdrawalMethod) {
    withdrawalMethod.addEventListener('change', function () {
      methodFields.style.display = this.value ? 'block' : 'none';
      bankFields.style.display = this.value === 'bank' ? 'block' : 'none';
      walletFields.style.display = this.value === 'wallet' ? 'block' : 'none';
    });
  }
});

function submitWithdrawal() {
  var amount = document.getElementById('withdrawalAmount').value;
  var method = document.getElementById('withdrawalMethod').value;

  if (!amount || !method) {
    showNotification('Lỗi', 'Vui lòng điền đủ thông tin bắt buộc', 'error');
    return;
  }

  showNotification('Thành công', 'Yêu cầu rút tiền đã được gửi. Chúng tôi sẽ xác nhận trong 24 giờ.', 'success', function () {
    ModalManager.hide('withdrawalModal');
  });
}

function onGiftConfirm() {
  // Implement gift confirmation logic
  showNotification('Thành công', 'Quà tặng đã được xác nhận nhận', 'success', function () {
    ModalManager.hide('giftDetailModal');
  });
}

// ─────────────────────────────────────────────────────────────────────────────
// Auto-apply admin i18n to the full page once the text-map is ready
// ─────────────────────────────────────────────────────────────────────────────
(function scheduleAdminI18nApply() {
  if (window.__adminLang === 'vi') return;
  function runApply() {
    if (typeof applyAdminI18n === 'function') {
      // Apply to the main content area (skip sidebar chat etc if needed)
      applyAdminI18n(document.body);
    }
  }
  if (window.__adminI18nReady) {
    // Text map already loaded (sync path – vi fallback or cached)
    document.addEventListener('DOMContentLoaded', runApply);
  } else {

    document.addEventListener('adminI18nReady', runApply);

    document.addEventListener('DOMContentLoaded', function () {return setTimeout(runApply, 2000);});
  }
})();</script>


