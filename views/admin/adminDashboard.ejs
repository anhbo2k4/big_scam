// ===== RANDOMIZE 3 PRIZES FOR 3 BOXES =====
function randomizePrizes() {
  // Shuffle array and pick 3 random prizes
  var shuffled = [].concat(samplePrizes).sort(function () {return 0.5 - Math.random();});
  var selectedPrizes = shuffled.slice(0, 3);

  // Fill in the 3 boxes with random prizes
  selectedPrizes.forEach(function (prize, index) {
    var boxNum = index + 1;

    // Set prize name
    var nameInput = document.querySelector(".prize-box-card:nth-child(".concat(boxNum, ") input.modal-input[placeholder*=\"T\xEAn\"]"));
    if (nameInput) nameInput.value = prize.name;

    // Set prize description
    var descInput = document.querySelector(".prize-box-card:nth-child(".concat(boxNum, ") textarea.modal-textarea"));
    if (descInput) descInput.value = prize.desc;

    // Set prize level/status
    var levelIndex = 0;
    if (prize.level === 'VIP') levelIndex = 1;else
    if (prize.level === 'UNLUCKY') levelIndex = 2;

    var levelSelect = document.getElementById("prizeLevel".concat(boxNum));
    if (levelSelect) levelSelect.selectedIndex = levelIndex;

    // Update level badge
    var badge = document.querySelector(".prize-box-card:nth-child(".concat(boxNum, ") .prize-level-badge"));
    if (badge) {
      badge.classList.remove('vip', 'normal', 'unlucky');
      badge.classList.add(prize.level.toLowerCase());
      var levelText = prize.level === 'VIP' ? '👑 VIP' : prize.level === 'UNLUCKY' ? '💔 UNLUCKY' : '⭐ NORMAL';
      badge.innerHTML = levelText;
    }

    // Set icon (click on the matching icon button)
    var iconGrid = document.getElementById("iconGrid".concat(boxNum));
    if (iconGrid) {
      var buttons = iconGrid.querySelectorAll('.icon-btn');
      buttons.forEach(function (btn) {
        btn.classList.remove('active');
        if (btn.textContent === prize.icon) {
          btn.classList.add('active');
        }
      });
    }
  });
}

