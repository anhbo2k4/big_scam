/* ===== ADMIN MOTION LAYER ===== */
:root {
  --motion-ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  --motion-ease-soft: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  --motion-fast: 180ms;
  --motion-base: 280ms;
  --motion-slow: 520ms;
}

@keyframes adminRiseIn {
  from {
    opacity: 0;
    transform: translateY(14px) scale(0.99);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes adminGlowPulse {
  0%,
  100% {
    box-shadow: 0 0 0 rgba(59, 130, 246, 0);
  }
  50% {
    box-shadow: 0 0 0 6px rgba(59, 130, 246, 0.1);
  }
}

.admin-shell,
.header,
.admin-main-layout,
.tab-wrapper,
.tab-content.active,
.tab-pane.active,
.modal-wrap.show,
.modal-wrap.open {
  animation: adminRiseIn var(--motion-slow) var(--motion-ease-out);
}

button,
.btn,
.btn-refresh,
.btn-change-pass,
.btn-logout,
.tab-btn,
.tab-menu-btn,
.btn-gen-code,
.box-btn,
.icon-btn,
.reward-btn,
.modal-close {
  position: relative;
  overflow: hidden;
  transition:
    transform var(--motion-base) var(--motion-ease-out),
    box-shadow var(--motion-base) var(--motion-ease-out),
    filter var(--motion-base) var(--motion-ease-soft),
    background-color var(--motion-fast) ease,
    border-color var(--motion-fast) ease,
    color var(--motion-fast) ease;
  will-change: transform;
}

button::after,
.btn::after,
.tab-btn::after,
.icon-btn::after,
.box-btn::after {
  content: "";
  position: absolute;
  top: -140%;
  left: -40%;
  width: 50%;
  height: 320%;
  pointer-events: none;
  background: linear-gradient(120deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0));
  transform: rotate(18deg) translateX(-120%);
  transition: transform 580ms var(--motion-ease-out);
}

button:hover:not(:disabled),
.btn:hover:not(:disabled),
.btn-refresh:hover,
.btn-change-pass:hover,
.btn-logout:hover,
.tab-btn:hover,
.tab-menu-btn:hover,
.btn-gen-code:hover,
.box-btn:hover:not(:disabled),
.icon-btn:hover,
.reward-btn:hover,
.modal-close:hover {
  transform: translateY(-2px) scale(1.015);
  box-shadow: 0 12px 28px rgba(2, 6, 23, 0.34);
  filter: saturate(1.06);
}

button:hover:not(:disabled)::after,
.btn:hover:not(:disabled)::after,
.tab-btn:hover::after,
.icon-btn:hover::after,
.box-btn:hover:not(:disabled)::after {
  transform: rotate(18deg) translateX(260%);
}

button:active:not(:disabled),
.btn:active:not(:disabled),
.tab-btn:active,
.icon-btn:active,
.box-btn:active:not(:disabled) {
  transform: translateY(0) scale(0.985);
  transition-duration: 120ms;
}

.card,
.stat-card,
.template-card,
.prize-box-card,
.reward-card,
.wizard-confirm-card,
.admin-detail-card,
.admin-action-box,
.withdrawal-card,
.session-card,
.gift-card,
.box-order-item,
.admin-action-item,
.conversion-card,
[class$="-card"] {
  transition:
    transform var(--motion-base) var(--motion-ease-out),
    box-shadow var(--motion-base) var(--motion-ease-out),
    border-color var(--motion-fast) ease,
    background-color var(--motion-fast) ease;
}

.card:hover,
.stat-card:hover,
.template-card:hover,
.prize-box-card:hover,
.reward-card:hover,
.wizard-confirm-card:hover,
.admin-detail-card:hover,
.admin-action-box:hover,
.withdrawal-card:hover,
.session-card:hover,
.gift-card:hover,
.box-order-item:hover,
.admin-action-item:hover,
.conversion-card:hover,
[class$="-card"]:hover {
  transform: translateY(-3px);
  box-shadow: 0 18px 36px rgba(2, 6, 23, 0.35);
  border-color: rgba(147, 197, 253, 0.35);
}

a,
label,
.session-chip,
.tab-sidebar-brand,
.tab-sidebar-user,
.tab-sidebar-sub,
.tab-nav-badge {
  transition: color var(--motion-fast) ease, opacity var(--motion-fast) ease, transform var(--motion-fast) var(--motion-ease-soft);
}

a:hover,
label:hover,
.session-chip:hover,
.tab-nav-badge:hover {
  transform: translateY(-1px);
}

input,
select,
textarea,
.form-control,
.form-select,
.modal-input,
.modal-select,
.modal-textarea {
  transition:
    border-color var(--motion-fast) ease,
    box-shadow var(--motion-base) var(--motion-ease-out),
    background-color var(--motion-fast) ease,
    transform var(--motion-base) var(--motion-ease-soft);
}

input:hover,
select:hover,
textarea:hover,
.form-control:hover,
.form-select:hover,
.modal-input:hover,
.modal-select:hover,
.modal-textarea:hover {
  border-color: rgba(96, 165, 250, 0.55);
}

input:focus,
select:focus,
textarea:focus,
.form-control:focus,
.form-select:focus,
.modal-input:focus,
.modal-select:focus,
.modal-textarea:focus {
  transform: translateY(-1px);
  animation: adminGlowPulse 1.15s var(--motion-ease-soft) 1;
}

.table tbody tr {
  transition:
    transform var(--motion-fast) var(--motion-ease-soft),
    background-color var(--motion-fast) ease,
    box-shadow var(--motion-fast) ease;
}

.table tbody tr:hover {
  transform: translateX(4px);
  box-shadow: inset 3px 0 0 rgba(59, 130, 246, 0.75);
}

/* Force per-tab full background for active state */
.admin-main-layout .tab-btn[data-tab="sessions"] {
  --tab-hover-bg: linear-gradient(180deg, rgba(59, 130, 246, 0.22), rgba(29, 78, 216, 0.16));
  --tab-active-bg: linear-gradient(180deg, rgba(37, 99, 235, 0.48), rgba(30, 64, 175, 0.38));
  --tab-border: rgba(147, 197, 253, 0.75);
  --tab-text: #e6f0ff;
}

.admin-main-layout .tab-btn[data-tab="withdrawals"] {
  --tab-hover-bg: linear-gradient(180deg, rgba(251, 113, 133, 0.24), rgba(190, 24, 93, 0.16));
  --tab-active-bg: linear-gradient(180deg, rgba(244, 63, 94, 0.5), rgba(159, 18, 57, 0.4));
  --tab-border: rgba(251, 113, 133, 0.76);
  --tab-text: #ffe5eb;
}

.admin-main-layout .tab-btn[data-tab="gifts"] {
  --tab-hover-bg: linear-gradient(180deg, rgba(250, 204, 21, 0.26), rgba(180, 83, 9, 0.16));
  --tab-active-bg: linear-gradient(180deg, rgba(245, 158, 11, 0.52), rgba(146, 64, 14, 0.42));
  --tab-border: rgba(252, 211, 77, 0.78);
  --tab-text: #fff5cf;
}

.admin-main-layout .tab-btn[data-tab="users"] {
  --tab-hover-bg: linear-gradient(180deg, rgba(74, 222, 128, 0.24), rgba(22, 101, 52, 0.16));
  --tab-active-bg: linear-gradient(180deg, rgba(34, 197, 94, 0.5), rgba(21, 128, 61, 0.4));
  --tab-border: rgba(134, 239, 172, 0.78);
  --tab-text: #e8ffef;
}

.admin-main-layout .tab-btn[data-tab="files"] {
  --tab-hover-bg: linear-gradient(180deg, rgba(45, 212, 191, 0.24), rgba(13, 148, 136, 0.16));
  --tab-active-bg: linear-gradient(180deg, rgba(20, 184, 166, 0.5), rgba(15, 118, 110, 0.4));
  --tab-border: rgba(153, 246, 228, 0.78);
  --tab-text: #e7fffb;
}

.admin-main-layout .tab-btn[data-tab="customer-care"] {
  --tab-hover-bg: linear-gradient(180deg, rgba(244, 114, 182, 0.24), rgba(157, 23, 77, 0.16));
  --tab-active-bg: linear-gradient(180deg, rgba(236, 72, 153, 0.5), rgba(157, 23, 77, 0.4));
  --tab-border: rgba(251, 182, 206, 0.78);
  --tab-text: #ffe7f2;
}

.admin-main-layout .tab-btn[data-tab="customization"] {
  --tab-hover-bg: linear-gradient(180deg, rgba(167, 139, 250, 0.24), rgba(91, 33, 182, 0.16));
  --tab-active-bg: linear-gradient(180deg, rgba(139, 92, 246, 0.5), rgba(91, 33, 182, 0.4));
  --tab-border: rgba(196, 181, 253, 0.78);
  --tab-text: #f1ecff;
}

.admin-main-layout .tab-btn[data-tab="tools"] {
  --tab-hover-bg: linear-gradient(180deg, rgba(251, 146, 60, 0.24), rgba(194, 65, 12, 0.16));
  --tab-active-bg: linear-gradient(180deg, rgba(249, 115, 22, 0.5), rgba(154, 52, 18, 0.4));
  --tab-border: rgba(253, 186, 116, 0.78);
  --tab-text: #fff0e5;
}

.admin-main-layout .tab-btn[data-tab]:hover {
  background: var(--tab-hover-bg) !important;
  border: 1px solid var(--tab-border) !important;
  border-bottom: none !important;
  color: var(--tab-text) !important;
}

.admin-main-layout .tab-btn[data-tab].active,
.admin-main-layout .tab-btn[data-tab].active:hover {
  background: var(--tab-active-bg) !important;
  border: 1px solid var(--tab-border) !important;
  border-bottom: none !important;
  color: #ffffff !important;
  box-shadow: 0 12px 26px rgba(2, 6, 23, 0.33), inset 0 0 0 1px rgba(255,255,255,0.08) !important;
}

.admin-main-layout .tab-btn[data-tab]:hover::after,
.admin-main-layout .tab-btn[data-tab].active::after {
  background: var(--tab-border) !important;
}

/* Responsive polish for admin + text customization workflow */
#panel-customization .custom-tabs {
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
  flex-wrap: nowrap !important;
  padding-bottom: 2px;
}

#panel-customization .custom-tab {
  flex: 0 0 auto;
  min-width: 126px;
}

#customTab-text .text-detail-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 12px;
}

@media (max-width: 1024px) {
  :root {
    --dashboard-side-gap: 0.75rem;
    --dashboard-side-gap-min: 0.75rem;
    --dashboard-side-gap-current: 0.75rem;
  }

  .admin-shell {
    width: min(var(--dashboard-shell-max), calc(100% - (var(--dashboard-side-gap-current) * 2)));
  }

  #customTab-text .custom-section-title,
  #customTab-text .custom-section-sub {
    text-align: left;
  }

  #customTab-text .cust-card {
    padding: 16px;
  }
}

@media (max-width: 768px) {
  :root {
    --dashboard-side-gap: 10px;
    --dashboard-side-gap-min: 10px;
    --dashboard-side-gap-current: 10px;
  }

  .admin-shell {
    width: min(var(--dashboard-shell-max), calc(100% - (var(--dashboard-side-gap-current) * 2)));
    margin: 8px auto;
  }

  #panel-customization .custom-tabs {
    margin-bottom: 14px;
  }

  #panel-customization .custom-tab {
    min-width: 112px;
    font-size: 12px;
    padding: 8px 10px;
  }

  #customTab-text .custom-section-title {
    font-size: 16px;
  }

  #customTab-text .text-detail-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  #customTab-text .text-detail-block {
    margin-top: 14px !important;
  }
}

.dashboard-presence-layout {
  display: grid;
  grid-template-columns: 280px minmax(0, 1fr);
  gap: 12px;
  align-items: start;
  width: min(1980px, 100%);
  margin: 0 auto;
  padding: 8px 10px;
  transition: grid-template-columns 0.9s cubic-bezier(0.33, 0, 0.2, 1),
    gap 0.75s cubic-bezier(0.33, 0, 0.2, 1),
    width 0.78s cubic-bezier(0.33, 0, 0.2, 1),
    padding 0.72s cubic-bezier(0.33, 0, 0.2, 1);
}

.dashboard-main-wrap {
  min-width: 0;
  transition: transform 0.82s cubic-bezier(0.33, 0, 0.2, 1);
}

.dashboard-presence-layout .admin-shell {
  width: 100%;
  margin: 20px 0 0;
  transition: width 0.82s cubic-bezier(0.33, 0, 0.2, 1), margin 0.82s cubic-bezier(0.33, 0, 0.2, 1);
}

.presence-sidebar {
  position: sticky;
  top: 10px;
  max-height: calc(100vh - 20px);
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: linear-gradient(180deg, rgba(18,28,44,0.98), rgba(10,16,28,0.98));
  box-shadow: 0 12px 28px rgba(0,0,0,0.28);
  display: flex;
  flex-direction: column;
  transform-origin: left center;
  transition: opacity 0.72s ease,
    transform 0.9s cubic-bezier(0.33, 0, 0.2, 1),
    border-color 0.58s ease,
    filter 0.8s ease;
}

.presence-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 12px;
  border-bottom: 1px solid var(--border);
}

.presence-head-actions {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.presence-head h3 {
  margin: 0;
  font-size: 14px;
  font-weight: 700;
  color: var(--text);
}

.presence-head p {
  margin: 3px 0 0;
  font-size: 11px;
  color: var(--text3);
}

.presence-refresh-btn {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  border: 1px solid var(--border2);
  background: var(--bg3);
  color: var(--text2);
  cursor: pointer;
}

.presence-collapse-btn {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  border: 1px solid var(--border2);
  background: var(--bg3);
  color: var(--text2);
  cursor: pointer;
}

.presence-refresh-btn:hover {
  color: var(--text);
  border-color: rgba(59,130,246,0.55);
}

.presence-collapse-btn:hover {
  color: #dbeafe;
  border-color: rgba(59,130,246,0.55);
}

.presence-summary {
  padding: 8px 12px;
  font-size: 12px;
  color: var(--text2);
  border-bottom: 1px solid var(--border);
}

.presence-list {
  overflow: auto;
  padding: 8px;
}

.presence-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  border: 1px solid var(--border);
  background: var(--bg3);
  border-radius: 10px;
  padding: 8px 9px;
  margin-bottom: 8px;
}

.presence-item:last-child {
  margin-bottom: 0;
}

.presence-user {
  min-width: 0;
}

.presence-name {
  font-size: 12.5px;
  font-weight: 700;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.presence-meta {
  margin-top: 2px;
  font-size: 11px;
  color: var(--text3);
}

.presence-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 11px;
  padding: 4px 8px;
  border-radius: 999px;
  border: 1px solid transparent;
  white-space: nowrap;
}

.presence-badge::before {
  content: '';
  width: 7px;
  height: 7px;
  border-radius: 999px;
}

.presence-badge.online {
  color: #bbf7d0;
  background: rgba(22,163,74,0.2);
  border-color: rgba(34,197,94,0.35);
}

.presence-badge.online::before {
  background: #22c55e;
  box-shadow: 0 0 0 4px rgba(34,197,94,0.14);
}

.presence-badge.offline {
  color: #cbd5e1;
  background: rgba(71,85,105,0.24);
  border-color: rgba(148,163,184,0.35);
}

.presence-badge.offline::before {
  background: #94a3b8;
}

.presence-badge.recent {
  color: #fde68a;
  background: rgba(217,119,6,0.18);
  border-color: rgba(245,158,11,0.34);
}

.presence-badge.recent::before {
  background: #f59e0b;
  box-shadow: 0 0 0 4px rgba(245,158,11,0.14);
}

.presence-empty {
  border: 1px dashed var(--border2);
  border-radius: 10px;
  padding: 14px;
  color: var(--text3);
  text-align: center;
  font-size: 12px;
}

.presence-toggle-fab {
  position: fixed;
  left: 6px;
  top: 50%;
  transform: translate(-8px, -50%);
  width: 28px;
  height: 98px;
  border-radius: 12px;
  border: none;
  background: transparent;
  color: #8bd6ff;
  cursor: pointer;
  z-index: 120;
  opacity: 0;
  pointer-events: none;
  box-shadow: none;
  transition: opacity 0.62s ease,
    transform 0.72s cubic-bezier(0.33, 0, 0.2, 1),
    color 0.42s ease;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 8px;
}

.presence-toggle-fab:hover {
  transform: translate(0, -50%);
  color: #d8f0ff;
}

.presence-toggle-fab::before,
.presence-toggle-fab::after {
  content: '';
  position: absolute;
  left: 50%;
  width: 1px;
  transform: translateX(-50%);
  background: linear-gradient(180deg, transparent, rgba(107, 203, 255, 0.5), transparent);
}

.presence-toggle-fab::before {
  top: 0;
  height: 28px;
}

.presence-toggle-fab::after {
  bottom: 0;
  height: 28px;
}

.presence-toggle-fab .arrow-right,
.presence-toggle-fab .arrow-right-2 {
  font-size: 13px;
  line-height: 1;
  text-shadow: 0 0 10px rgba(91, 192, 255, 0.75);
  opacity: 0.8;
  will-change: transform, opacity;
}

.presence-toggle-fab .arrow-right {
  animation: presenceArrowRightPrimary 2.2s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
}

.presence-toggle-fab .arrow-right-2 {
  animation: presenceArrowRightSecondary 2.2s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
  animation-delay: 0.28s;
}

@keyframes presenceArrowRightPrimary {
  0%, 100% { transform: translateX(0); opacity: 0.46; }
  45% { transform: translateX(2px); opacity: 0.9; }
  60% { transform: translateX(4px); opacity: 1; }
}

@keyframes presenceArrowRightSecondary {
  0%, 100% { transform: translateX(0); opacity: 0.3; }
  50% { transform: translateX(3px); opacity: 0.86; }
  70% { transform: translateX(5px); opacity: 0.96; }
}

.dashboard-presence-layout.presence-collapsed {
  grid-template-columns: 0px minmax(0, 1fr);
  gap: 0;
  width: 100%;
  padding: 0;
}

.dashboard-presence-layout.presence-stage-out .presence-sidebar {
  opacity: 0.24;
  transform: translateX(-10px) scale(0.992);
  filter: blur(0.4px);
}

.dashboard-presence-layout.presence-collapsed .presence-sidebar {
  opacity: 0;
  transform: translateX(-18px) scale(0.985);
  filter: blur(1px);
  pointer-events: none;
  border-color: transparent;
}

.dashboard-presence-layout.presence-collapsed .admin-shell {
  width: min(var(--dashboard-shell-max), calc(100% - (var(--dashboard-side-gap-current) * 2)));
  margin: 20px auto;
}

.dashboard-presence-layout.presence-collapsed .presence-toggle-fab {
  opacity: 1;
  pointer-events: auto;
  transform: translate(2px, -50%);
}

@media (max-width: 1280px) {
  .dashboard-presence-layout {
    grid-template-columns: 1fr;
    padding: 8px;
  }

  .presence-sidebar {
    position: static;
    max-height: 320px;
  }

  .presence-toggle-fab {
    display: inline-flex;
    left: 8px;
    top: auto;
    bottom: 16px;
    width: 30px;
    height: 52px;
    transform: translate(-6px, 0);
  }

  .dashboard-presence-layout.presence-collapsed {
    grid-template-columns: 1fr;
    padding: 8px;
    gap: 8px;
  }

  .dashboard-presence-layout.presence-collapsed .presence-sidebar {
    display: none;
  }

  .dashboard-presence-layout.presence-stage-out .presence-sidebar {
    opacity: 1;
    transform: none;
    filter: none;
  }

  .dashboard-presence-layout.presence-collapsed .admin-shell {
    width: min(var(--dashboard-shell-max), calc(100% - (var(--dashboard-side-gap-current) * 2)));
    margin: 20px auto;
  }

  .dashboard-presence-layout.presence-collapsed .presence-toggle-fab {
    opacity: 1;
    pointer-events: auto;
    transform: translate(0, 0);
  }

  .dashboard-presence-layout:not(.presence-collapsed) .presence-toggle-fab {
    opacity: 0;
    pointer-events: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .presence-toggle-fab .arrow-right,
  .presence-toggle-fab .arrow-right-2 {
    animation: none !important;
  }
}

/* ===== MOBILE POLISH: ALL ADMIN TABS ===== */
@media (max-width: 1100px) {
  .tab-wrapper {
    position: sticky;
    top: 8px;
    z-index: 1080;
    margin-bottom: 10px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .tab-menu-btn {
    min-height: 42px;
    justify-content: flex-start;
    padding: 0 12px;
  }

  .tab-menu-btn span {
    letter-spacing: 0.2px;
  }

  .tab-nav {
    width: min(86vw, 320px) !important;
    max-width: 320px;
    padding-bottom: calc(16px + env(safe-area-inset-bottom));
  }

  .content.container {
    border-radius: 14px;
    padding: 10px !important;
  }

  .content.container .tab-panel {
    overflow: hidden;
  }

  .content.container .panel-header {
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    margin-bottom: 14px;
  }

  .content.container .btn-primary,
  .content.container .btn-secondary,
  .content.container .btn-outline {
    width: 100%;
    justify-content: center;
  }

  .content.container :is(
    .gifts-search,
    .gifts-select,
    .wc-input,
    .wc-select,
    .form-input,
    .fpv2-search-input,
    .cc-search,
    .conversion-search,
    .conversion-filter,
    #filesSearchInput,
    #userSearchInput
  ) {
    width: 100% !important;
    min-width: 0 !important;
  }

  .content.container :is(
    .stats-grid,
    .grid.grid-cols-2,
    .grid.grid-cols-3,
    #usersCardsContainer,
    #conversionsCardsContainer,
    #approvalHistoryCardsContainer,
    .wc-cards-grid
  ) {
    grid-template-columns: 1fr !important;
  }

  .content.container :is(
    .gift-card-item,
    .conversion-card-item,
    .wcard,
    .card,
    .stat-card,
    .tool-card
  ) {
    width: 100% !important;
    max-width: 100% !important;
  }

  .content.container .table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-radius: 10px;
  }

  .content.container .table-wrapper table,
  .content.container table.table {
    min-width: 640px;
  }

  .content.container .table-wrapper::-webkit-scrollbar {
    height: 6px;
  }
}

@media (max-width: 640px) {
  .tab-wrapper {
    top: 6px;
    margin-bottom: 8px;
  }

  .tab-menu-btn {
    min-height: 40px;
    font-size: 13px;
  }

  .tab-nav {
    width: min(90vw, 320px) !important;
  }

  .content.container {
    padding: 8px !important;
  }

  .content.container .card,
  .content.container .tool-card,
  .content.container .wcard {
    border-radius: 10px;
    padding: 10px;
  }

  .content.container .table-wrapper table,
  .content.container table.table {
    min-width: 560px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .admin-shell,
  .header,
  .admin-main-layout,
  .tab-wrapper,
  .tab-content.active,
  .tab-pane.active,
  .modal-wrap.show,
  .modal-wrap.open {
    animation: none !important;
  }

  button,
  .btn,
  .card,
  [class$="-card"],
  .table tbody tr,
  input,
  select,
  textarea {
    transition-duration: 0.01ms !important;
    transform: none !important;
  }
}

/* =====================================================================
   RESPONSIVE: 1281–1600px — narrow presence sidebar (saves 40px for content)
   ===================================================================== */
@media (min-width: 1281px) and (max-width: 1600px) {
  .dashboard-presence-layout {
    grid-template-columns: 240px minmax(0, 1fr);
  }
}

/* =====================================================================
   RESPONSIVE: 1025–1800px — compact tab buttons for mid-range desktops
   ===================================================================== */
@media (min-width: 1025px) and (max-width: 1800px) {
  .admin-main-layout .tab-btn {
    padding: 8px 13px;
    font-size: 13px;
  }
}

/* =====================================================================
   RESPONSIVE: 1281–1700px — layout gap/padding tightening
   ===================================================================== */
@media (min-width: 1281px) and (max-width: 1700px) {
  .dashboard-presence-layout {
    gap: 10px;
    padding: 6px 8px;
  }

  .dashboard-presence-layout .admin-shell {
    margin-top: 14px;
  }
}

</style>
</head>
<body>
<div class="dashboard-presence-layout">
<aside class="presence-sidebar" id="presenceSidebar">
  <div class="presence-head">
    <div>
      <h3>Trạng thái tài khoản</h3>
      <p>Đăng nhập hệ thống</p>
    </div>
    <div class="presence-head-actions">
      <button type="button" class="presence-refresh-btn" id="presenceRefreshBtn" title="Làm mới trạng thái"><i class="fas fa-rotate"></i></button>
      <button type="button" class="presence-collapse-btn" id="presenceToggleBtn" title="Ẩn panel trạng thái"><i class="fas fa-angles-left"></i></button>
    </div>
  </div>
  <div class="presence-summary" id="presenceSummary">Online 0 • Offline 0</div>
  <div class="presence-list" id="presenceList">
    <div class="presence-empty">Đang tải trạng thái...</div>
  </div>
</aside>
<button type="button" class="presence-toggle-fab" id="presenceToggleFab" title="Mở panel trạng thái" aria-label="Mở panel trạng thái">
  <i class="fas fa-angle-right arrow-right" aria-hidden="true"></i>
  <i class="fas fa-angle-right arrow-right-2" aria-hidden="true"></i>
</button>
<div class="dashboard-main-wrap">
<div class="admin-shell">
<div class="header">
  <div class="header-top">
    <div class="header-sub">
      <span>Chào mừng, <strong><%= currentUser.username %></strong></span>
      <span class="header-role-badge">Admin</span>
    </div>
    <div class="header-controls">
      <div class="admin-lang-switcher" id="adminLangSwitcher">
        <span class="admin-lang-label" data-i18n="langSwitch">Ngôn ngữ</span>
        <button class="admin-lang-btn active" data-lang="vi" onclick="switchAdminLanguage('vi')">VI</button>
        <button class="admin-lang-btn" data-lang="en" onclick="switchAdminLanguage('en')">EN</button>
        <button class="admin-lang-btn" data-lang="zh" onclick="switchAdminLanguage('zh')">中文</button>
      </div>
      <span class="sun-icon"><i class="fas fa-sun"></i></span>
      <div class="toggle-track" id="themeToggle" role="button" aria-label="Chuyển theme" tabindex="0">
        <div class="toggle-thumb"></div>
      </div>
      <span class="moon-icon"><i class="fas fa-moon"></i></span>
      <span style="font-size:13px;color:var(--text2)">Tự động làm mới</span>
      <div class="toggle-track" id="autoRefreshToggle">
        <div class="toggle-thumb"></div>
      </div>
      <button class="btn-refresh"><i class="fas fa-sync-alt"></i></button>
      <!-- Sound toggle button — click to enable/test sounds -->
      <button class="notif-sound-btn" id="notifSoundBtn" onclick="toggleAdminSound()" title="Bật/tắt âm thanh thông báo">
        <span id="notifSoundIcon">🔔</span>
      </button>
