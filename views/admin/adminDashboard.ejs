  }

  .admin-main-layout .content.container {
    margin: 0 auto !important;
    max-width: 100% !important;
    flex: initial;
    border: none;
    border-radius: 0;
    background: transparent;
    padding: 10px 14px !important;
  }

  .tab-sidebar-head,
  .tab-sidebar-foot {
    display: none !important;
  }

  .tab-sidebar-body {
    display: contents;
    padding: 0;
  }

