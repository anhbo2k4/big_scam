    return;
  }
  var pathname = String(window.location.pathname || '/');
  var adminIdx = pathname.indexOf('/admin');
  var basePrefix = adminIdx >= 0 ? pathname.slice(0, adminIdx) : '';
  var basePath = "".concat(basePrefix || '', "/").replace(/\/+/g, '/');
  var text = "".concat(window.location.origin).concat(basePath, "?code=").concat(encodeURIComponent(code));
  navigator.clipboard.writeText(text).then(function () {
    showToast('✅ Đã copy link phiên chơi!', 'success');
  }).catch(function () {
    showToast('❌ Copy thất bại, vui lòng thử lại', 'error');
  });
