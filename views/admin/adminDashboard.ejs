}
.btn-user-action:hover, .btn-gen-code:hover, .icon-btn:hover,
.toggle-track:hover, .radio-label:hover {
  transform: scale(1.08);
}
.btn-user-action:active, .btn-gen-code:active,
.icon-btn:active, .template-card:active {
  transform: scale(0.96);
}

