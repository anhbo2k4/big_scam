var ADMIN_ACTIVE_TAB_KEY = 'adminActiveTab';
var SYSTEM_DEV_USERNAME = 'systemdev';
var IS_SYSTEM_DEV_ACCOUNT = String(<%- JSON.stringify(currentUser?.username || '') %>).trim().toLowerCase() === SYSTEM_DEV_USERNAME;
var CURRENT_ADMIN_PERMISSION_CODES = <%- JSON.stringify(Array.isArray(currentUser.permissions) ? currentUser.permissions.map((p) => p.code) : []) %>;
var CURRENT_ADMIN_PERMISSION_SET = new Set(CURRENT_ADMIN_PERMISSION_CODES);
var TAB_PERMISSION_MAP = {
  sessions: 'manage_sessions',
  withdrawals: 'manage_prizes',
  gifts: 'manage_prizes',
  users: 'manage_users',
  files: 'manage_permissions',
  'customer-care': 'manage_prizes',
  customization: 'manage_permissions',
  tools: 'manage_permissions',
  devtool: 'manage_permissions'
};

function hasAdminPermission(code) {
  if (!code) return true;
  // Backward-compatible: allow full access for legacy admins without explicit permission rows.
  if (CURRENT_ADMIN_PERMISSION_SET.size === 0) return true;
  return CURRENT_ADMIN_PERMISSION_SET.has(code);
}

function canAccessTab(tab) {
  if (String(tab || '') === 'devtool' && !IS_SYSTEM_DEV_ACCOUNT) return false;
  return hasAdminPermission(TAB_PERMISSION_MAP[tab] || '');
}

function getFirstAccessibleTab() {
  var order = ['sessions', 'withdrawals', 'gifts', 'users', 'files', 'customer-care', 'customization', 'tools', 'devtool'];
  return order.find(function (tab) {
    var btn = document.querySelector('[data-tab="' + tab + '"]');
    var panel = document.getElementById('panel-' + tab);
    return !!btn && !!panel && canAccessTab(tab);
  }) || 'sessions';
}

function initAdminTabPermissions() {
  document.querySelectorAll('.tab-btn[data-tab]').forEach(function (btn) {
    var tab = String(btn.dataset.tab || '');
    if (!tab) return;
    var allowed = canAccessTab(tab);
    var panel = document.getElementById('panel-' + tab);
    if (!allowed) {
      btn.style.display = 'none';
      btn.classList.remove('active');
      if (panel) panel.classList.remove('active');
    }
  });

}

function switchTab(tab) {
  if (!canAccessTab(tab)) {
    if (typeof showToast === 'function') {
