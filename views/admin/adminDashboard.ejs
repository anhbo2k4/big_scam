<style>
.modal-overlay {
  display: none; position: fixed; inset: 0; z-index: 900;
  background: rgba(0,0,0,0.75); backdrop-filter: blur(4px);
  animation: fadeIn 0.2s ease;
}
.modal-overlay.open { display: block; }

.modal-wrap {
  display: none; position: fixed; inset: 0;
  width: 90%; max-width: 900px; height: 90vh; max-height: 85vh;
  margin: auto; z-index: 901;
  background: #111827; border: 1px solid rgba(255,255,255,0.1); border-radius: 12px;
  flex-direction: column;
  animation: scaleIn 0.28s cubic-bezier(0.34,1.2,0.64,1);
  overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,0.5);
}
.modal-wrap.open { display: flex; }
@keyframes scaleIn { from{transform:scale(0.95);opacity:0} to{transform:scale(1);opacity:1} }

/* Keep create/edit session modals perfectly centered on desktop. */
#createSessionModal.modal-wrap,
#editSessionModal.modal-wrap {
  inset: auto;
  top: 50%;
  left: 50%;
  right: auto;
  bottom: auto;
  margin: 0;
  transform: translate(-50%, -50%);
}

#createSessionModal.modal-wrap.show,
#createSessionModal.modal-wrap.open,
#editSessionModal.modal-wrap.open,
#editSessionModal.modal-wrap.show {
  animation: centeredModalIn 0.24s cubic-bezier(0.22, 1, 0.36, 1) !important;
}

@keyframes centeredModalIn {
  from { transform: translate(-50%, -47%) scale(0.97); opacity: 0; }
  to { transform: translate(-50%, -50%) scale(1); opacity: 1; }
}

/* Temp modal created by showModalDialog should fit content, not force full panel height */
.modal-wrap.temp-modal-wrap {
  inset: auto;
  top: 50%;
  left: 50%;
  right: auto;
  bottom: auto;
  margin: 0;
  transform: translate(-50%, -50%);
  width: min(640px, 92vw);
  max-width: 92vw;
  height: auto;
  max-height: 86vh;
  min-height: 0;
  overflow: visible;
  animation: tempModalIn 0.22s cubic-bezier(0.34,1.2,0.64,1);
}
.modal-wrap.temp-modal-wrap .modal-content {
  width: 100%;
  max-height: 82vh;
  overflow: auto;
  background: transparent;
}

@keyframes tempModalIn {
  from { transform: translate(-50%, -50%) scale(0.96); opacity: 0; }
  to { transform: translate(-50%, -50%) scale(1); opacity: 1; }
}

@keyframes fadeIn { from{opacity:0} to{opacity:1} }
@keyframes slideInUp { from{transform:translateY(20px);opacity:0} to{transform:translateY(0);opacity:1} }
@keyframes slideInRight { from{transform:translateX(60px);opacity:0} to{transform:translateX(0);opacity:1} }

.modal-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20px 28px; border-bottom: 1px solid rgba(255,255,255,0.08); flex-shrink: 0;
}
.modal-title { font-size: 18px; font-weight: 700; }
.modal-close {
  width: 32px; height: 32px; border-radius: 8px;
  background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1);
  color: var(--text2); cursor: pointer; font-size: 15px;
  display: flex; align-items: center; justify-content: center; transition: all 0.15s;
}
.modal-close:hover { background: rgba(239,68,68,0.15); color: var(--red); }

.modal-body {
  flex: 1; overflow-y: auto; padding: 24px 28px;
  scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.1) transparent;
}
.modal-body::-webkit-scrollbar { width: 5px; }
.modal-body::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 3px; }

