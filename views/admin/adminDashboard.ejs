function openModal() {
  var modalOverlay = document.getElementById('modalOverlay');
  var createSessionModal = document.getElementById('createSessionModal');

  if (modalOverlay) {
    modalOverlay.classList.add('show');
    modalOverlay.style.display = 'block';
  }
  if (createSessionModal) {
    createSessionModal.classList.add('show');
    createSessionModal.style.display = 'flex';
  }
  document.body.classList.add('modal-open');

  // Generate new code when opening modal
  generateCode();
  resetCreateSessionBoxOrder();

  // Setup icon selection and form handlers
  setTimeout(function () {
    setupIconSelection();
    setupToggleHandlers();
    setupRadioHandlers();
    setupModalCloseHandlers();
    setupCreateSessionBoxOrder();
    initCreateSessionWizard();
  }, 100);
}

var wizardState = { step: 1, total: 5 };
var wizardStepLabels = {
  1: 'Cấu hình thứ tự mở hộp',
  2: 'Cấu hình Hộp 1',
  3: 'Cấu hình Hộp 2',
  4: 'Cấu hình Hộp 3',
  5: 'Xác nhận & Tạo'
};

function initCreateSessionWizard() {
  var modal = document.getElementById('createSessionModal');
  if (!modal) return;

  wizardState.step = 1;
  wizardState.total = 5;

  var backBtn = document.getElementById('wizardBackBtn');
  var nextBtn = document.getElementById('wizardNextBtn');
  var createBtn = document.getElementById('wizardCreateBtn');
  var desktopCreateBtn = document.getElementById('btnCreateSession');

  if (backBtn) {
    backBtn.onclick = function () {return updateWizardStep(wizardState.step - 1);};
  }
  if (nextBtn) {
    nextBtn.onclick = function () {return updateWizardStep(wizardState.step + 1);};
  }
  if (createBtn && desktopCreateBtn) {
    createBtn.onclick = function () {return desktopCreateBtn.click();};
  }

  updateWizardStep(1);
}

function updateWizardStep(nextStep) {
  var modal = document.getElementById('createSessionModal');
  if (!modal) return;

  var step = Math.max(1, Math.min(wizardState.total, nextStep));
  wizardState.step = step;
  modal.dataset.wizardStep = String(step);

  var stepEls = modal.querySelectorAll('.wizard-step');
  stepEls.forEach(function (el) {
    var current = Number(el.dataset.wizardStep) === step;
    el.classList.toggle('wizard-active', current);
  });

  var prizeCards = modal.querySelectorAll('.prize-box-card[data-wizard-step]');
  prizeCards.forEach(function (card) {
    var current = Number(card.dataset.wizardStep) === step;
    card.classList.toggle('wizard-active', current);
  });

  var currentEl = document.getElementById('wizardStepCurrent');
  var labelEl = document.getElementById('wizardStepLabel');
  var fillEl = document.getElementById('wizardProgressFill');

  if (currentEl) currentEl.textContent = String(step);
  if (labelEl) labelEl.textContent = wizardStepLabels[step] || '';
  if (fillEl) fillEl.style.width = "".concat(step / wizardState.total * 100, "%");
}

function hasVisibleModals() {
  // Check if any modals are currently visible
  var modalOverlay = document.getElementById('modalOverlay');
  var createSessionModal = document.getElementById('createSessionModal');
  var notificationOverlay = document.getElementById('notificationOverlay');
  var notificationModal = document.getElementById('notificationModal');
  var tempOverlay = document.getElementById('tempModalOverlay');
  var tempModal = document.getElementById('tempModal');

  return (
    modalOverlay && modalOverlay.style.display !== 'none' && modalOverlay.style.display !== '' ||
    createSessionModal && createSessionModal.style.display !== 'none' && createSessionModal.style.display !== '' ||
    notificationOverlay && notificationOverlay.style.display !== 'none' && notificationOverlay.style.display !== '' ||
    notificationModal && notificationModal.style.display !== 'none' && notificationModal.style.display !== '' ||
    tempOverlay && tempOverlay.style.display !== 'none' ||
    tempModal && tempModal.style.display !== 'none');

}

function closeModal() {
  try {
    // Close pre-defined modals
    var modalOverlay = document.getElementById('modalOverlay');
    var createSessionModal = document.getElementById('createSessionModal');

    if (modalOverlay) {
      modalOverlay.classList.remove('show');
      modalOverlay.style.display = 'none';
    }
    if (createSessionModal) {
      createSessionModal.classList.remove('show');
      createSessionModal.style.display = 'none';
    }

    // Close temporary modals created by showModalDialog
    var tempOverlay = document.getElementById('tempModalOverlay');
    var tempModal = document.getElementById('tempModal');

    if (tempOverlay) {
      tempOverlay.remove();
    }
    if (tempModal) {
      tempModal.remove();
    }

    // Only remove body scroll lock if no modals are visible
    if (!hasVisibleModals()) {
      document.body.classList.remove('modal-open');
    }
  } catch (e) {
    console.error('Error closing modal:', e);
  }
}

// Setup close button and overlay event listeners
function setupModalCloseHandlers() {
  var modalOverlay = document.getElementById('modalOverlay');
  var createSessionModal = document.getElementById('createSessionModal');
  var closeBtn = document.querySelector('#createSessionModal .modal-close');

  // Close on overlay click (only when clicking on overlay background, not on modal)
  if (modalOverlay) {
    modalOverlay.onclick = function (e) {
      // Check if clicking directly on overlay (not on modal or its children)
      if (e.target === this) {
        closeModal();
        return false;
      }
    };
  }

  // Prevent clicks inside modal from closing it
  if (createSessionModal) {
    createSessionModal.onclick = function (e) {
      e.stopPropagation();
    };
  }

  // Close button handler
  if (closeBtn) {
    closeBtn.onclick = function (e) {
      e.preventDefault();
      e.stopPropagation();
      closeModal();
      return false;
    };
  }
}

function openEditModal(sessionCode) {
