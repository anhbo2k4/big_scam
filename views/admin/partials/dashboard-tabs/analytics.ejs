
  <div class="tab-panel" id="panel-analytics" style="margin-top: 0;">
    <h1 style="font-size:18px;font-weight:700;margin-bottom:20px">📊 Dashboard Analytics</h1>
    
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 24px;">
      <div style="background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 20px;">
        <div style="color: var(--text2); font-size: 12px; margin-bottom: 8px;">Phiên chơi hôm nay</div>
        <div id="sessionsToday" style="font-size: 28px; font-weight: 700; color: var(--blue);">0</div>
        <div style="color: var(--text3); font-size: 11px; margin-top: 4px;">↑ 12% từ hôm qua</div>
      </div>
      <div style="background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 20px;">
        <div style="color: var(--text2); font-size: 12px; margin-bottom: 8px;">Rút tiền chưa duyệt</div>
        <div id="pendingWithdrawals" style="font-size: 28px; font-weight: 700; color: var(--orange);">0</div>
        <div style="color: var(--text3); font-size: 11px; margin-top: 4px;">Cần xử lý</div>
      </div>
      <div style="background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 20px;">
        <div style="color: var(--text2); font-size: 12px; margin-bottom: 8px;">Người dùng hoạt động</div>
        <div id="activeUsers" style="font-size: 28px; font-weight: 700; color: var(--green);">0</div>
        <div style="color: var(--text3); font-size: 11px; margin-top: 4px;">Hôm nay</div>
      </div>
    </div>
    
    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 24px;">
      <div style="background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 20px;">
        <h3 style="margin: 0 0 16px 0; font-size: 14px; font-weight: 600;">Phiên chơi theo ngày (30 ngày)</h3>
        <canvas id="sessionsChart" style="height: 300px;"></canvas>
      </div>
      <div style="background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 20px;">
        <h3 style="margin: 0 0 16px 0; font-size: 14px; font-weight: 600;">Rút tiền theo trạng thái</h3>
        <canvas id="withdrawalsChart" style="height: 300px;"></canvas>
      </div>
    </div>
    
    <div style="background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 20px;">
      <h3 style="margin: 0 0 16px 0; font-size: 14px; font-weight: 600;">Phân bổ giải thưởng</h3>
      <canvas id="prizesChart" style="max-width: 400px; height: 300px; margin: 0 auto;"></canvas>
    </div>
  </div>

  

