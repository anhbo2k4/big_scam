<!-- BANNERS TAB -->
<div class="tab-panel" id="panel-banners">
  <div class="panel-header" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:20px;">
    <div style="flex:1;min-width:200px;">
      <h1 style="font-size:20px;font-weight:700;margin-bottom:4px;">🖼️ Quản lý Banner</h1>
      <p style="font-size:13px;color:var(--color-text-secondary);">Thêm, chỉnh sửa và sắp xếp banner hiển thị trên trang game và trang chủ</p>
    </div>
    <button class="btn btn-primary" onclick="return openBannerModal()" style="flex-shrink:0;"><i class="fas fa-plus"></i> Thêm banner mới</button>
  </div>

  <!-- Location filter tabs -->
  <div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;">
    <button class="banner-loc-btn active" data-loc="all" onclick="bannerMgr.setFilter('all', this)">🌐 Tất cả</button>
    <button class="banner-loc-btn" data-loc="game" onclick="bannerMgr.setFilter('game', this)">🎮 Màn game</button>
    <button class="banner-loc-btn" data-loc="home" onclick="bannerMgr.setFilter('home', this)">🏠 Trang chủ</button>
    <button class="banner-loc-btn" data-loc="both" onclick="bannerMgr.setFilter('both', this)">📍 Cả hai</button>
  </div>

  <!-- Stats row -->
  <div id="bannerStatsRow" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin-bottom:16px;"></div>

  <!-- Banner list -->
  <div id="bannerListContainer" style="display:grid;gap:12px;">
    <div style="text-align:center;padding:40px;color:var(--text3);"><i class="fas fa-spinner fa-spin"></i> Đang tải...</div>
  </div>

  <!-- Empty state (hidden by default) -->
  <div id="bannerEmptyState" style="display:none;text-align:center;padding:60px 20px;color:var(--text3);">
    <div style="font-size:48px;margin-bottom:12px;">🖼️</div>
    <h3 style="font-size:16px;margin-bottom:8px;color:var(--text2);">Chưa có banner nào</h3>
    <p style="font-size:13px;margin-bottom:16px;">Tạo banner đầu tiên để hiển thị trên giao diện người chơi</p>
    <button class="btn btn-primary" onclick="return openBannerModal()"><i class="fas fa-plus"></i> Thêm banner đầu tiên</button>
  </div>
</div>

<!-- Banner Modal -->
<div class="modal-overlay" id="bannerModalOverlay" style="display:none;" onclick="if(event.target===this)closeBannerModal()"></div>
<div class="modal-wrap" id="bannerModal" style="display:none;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);width:min(600px,94vw);max-width:min(600px,94vw);max-height:90vh;overflow:auto;z-index:10001;">
  <div class="modal-header" style="background:linear-gradient(135deg,#7c3aed,#ec4899);padding:14px 16px;">
    <h3 class="modal-title" style="margin:0;font-size:16px;font-weight:700;" id="bannerModalTitle">🖼️ Thêm banner mới</h3>
    <button class="modal-close-btn" onclick="closeBannerModal()"><i class="fas fa-times"></i></button>
  </div>
  <div class="modal-body" style="padding:20px;">
    <input type="hidden" id="bannerEditId" value="">

    <div style="display:grid;gap:14px;">
      <div>
        <label class="form-label">Nội dung văn bản banner</label>
        <input class="form-input" id="bannerText" placeholder="VD: 🎁 Khuyến mãi đặc biệt hôm nay! Nhận ngay quà tặng miễn phí." maxlength="200">
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <div>
          <label class="form-label">Màu nền banner</label>
          <div style="display:flex;gap:8px;align-items:center;">
            <input type="color" id="bannerBgColor" value="#1e1b38" style="width:44px;height:36px;border:none;background:none;cursor:pointer;border-radius:6px;">
            <input class="form-input" id="bannerBgColorText" value="#1e1b38" placeholder="#1e1b38" style="font-family:monospace;flex:1;">
          </div>
        </div>
        <div>
          <label class="form-label">Màu chữ</label>
          <div style="display:flex;gap:8px;align-items:center;">
            <input type="color" id="bannerTextColor" value="#ffffff" style="width:44px;height:36px;border:none;background:none;cursor:pointer;border-radius:6px;">
            <input class="form-input" id="bannerTextColorText" value="#ffffff" placeholder="#ffffff" style="font-family:monospace;flex:1;">
          </div>
        </div>
      </div>

      <div>
        <label class="form-label">URL hình ảnh banner (tuỳ chọn)</label>
        <div style="display:flex;gap:8px;">
          <input class="form-input" id="bannerImageUrl" placeholder="https://... hoặc /uploads/..." style="flex:1;">
          <button type="button" class="btn-upload2" onclick="document.getElementById('bannerImageFileInput').click()"><i class="fas fa-upload"></i> Upload</button>
        </div>
        <input type="file" id="bannerImageFileInput" accept="image/*" style="display:none;" onchange="uploadBannerImage(event)">
        <small style="color:var(--text3);display:block;margin-top:4px;">Hình ảnh sẽ hiển thị bên trái hoặc làm nền banner</small>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <div>
          <label class="form-label">URL liên kết (tuỳ chọn)</label>
          <input class="form-input" id="bannerLinkUrl" placeholder="https://...">
        </div>
        <div>
          <label class="form-label">Mở liên kết</label>
          <select class="form-input" id="bannerLinkTarget">
            <option value="_self">Cùng tab</option>
            <option value="_blank">Tab mới</option>
          </select>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <div>
          <label class="form-label">Vị trí hiển thị</label>
          <select class="form-input" id="bannerLocation">
            <option value="game">🎮 Màn game</option>
            <option value="home">🏠 Trang chủ</option>
            <option value="both">📍 Cả hai</option>
          </select>
        </div>
        <div>
          <label class="form-label">Trạng thái</label>
          <select class="form-input" id="bannerIsActive">
            <option value="1">✅ Hiển thị</option>
            <option value="0">❌ Ẩn</option>
          </select>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <div>
          <label class="form-label">Kiểu banner</label>
          <select class="form-input" id="bannerDisplayType">
            <option value="bar">Thanh banner (trên trang)</option>
            <option value="popup">Popup giữa màn hình</option>
            <option value="both">Cả thanh + popup</option>
          </select>
        </div>
        <div>
          <label class="form-label">Tần suất popup</label>
          <select class="form-input" id="bannerPopupFrequency">
            <option value="session">Mỗi phiên truy cập 1 lần</option>
            <option value="daily">Mỗi ngày 1 lần</option>
            <option value="always">Mỗi lần vào trang</option>
          </select>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;">
        <div>
          <label class="form-label">Delay popup (ms)</label>
          <input class="form-input" id="bannerPopupDelayMs" type="number" min="0" step="100" value="800">
        </div>
        <div>
          <label class="form-label">Nút CTA</label>
          <input class="form-input" id="bannerCtaText" placeholder="VD: Mua ngay">
        </div>
        <div>
          <label class="form-label">Đóng popup</label>
          <select class="form-input" id="bannerPopupDismissible">
            <option value="1">Cho phép đóng</option>
            <option value="0">Không cho đóng</option>
          </select>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;">
        <div>
          <label class="form-label">Tỉ lệ popup</label>
          <select class="form-input" id="bannerAspectRatio">
            <option value="16:9">16:9</option>
            <option value="3:4">3:4</option>
            <option value="4:3">4:3</option>
            <option value="9:16">9:16</option>
            <option value="1:1">1:1</option>
          </select>
        </div>
        <div>
          <label class="form-label">Rộng popup (tuỳ chọn)</label>
          <input class="form-input" id="bannerPopupWidth" placeholder="VD: 900px hoặc 80vw">
        </div>
        <div>
          <label class="form-label">Cao popup (tuỳ chọn)</label>
          <input class="form-input" id="bannerPopupHeight" placeholder="VD: 520px hoặc 70vh">
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <div>
          <label class="form-label">Animation vào</label>
          <select class="form-input" id="bannerShowAnimation">
            <option value="zoom">Zoom In</option>
            <option value="fade">Fade In</option>
            <option value="slide-up">Slide Up</option>
            <option value="slide-down">Slide Down</option>
            <option value="flip">Flip In</option>
          </select>
        </div>
        <div>
          <label class="form-label">Animation ra</label>
          <select class="form-input" id="bannerHideAnimation">
            <option value="fade">Fade Out</option>
            <option value="zoom-out">Zoom Out</option>
            <option value="slide-down">Slide Down</option>
            <option value="slide-up">Slide Up</option>
          </select>
        </div>
      </div>

      <small style="color:var(--text3);display:block;margin-top:-8px;">Kích thước hợp lệ: số + đơn vị px, vw, vh hoặc % (ví dụ: 900px, 80vw, 70vh)</small>

      <div style="display:grid;grid-template-columns:1fr auto;gap:12px;align-items:end;">
        <div>
          <label class="form-label">Tự đóng popup sau (ms, để trống = không tự đóng)</label>
          <input class="form-input" id="bannerAutoCloseMs" type="number" min="0" step="100" placeholder="VD: 5000">
        </div>
        <button type="button" class="btn btn-secondary" onclick="openGrapesBuilder()">🧩 Mở Visual Builder (kéo-thả)</button>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <div>
          <label class="form-label">Bắt đầu hiển thị (tùy chọn)</label>
          <input class="form-input" id="bannerStartAt" type="datetime-local">
        </div>
        <div>
          <label class="form-label">Kết thúc hiển thị (tùy chọn)</label>
          <input class="form-input" id="bannerEndAt" type="datetime-local">
        </div>
      </div>

      <input type="hidden" id="bannerDesignJson" value="">
      <input type="hidden" id="bannerDesignHtml" value="">
      <input type="hidden" id="bannerDesignCss" value="">

      <details id="bannerDesignStudio" style="border:1px solid var(--border);border-radius:10px;background:rgba(255,255,255,0.02);padding:10px;">
        <summary style="cursor:pointer;font-weight:700;color:var(--text2);">🎨 Design Studio (Canva-lite)</summary>
        <div style="display:grid;gap:12px;margin-top:10px;">
          <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:10px;">
            <input class="form-input" id="dsHeadline" placeholder="Headline" value="SALE OFF 50%">
            <input class="form-input" id="dsSubline" placeholder="Subline" value="Ưu đãi chỉ hôm nay">
            <input class="form-input" id="dsBadge" placeholder="Badge" value="LIMITED">
            <button type="button" class="btn btn-secondary" onclick="document.getElementById('dsImageUpload').click()">Thêm ảnh vào design</button>
            <input type="file" id="dsImageUpload" accept="image/*" style="display:none;" onchange="designStudio.onImageUpload(event)">
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:10px;">
            <div style="display:flex;gap:8px;align-items:center;"><label style="font-size:12px;">BG</label><input type="color" id="dsBg" value="#0b1220"></div>
            <div style="display:flex;gap:8px;align-items:center;"><label style="font-size:12px;">Text</label><input type="color" id="dsText" value="#ffffff"></div>
            <div style="display:flex;gap:8px;align-items:center;"><label style="font-size:12px;">Badge</label><input type="color" id="dsBadgeColor" value="#f59e0b"></div>
            <div style="display:flex;gap:8px;align-items:center;"><label style="font-size:12px;">CTA</label><input type="color" id="dsCtaColor" value="#2563eb"></div>
          </div>
          <canvas id="bannerDesignCanvas" width="1200" height="628" style="width:100%;max-height:280px;border:1px solid var(--border);border-radius:10px;background:#0b1220;"></canvas>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <button type="button" class="btn btn-secondary" onclick="designStudio.render()">Render lại</button>
            <button type="button" class="btn btn-primary" onclick="designStudio.exportToBannerImage()">Xuất design -> ảnh banner</button>
          </div>
        </div>
      </details>

      <!-- Preview -->
      <div>
        <label class="form-label">Xem trước banner</label>
        <div id="bannerPreviewBox" style="border-radius:8px;padding:12px 16px;display:flex;align-items:center;gap:12px;min-height:52px;background:#1e1b38;color:#fff;font-size:14px;font-weight:500;transition:all .2s;">
          <span id="bannerPreviewText" style="flex:1;">Xem trước nội dung banner...</span>
          <img id="bannerPreviewImg" src="" style="height:36px;border-radius:4px;display:none;" alt="preview">
        </div>
      </div>
    </div>
  </div>
  <div class="modal-footer" style="padding:14px 20px;display:flex;gap:10px;justify-content:flex-end;border-top:1px solid var(--border);">
    <button class="btn btn-secondary" onclick="closeBannerModal()">Hủy</button>
    <button class="btn btn-primary" onclick="saveBanner()"><i class="fas fa-save"></i> Lưu banner</button>
  </div>
</div>

  <div id="grapesBuilderOverlay" style="display:none;position:fixed;inset:0;z-index:12050;background:rgba(2,6,23,0.9);">
    <div style="position:absolute;inset:20px;border:1px solid rgba(255,255,255,0.18);border-radius:12px;overflow:hidden;background:#0f172a;display:flex;flex-direction:column;">
      <div style="display:flex;align-items:center;gap:10px;padding:10px 12px;background:#111827;border-bottom:1px solid rgba(255,255,255,0.1);">
        <strong style="color:#e5e7eb;">GrapesJS Visual Builder</strong>
        <span style="color:#93c5fd;font-size:12px;">Kéo thả block, chỉnh style, bấm Áp dụng vào banner</span>
        <div style="margin-left:auto;display:flex;gap:8px;">
          <button type="button" class="btn btn-secondary" onclick="grapesUndo()">Undo</button>
          <button type="button" class="btn btn-secondary" onclick="grapesRedo()">Redo</button>
          <button type="button" class="btn btn-secondary" onclick="importGrapesTemplate()">Nhập template JSON</button>
          <button type="button" class="btn btn-secondary" onclick="exportGrapesTemplate()">Xuất template JSON</button>
          <button type="button" class="btn btn-secondary" onclick="bringSelectedForward()">Layer lên trên</button>
          <button type="button" class="btn btn-secondary" onclick="sendSelectedBackward()">Layer xuống dưới</button>
          <button type="button" class="btn btn-secondary" onclick="toggleSelectedLock()">Khóa hoặc mở layer</button>
          <button type="button" class="btn btn-secondary" onclick="cloneSelectedComponent()">Nhân bản layer</button>
          <button type="button" class="btn btn-secondary" onclick="deleteSelectedComponent()">Xóa layer</button>
          <button type="button" class="btn btn-secondary" onclick="applyGrapesDesignToBanner()">Áp dụng vào banner</button>
          <button type="button" class="btn btn-primary" onclick="closeGrapesBuilder()">Đóng builder</button>
        </div>
      </div>
      <div style="display:flex;gap:10px;padding:10px 12px;background:#0b1220;border-bottom:1px solid rgba(255,255,255,0.08);overflow-x:auto;">
        <button type="button" class="btn btn-secondary" onclick="applyTemplateByName('promo-hero')">🧱 Promo Hero</button>
        <button type="button" class="btn btn-secondary" onclick="applyTemplateByName('flashSale')">⚡ Flash Sale</button>
        <button type="button" class="btn btn-secondary" onclick="applyTemplateByName('newArrival')">🆕 New Arrival</button>
        <button type="button" class="btn btn-secondary" onclick="applyTemplateByName('event')">🎉 Event Banner</button>
      </div>
      <div id="grapesTemplateGallery" style="display:grid;grid-template-columns:repeat(4,minmax(180px,1fr));gap:10px;padding:10px 12px;background:#0b1220;border-bottom:1px solid rgba(255,255,255,0.08);"></div>
      <div id="grapesEditorHost" style="flex:1;min-height:0;"></div>
    </div>
  </div>
  <input type="file" id="grapesTemplateImportInput" accept="application/json" style="display:none;" onchange="handleImportGrapesTemplate(event)">

<style>
/* Banner tab styles */
#bannerModalOverlay {
  position: fixed;
  inset: 0;
  z-index: 10000;
}

#bannerModal {
  position: fixed !important;
  top: 50% !important;
  left: 50% !important;
  right: auto !important;
  bottom: auto !important;
  margin: 0 !important;
  transform: translate(-50%, -50%) !important;
  width: min(600px, 94vw) !important;
  max-width: min(600px, 94vw) !important;
  max-height: 90vh !important;
  overflow: auto !important;
  z-index: 10001 !important;
}

@media (max-width: 768px) {
  #bannerModal {
    width: min(600px, 96vw) !important;
    max-height: 92vh !important;
  }
}

.banner-loc-btn {
  padding: 6px 14px;
  border: 1px solid var(--border);
  border-radius: 20px;
  background: var(--card);
  color: var(--text2);
  cursor: pointer;
  font-size: 13px;
  font-weight: 500;
  transition: all .2s;
}
.banner-loc-btn.active {
  background: linear-gradient(135deg, #7c3aed, #ec4899);
  color: #fff;
  border-color: transparent;
}
.banner-item-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 14px 16px;
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 12px;
  align-items: center;
  transition: box-shadow .2s;
}
.banner-item-card:hover { box-shadow: 0 4px 16px rgba(124,58,237,0.15); }
.banner-item-drag { color: var(--text3); cursor: grab; font-size: 16px; }
.banner-item-preview {
  border-radius: 8px;
  padding: 10px 14px;
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  font-weight: 500;
}
.banner-item-meta { font-size: 11px; color: var(--text3); display: flex; gap: 8px; flex-wrap: wrap; margin-top: 4px; }
.banner-item-actions { display: flex; gap: 6px; }
.banner-item-actions button { background: none; border: 1px solid var(--border); border-radius: 6px; padding: 6px 10px; cursor: pointer; color: var(--text2); font-size: 12px; transition: all .15s; }
.banner-item-actions button:hover { border-color: #7c3aed; color: #7c3aed; }
.banner-item-actions button.delete:hover { border-color: #ef4444; color: #ef4444; }

#grapesBuilderOverlay .gjs-one-bg { background-color: #0b1220; }
#grapesBuilderOverlay .gjs-two-color { color: #cbd5e1; }
#grapesBuilderOverlay .gjs-three-bg { background-color: #1f2937; color: #fff; }
#grapesBuilderOverlay .gjs-four-color,
#grapesBuilderOverlay .gjs-four-color-h:hover { color: #60a5fa; }

.g-tpl-card {
  border: 1px solid rgba(148, 163, 184, 0.35);
  border-radius: 10px;
  background: #111827;
  overflow: hidden;
  cursor: pointer;
  transition: transform .15s ease, border-color .15s ease;
}

.g-tpl-card:hover {
  transform: translateY(-2px);
  border-color: #60a5fa;
}

.g-tpl-thumb {
  height: 88px;
  padding: 10px;
  color: #fff;
  font-size: 11px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  gap: 4px;
}

.g-tpl-meta {
  padding: 8px 10px;
  color: #cbd5e1;
  font-size: 12px;
}

@media (max-width: 1100px) {
  #grapesTemplateGallery {
    grid-template-columns: repeat(2, minmax(160px, 1fr)) !important;
  }
}
