function handleImportGrapesTemplate(event) {
  var file = event.target.files && event.target.files[0];
  if (!file || !grapesEditor) return;
  var reader = new FileReader();
  reader.onload = function () {
    try {
      var data = JSON.parse(String(reader.result || '{}'));
      if (data.html) {
        grapesEditor.setComponents(data.html);
        grapesEditor.setStyle(data.css || '');
      } else {
        grapesEditor.setComponents(data.components || '');
        grapesEditor.setStyle(data.styles || '');
      }
      if (typeof showToast === 'function') showToast('✅ Đã nhập template', 'success');
    } catch (e) {
      if (typeof showToast === 'function') showToast('❌ File template không hợp lệ', 'error');
    }
  };
  reader.readAsText(file);
}

function getSelectedComponent() {
  if (!grapesEditor) return null;
  return grapesEditor.getSelected();
}

function bringSelectedForward() {
  var comp = getSelectedComponent();
  if (!comp || !comp.parent()) return;
  var parent = comp.parent();
  var idx = parent.index(comp);
  if (idx < parent.components().length - 1) {
    parent.append(comp, { at: idx + 1 });
  }
}

function sendSelectedBackward() {
  var comp = getSelectedComponent();
  if (!comp || !comp.parent()) return;
  var parent = comp.parent();
  var idx = parent.index(comp);
  if (idx > 0) {
    parent.append(comp, { at: idx - 1 });
  }
}

function toggleSelectedLock() {
  var comp = getSelectedComponent();
  if (!comp) return;
  grapesSelectedLocked = !grapesSelectedLocked;
  comp.set({
    draggable: !grapesSelectedLocked,
    editable: !grapesSelectedLocked,
    selectable: true,
    hoverable: true
  });
  if (typeof showToast === 'function') showToast(grapesSelectedLocked ? '🔒 Đã khóa layer' : '🔓 Đã mở khóa layer', 'success');
}

function cloneSelectedComponent() {
  var comp = getSelectedComponent();
  if (!comp || !comp.parent()) return;
  var parent = comp.parent();
  var idx = parent.index(comp);
  var clone = comp.clone();
  parent.append(clone, { at: idx + 1 });
}

function deleteSelectedComponent() {
  var comp = getSelectedComponent();
  if (!comp) return;
  comp.remove();
}

