function toLocalDatetimeInputValue(value) {
  if (!value) return '';
  var d = new Date(value);
  if (Number.isNaN(d.getTime())) return '';
  var pad = function pad(n) {return String(n).padStart(2, '0');};
  var yyyy = d.getFullYear();
  var mm = pad(d.getMonth() + 1);
  var dd = pad(d.getDate());
  var hh = pad(d.getHours());
  var mi = pad(d.getMinutes());
  return yyyy + '-' + mm + '-' + dd + 'T' + hh + ':' + mi;
}

function ensureGrapesLoaded() {
  if (grapesLoaded && window.grapesjs) return Promise.resolve();
  return new Promise(function (resolve, reject) {
    var cssId = 'grapesjs-css-cdn';
    if (!document.getElementById(cssId)) {
      var link = document.createElement('link');
      link.id = cssId;
      link.rel = 'stylesheet';
      link.href = 'https://unpkg.com/grapesjs/dist/css/grapes.min.css';
      document.head.appendChild(link);
    }

    if (window.grapesjs) {
      grapesLoaded = true;
      resolve();
      return;
    }

    var s = document.createElement('script');
    s.src = 'https://unpkg.com/grapesjs';
    s.onload = function () {
      grapesLoaded = true;
      resolve();
    };
    s.onerror = reject;
    document.head.appendChild(s);
  });
}

