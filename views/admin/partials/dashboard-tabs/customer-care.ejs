    <div class="cc-info-sheet" id="ccInfoSheet">
      <div class="cc-info-sheet-backdrop" id="ccInfoSheetBackdrop"></div>
      <div class="cc-info-sheet-panel" role="dialog" aria-modal="true" aria-label="Thông tin khách hàng">
