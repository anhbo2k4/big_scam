  <script>
(function customerCareVisibilityBridge() {
  var panel = document.getElementById('panel-customer-care');
  if (!panel) return;

  var emit = function emit() {
    var visible = panel.classList.contains('active');
    window.dispatchEvent(new CustomEvent('cc:visibility', { detail: { visible: visible } }));
  };

  // Initial state: notify immediately so chat can start/stop fallback polling correctly.
  emit();

  // Observe tab activation without coupling to switchTab implementation details.
  var observer = new MutationObserver(function () {return emit();});
  observer.observe(panel, { attributes: true, attributeFilter: ['class'] });

  // Load non-critical emoji bundle lazily so chat list/input appears first.
  var lazyLoadEmoji = function lazyLoadEmoji() {
    if (window.EmojiMart) return;
    var tag = document.createElement('script');
    tag.src = '/vendor/emoji-mart/browser.js';
    tag.defer = true;
    tag.crossOrigin = 'anonymous';
    document.head.appendChild(tag);
  };

  if ('requestIdleCallback' in window) {
    window.requestIdleCallback(lazyLoadEmoji, { timeout: 2500 });
  } else {
    setTimeout(lazyLoadEmoji, 1200);
  }
})();</script>
