            <input class="form-input" id="i18nEditKey" placeholder="Key (VD: heroTitle)" style="flex:1;">
            <input class="form-input" id="i18nEditValue" placeholder="Giá trị dịch" style="flex:2;">
            <button type="button" class="cust-save-btn" onclick="addI18nOverride()" style="padding:8px 16px;"><i class="fas fa-plus"></i></button>
          </div>
          <div id="i18nOverridesList" style="max-height:250px;overflow-y:auto;"></div>
        </div>
        <div class="cust-card"><div class="cust-card-title">🔍 Xem bản dịch hiện tại</div>
          <div style="display:flex;gap:8px;margin-bottom:10px;">
            <select class="form-input" id="i18nPreviewLang" onchange="previewI18nTranslations(); if(window.applyAdminLanguage){window.applyAdminLanguage(this.value);}" style="max-width:160px;">
              <option value="vi">🇻🇳 Tiếng Việt</option>
              <option value="en">🇬🇧 English</option>
              <option value="zh">🇨🇳 中文</option>
            </select>
            <button type="button" class="btn-test" onclick="previewI18nTranslations()"><i class="fas fa-eye"></i> Xem</button>
          </div>
          <div id="i18nPreviewArea" style="max-height:300px;overflow-y:auto;font-size:12px;font-family:monospace;background:var(--bg4);padding:12px;border-radius:8px;"></div>
        </div>
      </div>
      <button class="cust-save-btn" onclick="saveI18nSettings()" style="margin-top:20px;"><i class="fas fa-save"></i> Lưu cài đặt ngôn ngữ</button>
    </div>

    <!-- ANIMATION PRESETS TAB -->
    <div id="customTab-animpresets" class="custom-section" style="display:none;">
      <div class="custom-section-title">🎬 Quản lý Animation Preset</div>
      <div class="custom-section-sub">Tạo và xem trước các hiệu ứng animation cho hộp quà</div>
      <div style="display:grid;gap:16px;">
        <div class="cust-card"><div class="cust-card-title">📋 Danh sách Presets</div>
          <div id="animPresetsList" style="display:grid;gap:10px;"></div>
          <div style="margin-top:14px;padding-top:14px;border-top:1px solid var(--border);">
            <div class="cust-card-title">➕ Thêm preset mới</div>
            <div style="display:grid;grid-template-columns:1fr 1fr 120px;gap:8px;">
              <input class="form-input" id="newPresetName" placeholder="Tên preset (VD: shake)">
              <input class="form-input" id="newPresetLabel" placeholder="Nhãn hiển thị (VD: Rung lắc)">
              <input class="form-input" id="newPresetDuration" placeholder="1s" value="1s">
