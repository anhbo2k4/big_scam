        </div>
        <div class="cust-card"><div class="cust-card-title">👁️ Xem trước Animation</div>
          <div style="display:flex;gap:12px;align-items:center;margin-bottom:14px;">
            <select class="form-input" id="animPreviewSelect" style="max-width:200px;"></select>
            <button type="button" class="btn-test" onclick="previewAnimation()"><i class="fas fa-play"></i> Chạy thử</button>
          </div>
          <div style="display:flex;justify-content:center;padding:30px;background:var(--bg4);border-radius:12px;">
            <div id="animPreviewBox" style="width:100px;height:100px;background:linear-gradient(135deg,#667eea,#764ba2);border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:32px;">🎁</div>
          </div>
        </div>
      </div>
      <button class="cust-save-btn" onclick="saveAnimPresets()" style="margin-top:20px;"><i class="fas fa-save"></i> Lưu Animation Presets</button>
    </div>

    <!-- BOX TEMPLATE LIBRARY TAB -->
    <div id="customTab-boxtemplatelib" class="custom-section" style="display:none;">
      <div class="custom-section-title">📤 Template Hộp Quà</div>
      <div class="custom-section-sub">Xuất, nhập và quản lý thư viện template hộp quà</div>
      <div style="display:grid;gap:16px;">
        <div class="cust-card"><div class="cust-card-title">📤 Xuất template hiện tại</div>
          <div style="display:grid;grid-template-columns:1fr auto auto;gap:8px;align-items:end;">
            <div><label class="form-label">Tên template</label><input class="form-input" id="exportTemplateName" placeholder="VD: Template Tết 2025"></div>
            <button type="button" class="cust-save-btn" onclick="exportBoxTemplateOnly()" style="padding:10px 18px;"><i class="fas fa-download"></i> <span data-i18n="adminTemplateOnly">Template-only</span></button>
            <button type="button" class="cust-save-btn" onclick="exportBoxTemplateWithModalSkin()" style="padding:10px 18px;"><i class="fas fa-layer-group"></i> <span data-i18n="adminTemplateWithModalSkin">Template + Modal Skin</span></button>
          </div>
        </div>
        <div class="cust-card"><div class="cust-card-title">📥 Nhập template</div>
          <div style="display:flex;gap:8px;align-items:end;">
            <div style="flex:1;"><label class="form-label">Upload file JSON</label><input type="file" id="importTemplateFile" accept=".json" class="form-input"></div>
            <button type="button" class="cust-save-btn" onclick="importBoxTemplate()" style="padding:10px 20px;"><i class="fas fa-upload"></i> Nhập</button>
          </div>
          <div style="margin-top:8px;"><label class="form-label">Hoặc dán JSON</label>
            <textarea class="form-input" id="importTemplateJson" style="min-height:80px;font-family:monospace;font-size:12px;" placeholder='{"type":"giftbox-template","name":"...","boxSettings":{...},"animationPresets":{"presets":[...]}}'></textarea>
            <button type="button" class="btn-test" onclick="importBoxTemplateFromJson()" style="margin-top:6px;"><i class="fas fa-paste"></i> Nhập từ JSON</button>
          </div>
        </div>
        <div class="cust-card"><div class="cust-card-title">📚 Thư viện Templates</div>
          <div id="boxTemplateLibList" style="display:grid;gap:10px;"></div>
          <div id="boxTemplateLibEmpty" style="text-align:center;padding:30px;color:var(--text3);">Chưa có template nào. Hãy xuất template đầu tiên!</div>
        </div>
      </div>
    </div>

