            <div style="margin-top:8px;"><label class="form-label">CSS @keyframes</label>
              <textarea class="form-input" id="newPresetCss" style="min-height:100px;font-family:monospace;font-size:12px;" placeholder="@keyframes myPreset { 0% { transform: scale(1); } 50% { transform: scale(1.1); } 100% { transform: scale(1); } }"></textarea>
            </div>
            <button type="button" class="cust-save-btn" onclick="addAnimPreset()" style="margin-top:8px;padding:8px 16px;"><i class="fas fa-plus"></i> Thêm preset</button>
            <button type="button" class="btn-test" onclick="loadBuiltinAnimPresets()" style="margin-top:8px;padding:8px 16px;"><i class="fas fa-magic"></i> Tải presets mẫu</button>
