<!-- DEVTOOL TAB -->
<div class="tab-panel" id="panel-devtool">
  <h1 style="font-size:18px;font-weight:700;margin-bottom:20px">DevTool nội bộ</h1>

  <div class="tool-card" style="margin-top:0;">
    <div class="tool-title"><i class="fas fa-code" style="color:var(--text2)"></i> DevTool nội bộ (kiểm tra lỗi & chỉnh file)</div>
    <p style="font-size:13px;color:var(--text2);margin-bottom:12px;">Công cụ dành cho dev: duyệt file dự án, đọc/chỉnh/syntax-check/lưu nhanh mà không cần vào hosting shell liên tục.</p>

    <div class="devtool-pane-tabs" id="devtoolPaneTabs">
      <button type="button" class="devtool-pane-tab active" data-pane="files">File DevTool</button>
      <button type="button" class="devtool-pane-tab" data-pane="ips">IP truy cập</button>
    </div>

    <div class="devtool-pane active" id="devtoolPaneFiles">

    <div class="devtool-actions-row">
      <button type="button" class="btn-save-sm" id="devtoolRefreshTreeBtn"><i class="fas fa-rotate"></i> Tải lại cây file</button>
      <button type="button" class="btn-save-sm" id="devtoolRuntimeBtn"><i class="fas fa-heart-pulse"></i> Runtime status</button>
      <select id="devtoolDbExportFormat" class="config-input" style="max-width:170px;">
        <option value="auto">DB export auto</option>
        <option value="sql">DB export SQL</option>
        <option value="json">DB export JSON</option>
      </select>
      <button type="button" class="btn-save-sm" onclick="(function(){var el=document.getElementById('devtoolDbExportFormat');var format=(el&&el.value)||'auto';window.open('/api/tools/dev/database-export?format='+encodeURIComponent(format), '_blank');})();"><i class="fas fa-database"></i> Export DB</button>
      <button type="button" class="btn-save-sm" id="devtoolRestartBtn"><i class="fas fa-power-off"></i> Restart server</button>
      <button type="button" class="btn-save-sm" id="devtoolAuditBtn"><i class="fas fa-clipboard-list"></i> Xem audit log</button>
      <span id="devtoolRuntimeText" style="font-size:12px;color:var(--text3);"></span>
      <span id="devtoolRestartModeText" style="font-size:12px;color:#93c5fd;"></span>
    </div>
    <div style="font-size:12px;color:var(--text3);margin:-2px 0 10px 0;">`auto` sẽ ưu tiên export SQL từ hosting bằng `mysqldump`, nếu hosting chặn command thì tự fallback sang JSON snapshot của database.</div>

    <div class="devtool-layout">
      <aside class="devtool-file-tree" id="devtoolFileTree"></aside>
      <section class="devtool-editor-zone">
        <div class="devtool-path-row">
          <input type="text" id="devtoolPathInput" class="config-input" placeholder="Vi du: public/js/admin-customer-care.js">
          <button type="button" class="btn-save-sm" id="devtoolLoadBtn">Mo file</button>
          <button type="button" class="btn-save-sm" id="devtoolCheckBtn">Check cu phap</button>
          <button type="button" class="btn-save-sm" id="devtoolSaveBtn">Luu file</button>
          <button type="button" class="btn-save-sm" id="devtoolSaveRestartBtn">Luu + Restart</button>
          <button type="button" class="btn-save-sm" id="devtoolLoadRevisionsBtn">Lich su file</button>
        </div>
        <div class="devtool-path-row">
          <select id="devtoolRevisionSelect" class="config-input" style="max-width:520px;">
            <option value="">Chua tai phien ban rollback</option>
          </select>
          <button type="button" class="btn-save-sm" id="devtoolRollbackBtn">Rollback 1-click</button>
        </div>
        <textarea id="devtoolEditor" class="devtool-editor" spellcheck="false" placeholder="Noi dung file se hien thi o day..."></textarea>
        <pre id="devtoolLog" class="devtool-log">DevTool san sang.</pre>
      </section>
    </div>

    </div>

    <div class="devtool-pane" id="devtoolPaneIps">
      <div class="devtool-actions-row" style="margin-bottom:12px;">
        <button type="button" class="btn-save-sm" id="devtoolIpRefreshBtn"><i class="fas fa-network-wired"></i> Tải IP truy cập</button>
        <span id="devtoolIpSummary" style="font-size:12px;color:var(--text3);">Chưa tải dữ liệu IP.</span>
      </div>
      <div class="devtool-ip-table-wrap">
        <table class="devtool-ip-table">
          <thead>
            <tr>
              <th>IP</th>
              <th>Địa chỉ</th>
              <th>Nhà mạng</th>
              <th>Lượt</th>
              <th>Nguồn</th>
              <th>Trang truy cập</th>
              <th>Browser/Thiết bị</th>
              <th>Lần cuối</th>
            </tr>
          </thead>
          <tbody id="devtoolIpTableBody">
            <tr><td colspan="8" class="devtool-ip-empty">Bấm Tải IP truy cập để xem dữ liệu.</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<style>
  #panel-devtool .devtool-pane-tabs { display:flex; gap:8px; margin-bottom:12px; flex-wrap:wrap; }
  #panel-devtool .devtool-pane-tab { border:1px solid var(--border); background:var(--bg4); color:var(--text2); border-radius:10px; padding:8px 12px; font-size:12.5px; font-weight:700; cursor:pointer; }
  #panel-devtool .devtool-pane-tab:hover { color:var(--text); border-color:rgba(59,130,246,0.4); }
  #panel-devtool .devtool-pane-tab.active { background:rgba(59,130,246,0.16); border-color:rgba(59,130,246,0.45); color:#bfdbfe; }
  #panel-devtool .devtool-pane { display:none; }
  #panel-devtool .devtool-pane.active { display:block; }
  #panel-devtool .devtool-actions-row { display:flex; align-items:center; gap:8px; margin-bottom:10px; flex-wrap:wrap; }
  #panel-devtool .devtool-layout { display:grid; grid-template-columns:320px 1fr; gap:12px; }
  #panel-devtool .devtool-file-tree { border:1px solid var(--border); border-radius:10px; background:var(--bg4); min-height:420px; max-height:640px; overflow:auto; padding:8px; }
  #panel-devtool .devtool-tree-item { padding:7px 8px; border-radius:8px; color:var(--text2); font-size:12.5px; cursor:pointer; border:1px solid transparent; }
  #panel-devtool .devtool-tree-item:hover { background:rgba(59,130,246,0.1); border-color:rgba(59,130,246,0.2); color:var(--text); }
  #panel-devtool .devtool-tree-item.dir { font-weight:700; color:var(--text); cursor:default; }
  #panel-devtool .devtool-tree-item.file.active { background:rgba(34,197,94,0.12); border-color:rgba(34,197,94,0.25); color:#86efac; }
  #panel-devtool .devtool-editor-zone { display:flex; flex-direction:column; gap:8px; }
  #panel-devtool .devtool-path-row { display:flex; align-items:center; gap:8px; }
  #panel-devtool .devtool-editor { width:100%; min-height:420px; border:1px solid var(--border); border-radius:10px; padding:12px; background:#0f172a; color:#e2e8f0; font-family:Consolas, 'Courier New', monospace; font-size:12.5px; line-height:1.5; resize:vertical; }
  #panel-devtool .devtool-log { margin:0; min-height:90px; max-height:190px; overflow:auto; border:1px solid var(--border); border-radius:10px; padding:10px; background:var(--bg4); color:var(--text2); font-size:12px; white-space:pre-wrap; }
  #panel-devtool .devtool-ip-table-wrap { border:1px solid var(--border); border-radius:10px; background:var(--bg4); overflow:auto; }
  #panel-devtool .devtool-ip-table { width:100%; border-collapse:collapse; min-width:1180px; }
  #panel-devtool .devtool-ip-table th,
  #panel-devtool .devtool-ip-table td { padding:9px 10px; border-bottom:1px solid rgba(255,255,255,0.07); text-align:left; font-size:12.5px; color:var(--text2); vertical-align:top; }
  #panel-devtool .devtool-ip-table th { color:var(--text); font-weight:700; background:rgba(255,255,255,0.03); position:sticky; top:0; z-index:1; }
  #panel-devtool .devtool-ip-table td.ip { font-family:Consolas, 'Courier New', monospace; color:#c7d2fe; font-weight:700; }
  #panel-devtool .devtool-ip-table td.count { color:#86efac; font-weight:700; }
  #panel-devtool .devtool-ip-empty { text-align:center !important; color:var(--text3) !important; }
  @media (max-width: 1200px) {
    #panel-devtool .devtool-layout { grid-template-columns:1fr; }
    #panel-devtool .devtool-file-tree { min-height:180px; max-height:260px; }
    #panel-devtool .devtool-path-row { flex-wrap:wrap; }
  }
</style>

<script type="module" src="/build-modern/admin-tools-devkit.js?v=20260322dev06"></script>
<script nomodule src="/build-legacy/admin-tools-devkit.js?v=20260322dev06"></script>
