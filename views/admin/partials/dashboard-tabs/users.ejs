<!-- USERS TAB -->
  <div class="tab-panel" id="panel-users">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-4); margin-bottom: var(--space-6);">
      <h1 style="font-size: 20px; font-weight: 700;">Quản lý người dùng</h1>
      <button class="btn btn-success" onclick="showCreateUserModal()"><i class="fas fa-plus"></i> Thêm người dùng</button>
    </div>
    <div class="grid grid-cols-3" style="gap: var(--space-3); margin-bottom: var(--space-4); align-items: center;">
      <div class="form-group" style="margin-bottom: 0; position: relative;">
        <i class="fas fa-search" style="position: absolute; left: var(--space-3); top: 50%; transform: translateY(-50%); color: var(--color-text-tertiary);"></i>
        <input class="form-input" id="userSearchInput" style="padding-left: var(--space-10);" placeholder="Tìm kiếm theo tên, email..." oninput="filterUsersDebounced()">
      </div>
      <button class="btn btn-secondary btn-icon" style="grid-column: auto;" onclick="loadUsersFromAPI()"><i class="fas fa-sync-alt"></i></button>
      <select class="form-select" id="userRoleFilter" onchange="loadUsersFromAPI()">
        <option value="">Tất cả</option>
        <option value="admin">Admin</option>
        <option value="user">User</option>
      </select>
    </div>
    <div id="usersCountInfo" style="font-size: 12px; color: var(--color-text-secondary); margin-bottom: var(--space-4);">Đang tải...</div>
    <div style="font-size: 12px; color: var(--color-text-tertiary); margin-bottom: var(--space-3);">Quyền: quyền 1, quyền 2, ... xem thêm ở tab User.</div>
    <div class="grid grid-cols-2" id="usersCardsContainer" style="gap: var(--space-4);">
      <div style="grid-column: 1 / -1; text-align: center; padding: 40px; color: var(--color-text-tertiary);">
        <i class="fas fa-spinner fa-spin" style="font-size: 24px; margin-bottom: 8px;"></i>
        <div>Đang tải danh sách người dùng...</div>
      </div>
    </div>
    <div id="usersPagination" style="display: flex; justify-content: center; gap: 4px; margin-top: var(--space-4);"></div>
  </div>