<!-- VISITS TAB -->
  <div class="tab-panel" id="panel-visits">
    <div style="display:flex;gap:12px;align-items:center;margin-bottom:20px;">
      <h1 style="font-size:18px;font-weight:700;margin:0">Theo dõi IP truy cập website</h1>
      <div style="flex:1;"></div>
    </div>

    <div class="stats-grid">
      <div class="stat-card"><div class="stat-info"><div class="stat-label">Tổng lượt ghi nhận</div><div class="stat-value"><%= visitsList ? visitsList.length : 0 %></div></div><div class="stat-icon-wrap cyan"><i class="fas fa-globe"></i></div></div>
      <div class="stat-card"><div class="stat-info"><div class="stat-label">IP duy nhất</div><div class="stat-value" style="color:var(--blue)"><%= stats.uniqueVisitors || 0 %></div></div><div class="stat-icon-wrap blue"><i class="fas fa-network-wired"></i></div></div>
      <div class="stat-card"><div class="stat-info"><div class="stat-label">Lượt truy cập hôm nay</div><div class="stat-value" style="color:var(--green)"><%= stats.todayVisits || 0 %></div></div><div class="stat-icon-wrap green"><i class="fas fa-calendar-check"></i></div></div>
    </div>

    <div style="display:flex;gap:12px;margin-bottom:16px;flex-wrap:wrap;">
      <input class="gifts-search" id="visitsSearchInput" placeholder="Tìm IP, user-agent, session code..." style="flex:1;min-width:260px;">
    </div>

    <div style="background:var(--card);border:1px solid var(--border);border-radius:10px;overflow:hidden;">
      <% if (visitsList && visitsList.length > 0) { %>
      <table style="width:100%;border-collapse:collapse;">
        <thead>
          <tr style="background:var(--bg4);border-bottom:1px solid var(--border);">
            <th style="padding:12px 16px;text-align:left;font-weight:600;color:var(--text2);font-size:13px;">Thời gian</th>
            <th style="padding:12px 16px;text-align:left;font-weight:600;color:var(--text2);font-size:13px;">IP</th>
            <th style="padding:12px 16px;text-align:left;font-weight:600;color:var(--text2);font-size:13px;">Session</th>
            <th style="padding:12px 16px;text-align:left;font-weight:600;color:var(--text2);font-size:13px;">Path</th>
            <th style="padding:12px 16px;text-align:left;font-weight:600;color:var(--text2);font-size:13px;">User-Agent</th>
          </tr>
        </thead>
        <tbody id="visitsTableBody">
          <% visitsList.forEach(function(v) { const detail = v.details || {}; %>
          <tr class="visit-row"
              data-ip="<%= v.ip_address || '' %>"
              data-agent="<%= v.user_agent || '' %>"
              data-session="<%= v.session_code || '' %>"
              data-path="<%= detail.path || '' %>"
              style="border-bottom:1px solid var(--border);">
            <td style="padding:12px 16px;color:var(--text2);font-size:12px;"><%= new Date(v.created_at || v.createdAt).toLocaleString('vi-VN') %></td>
            <td style="padding:12px 16px;color:var(--blue);font-weight:700;"><%= v.ip_address || 'unknown' %></td>
            <td style="padding:12px 16px;color:var(--text);font-size:12px;"><%= v.session_code || '-' %></td>
            <td style="padding:12px 16px;color:var(--text2);font-size:12px;"><%= (detail.path || '/').toString().slice(0, 60) %></td>
            <td style="padding:12px 16px;color:var(--text3);font-size:12px;max-width:420px;word-break:break-word;"><%= (v.user_agent || 'N/A').toString().slice(0, 180) %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      <div class="pagination-wrap" id="visitsPagination" style="margin: 12px 16px 16px 16px;"></div>
      <% } else { %>
      <div class="empty-state" style="padding:60px 20px;text-align:center;">
        <i class="fas fa-globe" style="font-size:48px;color:var(--text3);margin-bottom:12px;display:block;"></i>
        <h3 style="margin:0 0 8px 0;color:var(--text);">Chưa có dữ liệu IP truy cập</h3>
        <p style="margin:0;color:var(--text3);font-size:13px;">Hệ thống sẽ tự động lưu khi có máy truy cập website.</p>
      </div>
      <% } %>
    </div>
  </div>

  

