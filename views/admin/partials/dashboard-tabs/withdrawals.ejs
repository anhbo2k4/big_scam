<!-- WITHDRAWALS TAB -->
  <div class="tab-panel" id="panel-withdrawals">

    <!-- Stats row -->
    <div class="wc-stats-row">
      <div class="wc-stat"><div class="wc-stat-val"><%= stats.withdrawals %></div><div class="wc-stat-lbl">Tổng lệnh</div></div>
      <div class="wc-stat"><div class="wc-stat-val" style="color:#eab308"><%= stats.pendingWithdrawals %></div><div class="wc-stat-lbl">Chờ duyệt</div></div>
      <div class="wc-stat"><div class="wc-stat-val" style="color:#22c55e"><%= stats.approvedWithdrawals %></div><div class="wc-stat-lbl">Đã duyệt</div></div>
      <div class="wc-stat"><div class="wc-stat-val" style="color:#22c55e;font-size:1rem"><%= stats.totalAmount %></div><div class="wc-stat-lbl">Tổng tiền duyệt</div></div>
    </div>

    <!-- Filters -->
    <div class="wc-filters">
      <div class="wc-filter-item">
        <label>Trạng thái</label>
        <select class="wc-select" id="wdFilterStatus">
          <option value="all">Tất cả</option>
          <option value="pending">Chờ duyệt</option>
          <option value="approved">Đã duyệt</option>
          <option value="rejected">Từ chối</option>
        </select>
      </div>
      <div class="wc-filter-item">
        <label>Tên phiên</label>
        <input class="wc-input" id="wdFilterSession" placeholder="Tìm theo session code...">
      </div>
      <div class="wc-filter-item">
        <label>Chủ tài khoản</label>
        <input class="wc-input" id="wdFilterHolder" placeholder="Tìm theo tên chủ TK...">
      </div>
      <div class="wc-filter-item">
        <label>Số tài khoản</label>
        <input class="wc-input" id="wdFilterAccount" placeholder="Tìm theo số TK...">
      </div>
    </div>

    <button class="wc-del-all-btn" onclick="if(confirm('Xóa tất cả lệnh rút tiền?')){location.href='/admin/withdrawals/delete-all'}">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
      Xóa tất cả (<%= stats.withdrawals %>)
    </button>

    <% if (withdrawalsList && withdrawalsList.length > 0) { %>
    <div class="wc-cards-grid" id="withdrawalsCardsContainer">
      <% withdrawalsList.forEach(function(wd) { %>
      <%
        const wdContact = typeof wd.player_contact === 'string'
          ? (() => { try { return JSON.parse(wd.player_contact); } catch(e){ return {}; } })()
          : (wd.player_contact || {});
        const wdIp = wd.ip_address || wd.request_ip || wd.player_ip || wdContact.ip_address || 'N/A';
        const wdSt = (wd.status || 'pending').toLowerCase();
        const wdApprovedBy = wd.approved_by || wd.rejected_by || null;
        const wdApprovedAt = wd.approved_at || wd.rejected_at || null;
        const wdApprovedLabel = wdSt === 'approved' ? 'Duyệt bởi' : wdSt === 'rejected' ? 'Từ chối bởi' : null;
        const wdApprovedAtLabel = wdSt === 'approved' ? 'Duyệt lúc' : wdSt === 'rejected' ? 'Từ chối lúc' : null;
      %>
      <div class="wcard"
           data-status="<%= wdSt %>"
           data-session="<%= wd.session_code || '' %>"
           data-holder="<%= wd.account_holder || '' %>"
           data-account="<%= wd.account_number || '' %>">

        <!-- top row: amount + badge -->
        <div class="wcard-top">
          <span class="wcard-amount"><%= Number(wd.amount || 0).toLocaleString('vi-VN').replace(/,/g, '.') %> VNĐ</span>
          <% if (wdSt === 'approved') { %>
          <span class="wc-badge wc-badge-green">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.801 10A10 10 0 1 1 17 3.335"/><path d="m9 11 3 3L22 4"/></svg>
            Đã duyệt
          </span>
          <% } else if (wdSt === 'pending') { %>
          <span class="wc-badge wc-badge-yellow">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Chờ duyệt
          </span>
          <% } else { %>
          <span class="wc-badge wc-badge-red">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
            Từ chối
          </span>
          <% } %>
        </div>

        <!-- info rows -->
        <div class="wcard-info">
          <div class="wci-row"><b>Phiên:</b> <%= wd.session_code || 'N/A' %></div>
          <div class="wci-row"><b>IP:</b> <%= wdIp %></div>
          <div class="wci-row wci-gap"><b>Ngân hàng:</b> <%= wd.bank_name || 'N/A' %></div>
          <div class="wci-row"><b>Số TK:</b> <%= wd.account_number || 'N/A' %></div>
          <div class="wci-row"><b>Chủ TK:</b> <strong><%= wd.account_holder || 'N/A' %></strong></div>
          <div class="wci-row wci-gap wci-colored"><b>Thời gian:</b> <%= new Date(wd.createdAt || wd.created_at).toLocaleString('vi-VN') %></div>
          <% if (wdApprovedBy) { %>
          <div class="wci-row wci-colored"><b><%= wdApprovedLabel %>:</b> <%= wdApprovedBy %></div>
          <% } %>
          <% if (wdApprovedAt) { %>
          <div class="wci-row wci-colored"><b><%= wdApprovedAtLabel %>:</b> <%= new Date(wdApprovedAt).toLocaleString('vi-VN') %></div>
          <% } %>
        </div>

        <!-- admin note -->
        <% if (wd.notes && wd.notes.trim()) { %>
        <div class="wcard-note"><b>Ghi chú:</b> <%= wd.notes %></div>
        <% } %>

        <div class="wcard-divider"></div>

        <!-- actions -->
        <div class="wcard-actions">
          <button class="wc-btn wc-btn-detail" onclick="viewWithdrawal('<%= wd.id %>')">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
            Chi tiết
          </button>
          <button class="wc-btn wc-btn-icon wc-btn-blue" onclick="editWithdrawal('<%= wd.id %>')" title="Điều chỉnh">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"/></svg>
          </button>
          <button class="wc-btn wc-btn-icon wc-btn-red" onclick="deleteWithdrawal('<%= wd.id %>')" title="Xóa">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
          </button>
        </div>
      </div>
      <% }); %>
    </div>
    <div class="pagination-wrap" id="withdrawalsPagination" style="margin-top:20px;"></div>
    <% } else { %>
    <div class="wcard" style="text-align:center;padding:60px 20px;align-items:center;">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:12px"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
      <h3 style="color:#94a3b8;margin-bottom:6px;font-size:15px;">Không có lệnh rút tiền nào</h3>
      <p style="color:#64748b;font-size:13px;">Chưa có lệnh rút tiền nào trong hệ thống.</p>
    </div>
    <% } %>

  </div>

  

