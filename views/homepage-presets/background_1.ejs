<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Mở Hộp Quà</title>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;900&family=DM+Mono:wght@400;500&display=swap" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;900&family=DM+Mono:wght@400;500&display=swap"></noscript>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    html,body{height:100%;}
    body{background:#020408;overflow:hidden;font-family:'Outfit',sans-serif;}
    #root{height:100%;}

    /* ── Viewport ── */
    .min-h-screen{
      min-height:100vh;position:relative;overflow:hidden;
      display:flex;align-items:center;justify-content:center;padding:1rem;
    }

    /* ── Base gradient ── */
    .overlay-gradient{
      position:absolute;inset:0;
      background-image:linear-gradient(to top right,var(--tw-gradient-stops));
      --tw-gradient-from:rgb(30 27 75/.8);
      --tw-gradient-via:rgb(46 16 101/.6);
      --tw-gradient-to:rgb(2 6 23/.9);
      --tw-gradient-stops:var(--tw-gradient-from),var(--tw-gradient-via),var(--tw-gradient-to);
    }

    /* ── Orbs ── */
    .orb{position:absolute;border-radius:50%;filter:blur(90px);opacity:.28;pointer-events:none;
      animation:orb-drift var(--dur) ease-in-out infinite alternate;animation-delay:var(--delay,0s);}
    .orb1{width:520px;height:520px;background:radial-gradient(circle,#6d28d9,transparent 70%);top:-140px;left:-100px;--dur:14s;}
    .orb2{width:400px;height:400px;background:radial-gradient(circle,#4f46e5,transparent 70%);bottom:-80px;right:40px;--dur:18s;--delay:-6s;}
    .orb3{width:260px;height:260px;background:radial-gradient(circle,#7c3aed,transparent 70%);top:50%;left:50%;transform:translate(-50%,-50%);--dur:10s;--delay:-3s;}

    .blobs{position:absolute;inset:0;pointer-events:none;}
    .blob{position:absolute;border-radius:50%;animation:blob-float var(--bd) ease-in-out infinite alternate;animation-delay:var(--bdelay,0s);}

    .grid-lines{position:absolute;inset:0;pointer-events:none;
      background-image:linear-gradient(rgba(139,92,246,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(139,92,246,.05) 1px,transparent 1px);
      background-size:56px 56px;}

    .stars{position:absolute;inset:0;pointer-events:none;}
    .star{position:absolute;border-radius:50%;background:#fff;
      animation:twinkle var(--d) ease-in-out infinite alternate;animation-delay:var(--sd,0s);opacity:var(--o);}

    .shapes{position:absolute;inset:0;pointer-events:none;overflow:hidden;}
    .shape{position:absolute;
      animation:shape-float var(--sf-dur) ease-in-out infinite alternate;
      animation-delay:var(--s-delay,0s);opacity:var(--s-op,.55);
      filter:drop-shadow(0 0 5px var(--s-color,rgba(167,139,250,.5)));}

    .noise{position:absolute;inset:0;pointer-events:none;opacity:.13;
      background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.05'/%3E%3C/svg%3E");}

    /* ════════════════════════════════════
       CARD — Refined Purple
    ════════════════════════════════════ */
    .card-wrapper{
      position:relative;z-index:10;
      width:100%;max-width:30rem;
      animation:reveal 1s cubic-bezier(.16,1,.3,1) both;
    }
    @keyframes reveal{
      from{opacity:0;transform:translateY(28px) scale(.95);}
      to  {opacity:1;transform:translateY(0)    scale(1);}
    }
    @keyframes fade-in{from{opacity:0}to{opacity:1}}

    /* Outer glow halo */
    .card-halo{
      position:absolute;inset:-1px;border-radius:22px;
      background:linear-gradient(135deg,rgba(139,92,246,.35) 0%,rgba(99,102,241,.2) 50%,rgba(139,92,246,.35) 100%);
      filter:blur(1px);z-index:0;
      animation:halo-shift 6s ease-in-out infinite alternate;
    }
    @keyframes halo-shift{
      from{opacity:.6;transform:scale(1);}
      to  {opacity:1; transform:scale(1.005);}
    }

    .card{
      position:relative;z-index:1;
      background:
        radial-gradient(ellipse at 15% 0%,rgba(88,28,135,.5) 0%,transparent 50%),
        radial-gradient(ellipse at 85% 100%,rgba(49,46,129,.4) 0%,transparent 50%),
        linear-gradient(170deg,rgba(8,6,20,.97) 0%,rgba(14,8,36,.97) 60%,rgba(6,4,16,.98) 100%);
      border-radius:20px;
      overflow:hidden;
    }

    /* ── Running light on top edge ── */
    .edge-light{
      height:1px;
      background:linear-gradient(90deg,transparent 0%,rgba(167,139,250,.8) 30%,rgba(192,132,252,.9) 50%,rgba(167,139,250,.8) 70%,transparent 100%);
      background-size:300% 100%;
      animation:edge-run 3s ease-in-out infinite;
    }
    @keyframes edge-run{
      0%  {background-position:100% 0;opacity:.4;}
      50% {background-position:0%   0;opacity:1;}
      100%{background-position:100% 0;opacity:.4;}
    }

    /* ── Header ── */
    .card-header{
      padding:32px 28px 26px;
      position:relative;
      background:
        radial-gradient(ellipse at 50% -20%,rgba(109,40,217,.3) 0%,transparent 65%);
    }
    /* Dots pattern */
    .card-header::before{
      content:'';position:absolute;inset:0;pointer-events:none;
      background-image:radial-gradient(circle,rgba(139,92,246,.09) 1px,transparent 0);
      background-size:20px 20px;
      mask-image:radial-gradient(ellipse at 50% 0%,black 30%,transparent 75%);
    }
    /* Bottom fade line */
    .card-header::after{
      content:'';position:absolute;bottom:0;left:10%;right:10%;height:1px;
      background:linear-gradient(90deg,transparent,rgba(139,92,246,.3),rgba(99,102,241,.2),rgba(139,92,246,.3),transparent);
    }

    /* Icon block — offset left, not centered */
    .icon-row{
      display:flex;align-items:flex-end;gap:18px;margin-bottom:18px;
    }
    .icon-block{
      position:relative;flex-shrink:0;
      width:72px;height:72px;
    }
    /* Soft radial behind icon */
    .icon-block::before{
      content:'';position:absolute;inset:-20px;
      background:radial-gradient(circle,rgba(139,92,246,.35),transparent 65%);
      border-radius:50%;filter:blur(8px);
      animation:icon-pulse 3s ease-in-out infinite alternate;
    }
    @keyframes icon-pulse{from{opacity:.5;transform:scale(.9)}to{opacity:1;transform:scale(1.1)}}
    .icon-gem{
      width:72px;height:72px;
      background:linear-gradient(145deg,#581c87,#4c1d95,#312e81);
      border-radius:16px;
      display:flex;align-items:center;justify-content:center;
      position:relative;z-index:1;
      box-shadow:0 8px 24px rgba(88,28,135,.6),0 0 0 1px rgba(167,139,250,.15),inset 0 1px 0 rgba(255,255,255,.12);
      transition:transform .4s cubic-bezier(.34,1.56,.64,1),box-shadow .4s;
    }
    .icon-gem:hover{transform:scale(1.08) rotate(-3deg);box-shadow:0 14px 36px rgba(88,28,135,.8),0 0 0 1px rgba(167,139,250,.25),inset 0 1px 0 rgba(255,255,255,.15);}
    .icon-gem svg{width:32px;height:32px;color:#f5d0fe;}
    /* Small floating badge */
    .icon-badge{
      position:absolute;top:-6px;right:-6px;z-index:2;
      width:18px;height:18px;border-radius:50%;
      background:linear-gradient(135deg,#a855f7,#7c3aed);
      display:flex;align-items:center;justify-content:center;
      box-shadow:0 0 0 2px rgba(8,6,20,.97),0 0 10px rgba(168,85,247,.6);
      font-size:9px;
      animation:badge-pop 2s ease-in-out infinite alternate;
    }
    @keyframes badge-pop{from{transform:scale(1)}to{transform:scale(1.15)}}

    /* Right side of icon row — label stack */
    .label-stack{padding-bottom:4px;}
    .eyebrow{
      font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;
      color:rgba(167,139,250,.45);margin-bottom:6px;
    }
    .card-title{
      font-size:clamp(1.55rem,4vw,2rem);font-weight:900;line-height:1;
      letter-spacing:-.035em;
      /* Split color trick — top half lighter */
      background:linear-gradient(175deg,#f5f3ff 0%,#e9d5ff 30%,#c084fc 65%,#9333ea 100%);
      -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
      filter:drop-shadow(0 2px 16px rgba(139,92,246,.5));
    }

    .card-subtitle{
      font-size:13px;font-weight:400;line-height:1.7;
      color:rgba(196,181,253,.5);margin-top:10px;
      max-width:280px;
    }

    /* ── Body ── */
    .card-body{padding:22px 28px 26px;}

    /* Input */
    .field-label{
      display:flex;align-items:center;justify-content:space-between;
      margin-bottom:8px;
    }
    .field-label-text{
      font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;
      color:rgba(139,92,246,.55);
    }
    .field-label-hint{font-size:10px;color:rgba(139,92,246,.3);}

    .input-wrap{position:relative;margin-bottom:14px;}
    .input-glow{position:absolute;inset:-1px;border-radius:11px;
      background:linear-gradient(135deg,rgba(139,92,246,.3),rgba(99,102,241,.3));
      opacity:0;transition:opacity .3s;pointer-events:none;filter:blur(3px);}
    .input-wrap:focus-within .input-glow{opacity:1;}

    .card-input{
      width:100%;height:54px;
      background:rgba(10,6,28,.8);
      border:1px solid rgba(139,92,246,.2);
      border-radius:10px;
      font-family:'DM Mono','Courier New',monospace;
      font-size:21px;font-weight:500;
      letter-spacing:.3em;text-transform:uppercase;
      color:#e9d5ff;text-align:center;
      padding:0 16px;outline:none;
      transition:border-color .3s,box-shadow .3s,background .3s;
      position:relative;z-index:1;caret-color:#c084fc;
    }
    .card-input::placeholder{
      color:rgba(139,92,246,.2);
      font-size:11px;letter-spacing:.2em;font-weight:400;
    }
    .card-input:focus{
      border-color:rgba(139,92,246,.5);
      background:rgba(15,8,38,.9);
      box-shadow:0 0 0 3px rgba(109,40,217,.12),inset 0 1px 0 rgba(255,255,255,.03);
    }

    /* Button */
    .card-btn{
      width:100%;height:48px;
      background:linear-gradient(135deg,rgba(109,40,217,.85),rgba(79,70,229,.85));
      border:1px solid rgba(167,139,250,.18);
      border-radius:10px;
      color:#f5f3ff;font-family:'Outfit',sans-serif;
      font-size:14px;font-weight:700;letter-spacing:.03em;
      cursor:pointer;position:relative;overflow:hidden;
      box-shadow:0 8px 28px rgba(88,28,135,.4),inset 0 1px 0 rgba(255,255,255,.08);
      transition:all .3s cubic-bezier(.4,0,.2,1);
      display:flex;align-items:center;justify-content:center;gap:8px;
    }
    /* Shimmer sweep */
    .card-btn::after{
      content:'';position:absolute;top:0;left:-100%;width:60%;height:100%;
      background:linear-gradient(90deg,transparent,rgba(255,255,255,.08),transparent);
      transition:left .6s;
    }
    .card-btn:hover::after{left:140%;}
    .card-btn:hover{
      transform:translateY(-2px);
      box-shadow:0 14px 40px rgba(88,28,135,.6),inset 0 1px 0 rgba(255,255,255,.12);
      border-color:rgba(167,139,250,.3);
    }
    .card-btn:active{transform:translateY(0) scale(.99);}
    .card-btn:disabled{
      opacity:.28;cursor:not-allowed;transform:none;
      box-shadow:0 4px 12px rgba(88,28,135,.2);
    }

    /* ── Separator ── */
    .sep{
      display:flex;align-items:center;gap:10px;
      margin:20px 0 18px;
      font-size:9px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;
      color:rgba(139,92,246,.25);
    }
    .sep::before,.sep::after{content:'';flex:1;height:1px;background:rgba(139,92,246,.1);}

    /* ── Tier cards ── */
    .tier-row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;}
    .tier{
      padding:13px 8px 11px;border-radius:10px;text-align:center;
      border:1px solid transparent;position:relative;overflow:hidden;
      transition:transform .2s cubic-bezier(.34,1.56,.64,1),border-color .2s;
      cursor:default;
    }
    /* top line accent per tier */
    .tier::before{
      content:'';position:absolute;top:0;left:15%;right:15%;height:1px;
      background:var(--tier-line);
      opacity:.6;
    }
    .tier:hover{transform:translateY(-4px);}
    .tier-icon{font-size:22px;display:block;margin-bottom:5px;line-height:1;}
    .tier-name{
      font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
      color:var(--tier-color);
    }
    .tier-desc{font-size:9px;margin-top:3px;color:rgba(255,255,255,.25);letter-spacing:.04em;}

    .tier-gold{
      background:linear-gradient(160deg,rgba(120,53,15,.22),rgba(120,53,15,.08));
      border-color:rgba(251,191,36,.12);
      --tier-line:rgba(251,191,36,.5);--tier-color:#fbbf24;
    }
    .tier-gold:hover{border-color:rgba(251,191,36,.25);box-shadow:0 8px 24px rgba(180,83,9,.15);}
    .tier-blue{
      background:linear-gradient(160deg,rgba(30,58,138,.22),rgba(30,58,138,.08));
      border-color:rgba(96,165,250,.12);
      --tier-line:rgba(96,165,250,.5);--tier-color:#60a5fa;
    }
    .tier-blue:hover{border-color:rgba(96,165,250,.25);box-shadow:0 8px 24px rgba(37,99,235,.12);}
    .tier-gray{
      background:linear-gradient(160deg,rgba(30,27,75,.25),rgba(30,27,75,.1));
      border-color:rgba(139,92,246,.08);
      --tier-line:rgba(139,92,246,.3);--tier-color:rgba(167,139,250,.5);
    }
    .tier-gray:hover{border-color:rgba(139,92,246,.2);}

    /* ── Footer ── */
    .card-foot{
      text-align:center;margin-top:16px;
      animation:fade-in .8s .7s ease-out both;
    }
    .foot-inner{
      display:inline-flex;align-items:center;gap:10px;
      background:rgba(6,4,16,.7);
      border:1px solid rgba(139,92,246,.1);
      border-radius:99px;padding:8px 20px;
      backdrop-filter:blur(12px);
    }
    .foot-dot{
      width:5px;height:5px;border-radius:50%;background:rgba(139,92,246,.6);
      box-shadow:0 0 8px rgba(139,92,246,.5);
      animation:dot-pulse 2.4s ease-in-out infinite alternate;
    }
    @keyframes dot-pulse{from{opacity:.3;transform:scale(.8)}to{opacity:1;transform:scale(1)}}
    .foot-text{
      font-size:11px;font-weight:400;letter-spacing:.04em;
      color:rgba(167,139,250,.4);
    }

    /* ── BG Keyframes ── */
    @keyframes orb-drift{from{transform:translate(0,0) scale(1)}to{transform:translate(38px,26px) scale(1.1)}}
    @keyframes blob-float{from{transform:translate(0,0)}to{transform:translate(var(--bx,20px),var(--by,-30px))}}
    @keyframes twinkle{from{opacity:var(--o);transform:scale(1)}to{opacity:calc(var(--o)*.2);transform:scale(.5)}}
    @keyframes shape-float{0%{transform:translateY(0) rotate(var(--r0,0deg))}100%{transform:translateY(var(--float-y,-24px)) rotate(var(--r1,15deg))}}
  </style>
</head>
<body>
<div id="root">
  <div class="min-h-screen">

    <div class="overlay-gradient"></div>
    <div class="orb orb1"></div>
    <div class="orb orb2"></div>
    <div class="orb orb3"></div>
    <div class="blobs" id="blobs"></div>
    <div class="grid-lines"></div>
    <div class="stars" id="stars"></div>
    <div class="shapes" id="shapes"></div>
    <div class="noise"></div>

    <!-- ✅ div.max-w-lg.w-full.relative.z-10.animate-scale-in-smooth -->
    <div class="card-wrapper">
      <div class="card-halo"></div>

      <div class="card">
        <div class="edge-light"></div>

        <!-- Header — icon floats left, text right -->
        <div class="card-header">
          <div class="icon-row">
            <div class="icon-block">
              <div class="icon-gem">
                <!-- Gift icon -->
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="8" width="18" height="4" rx="1"/>
                  <path d="M12 8v13"/>
                  <path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/>
                  <path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/>
                </svg>
              </div>
              <div class="icon-badge">✦</div>
            </div>

            <div class="label-stack">
              <div class="eyebrow">Phần thưởng bí ẩn</div>
              <div class="card-title">Mở Hộp Quà</div>
            </div>
          </div>

          <div class="card-subtitle">
            Một mã phiên — một vận may. Chọn hộp quà và khám phá điều đang chờ bạn bên trong.
          </div>
        </div>

        <!-- Body -->
        <div class="card-body">
          <div class="field-label">
            <span class="field-label-text">Mã phiên chơi</span>
            <span class="field-label-hint">tối đa 8 ký tự</span>
          </div>
          <div class="input-wrap">
            <div class="input-glow"></div>
            <input class="card-input" id="sessionCode" type="text"
              placeholder="· · · · · · · ·"
              maxlength="8" autocomplete="off" spellcheck="false"/>
          </div>

          <button class="card-btn" id="startBtn" type="button" disabled onclick="handleStart()">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="6 3 20 12 6 21 6 3"/></svg>
            Bắt đầu chơi
          </button>

          <div class="sep"><span>phần thưởng khả dĩ</span></div>

          <div class="tier-row">
            <div class="tier tier-gold">
              <span class="tier-icon">👑</span>
              <div class="tier-name">VIP</div>
              <div class="tier-desc">Hiếm gặp</div>
            </div>
            <div class="tier tier-blue">
              <span class="tier-icon">🎉</span>
              <div class="tier-name">Lucky</div>
              <div class="tier-desc">Có thể gặp</div>
            </div>
            <div class="tier tier-gray">
              <span class="tier-icon">😅</span>
              <div class="tier-name">Thường</div>
              <div class="tier-desc">Thử lại thôi</div>
            </div>
          </div>
        </div>
      </div>

      <div class="card-foot">
        <div class="foot-inner">
          <div class="foot-dot"></div>
          <span class="foot-text">Sẵn sàng khám phá vận may của bạn?</span>
          <div class="foot-dot"></div>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
/* Stars */
(function () {
  var c = document.getElementById('stars');
  for (var i = 0; i < 80; i++) {
    var el = document.createElement('div');el.className = 'star';
    var sz = (Math.random() * 2 + .4).toFixed(1),o = (Math.random() * .45 + .08).toFixed(2);
    el.style.cssText = "width:".concat(sz, "px;height:").concat(sz, "px;top:").concat((Math.random() * 100).toFixed(2), "%;left:").concat((Math.random() * 100).toFixed(2), "%;--o:").concat(o, ";--d:").concat((Math.random() * 5 + 2).toFixed(1), "s;--sd:").concat((Math.random() * 8).toFixed(1), "s;");
    c.appendChild(el);
  }
})();

/* Blobs */
(function () {
  var c = document.getElementById('blobs');
  [{ w: 120, h: 44, top: 21, left: 41, blur: 18, color: 'rgba(96,165,250,.18)', bd: 8, bx: '15px', by: '-20px' },
  { w: 90, h: 34, top: 44, left: 31, blur: 14, color: 'rgba(139,92,246,.24)', bd: 11, bx: '-10px', by: '-25px' },
  { w: 180, h: 65, top: 66, left: 24, blur: 22, color: 'rgba(139,92,246,.18)', bd: 13, bx: '-18px', by: '-28px' },
  { w: 140, h: 52, top: 72, left: 46, blur: 18, color: 'rgba(96,165,250,.14)', bd: 10, bx: '12px', by: '-22px' },
  { w: 220, h: 78, top: 63, left: 58, blur: 24, color: 'rgba(139,92,246,.14)', bd: 14, bx: '18px', by: '-28px' },
  { w: 95, h: 35, top: 18, left: 79, blur: 14, color: 'rgba(167,139,250,.16)', bd: 9, bx: '-12px', by: '-20px' }].
  forEach(function (cfg, i) {
    var el = document.createElement('div');el.className = 'blob';
    el.style.cssText = "width:".concat(cfg.w, "px;height:").concat(cfg.h, "px;top:").concat(cfg.top, "%;left:").concat(cfg.left, "%;background:").concat(cfg.color, ";filter:blur(").concat(cfg.blur, "px);--bd:").concat(cfg.bd, "s;--bdelay:").concat(-(i * 1.3).toFixed(1), "s;--bx:").concat(cfg.bx, ";--by:").concat(cfg.by, ";");
    c.appendChild(el);
  });
})();

/* Shapes */
(function () {
  var ct = document.getElementById('shapes');
  var colors = ['#a78bfa', '#818cf8', '#c4b5fd', '#7dd3fc', '#93c5fd', '#ddd6fe', '#e879f9', '#f9a8d4', '#6ee7b7'];
  var defs = {
