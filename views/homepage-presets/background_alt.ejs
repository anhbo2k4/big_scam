<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Mở Hộp Quà — Alt</title>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Inter:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Inter:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap"></noscript>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    html,body{height:100%;}
    body{background:#020408;overflow:hidden;}
    #root{height:100%;}

    .scene{
      min-height:100vh;position:relative;overflow:hidden;
      display:flex;align-items:center;justify-content:center;padding:1.5rem;
    }

    /* ── Background ── */
    .bg-grad{
      position:absolute;inset:0;
      background:linear-gradient(to top right,
        rgb(30 27 75/.85),
        rgb(46 16 101/.65),
        rgb(2 6 23/.92));
    }
    .orb{position:absolute;border-radius:50%;filter:blur(100px);pointer-events:none;
      animation:orb-f var(--d) ease-in-out infinite alternate;animation-delay:var(--dl,0s);}
    .o1{width:500px;height:500px;background:radial-gradient(circle,rgba(124,58,237,.5),transparent 70%);top:-120px;left:-80px;opacity:.35;--d:15s;}
    .o2{width:380px;height:380px;background:radial-gradient(circle,rgba(99,102,241,.45),transparent 70%);bottom:-60px;right:30px;opacity:.3;--d:19s;--dl:-7s;}
    .o3{width:220px;height:220px;background:radial-gradient(circle,rgba(168,85,247,.5),transparent 70%);top:35%;right:20%;opacity:.25;--d:11s;--dl:-3s;}
    @keyframes orb-f{from{transform:translate(0,0)}to{transform:translate(32px,22px)}}

    .blobs{position:absolute;inset:0;pointer-events:none;}
    .blob{position:absolute;border-radius:50%;
      animation:blob-f var(--bd) ease-in-out infinite alternate;animation-delay:var(--bdelay,0s);}
    @keyframes blob-f{from{transform:translate(0,0)}to{transform:translate(var(--bx,0),var(--by,0))}}

    .grid{position:absolute;inset:0;pointer-events:none;
      background-image:linear-gradient(rgba(139,92,246,.04) 1px,transparent 1px),
        linear-gradient(90deg,rgba(139,92,246,.04) 1px,transparent 1px);
      background-size:52px 52px;}

    .stars{position:absolute;inset:0;pointer-events:none;}
    .star{position:absolute;border-radius:50%;background:#fff;
      animation:twinkle var(--d) ease-in-out infinite alternate;animation-delay:var(--sd,0s);opacity:var(--o);}
    @keyframes twinkle{from{opacity:var(--o);transform:scale(1)}to{opacity:calc(var(--o)*.2);transform:scale(.5)}}

    .shapes{position:absolute;inset:0;pointer-events:none;overflow:hidden;}
    .shape{position:absolute;
      animation:sf var(--sf) ease-in-out infinite alternate;animation-delay:var(--sd2,0s);
      opacity:var(--so,.5);filter:drop-shadow(0 0 5px var(--sc,rgba(167,139,250,.4)));}
    @keyframes sf{0%{transform:translateY(0) rotate(var(--r0,0deg))}100%{transform:translateY(var(--fy,-20px)) rotate(var(--r1,10deg))}}

    .noise{position:absolute;inset:0;pointer-events:none;opacity:.12;
      background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.05'/%3E%3C/svg%3E");}

    /* ════════════════════════════
       CARD — Editorial Luxury
    ════════════════════════════ */
    .card-wrap{
      position:relative;z-index:10;
      width:100%;max-width:28rem;
      animation:rise 1.2s cubic-bezier(.16,1,.3,1) both;
    }
    @keyframes rise{from{opacity:0;transform:translateY(40px)}to{opacity:1;transform:translateY(0)}}
    @keyframes fade{from{opacity:0}to{opacity:1}}

    /* Big number — decorative behind card */
    .deco-num{
      position:absolute;
      top:-28px;right:8px;
      font-family:'Cormorant Garamond',serif;
      font-size:110px;font-weight:300;
      color:rgba(139,92,246,.07);
      line-height:1;pointer-events:none;
      user-select:none;letter-spacing:-.04em;
    }

    /* Card itself */
    .card{
      background:rgba(12,8,28,.85);
      backdrop-filter:blur(24px);
      border:1px solid rgba(139,92,246,.18);
      border-radius:3px;
      overflow:visible;
      position:relative;
      box-shadow:
        0 2px 0 rgba(168,85,247,.25),
        0 32px 64px rgba(0,0,0,.8),
        0 0 80px rgba(109,40,217,.12);
      transition:box-shadow .5s;
    }
    .card:hover{
      box-shadow:
        0 2px 0 rgba(168,85,247,.45),
        0 40px 80px rgba(0,0,0,.85),
        0 0 100px rgba(109,40,217,.18);
    }

    /* Left accent bar */
    .card::before{
      content:'';position:absolute;
      left:-1px;top:10%;bottom:10%;width:2px;
      background:linear-gradient(180deg,transparent,#a855f7,#818cf8,transparent);
      border-radius:0 2px 2px 0;
    }

    /* ── Header ── */
    .ch{
      padding:28px 28px 22px 32px;
      border-bottom:1px solid rgba(139,92,246,.1);
      position:relative;
    }
    /* Subtle dot pattern right side */
    .ch::after{
      content:'';position:absolute;
      top:0;right:0;bottom:0;width:40%;
      background-image:radial-gradient(circle,rgba(139,92,246,.08) 1px,transparent 0);
      background-size:16px 16px;
      mask-image:linear-gradient(90deg,transparent,black);
      pointer-events:none;
    }

    /* Roman numeral running counter */
    .ch-num{
      font-family:'Cormorant Garamond',serif;
      font-size:11px;font-weight:400;font-style:italic;
      letter-spacing:.12em;
      color:rgba(168,85,247,.5);
      margin-bottom:12px;
      display:flex;align-items:center;gap:8px;
    }
    .ch-num::after{content:'';flex:1;max-width:40px;height:1px;background:rgba(168,85,247,.25);}

    .ch-title{
      font-family:'Cormorant Garamond',serif;
      font-size:clamp(2rem,5vw,2.6rem);
      font-weight:600;line-height:1.05;
      color:#f5f3ff;
      letter-spacing:-.01em;
      margin-bottom:4px;
    }
    .ch-title em{
      font-style:italic;font-weight:300;
      color:#d8b4fe;
    }
    .ch-sub{
      font-family:'Inter',sans-serif;
      font-size:12px;font-weight:300;
      color:rgba(196,181,253,.45);
      line-height:1.65;margin-top:10px;
      max-width:240px;
    }

    /* Vertical divider + icon to the right */
    .ch-aside{
      position:absolute;top:24px;right:24px;
      display:flex;flex-direction:column;align-items:center;gap:6px;
    }
    .aside-icon{
      width:42px;height:42px;
      border:1px solid rgba(168,85,247,.25);
      border-radius:50%;
      display:flex;align-items:center;justify-content:center;
      background:radial-gradient(circle at 40% 35%,rgba(168,85,247,.2),rgba(12,8,28,.8));
      box-shadow:0 0 20px rgba(168,85,247,.15),inset 0 1px 0 rgba(255,255,255,.06);
      transition:transform .35s cubic-bezier(.34,1.56,.64,1),box-shadow .35s;
    }
    .aside-icon:hover{transform:scale(1.12);box-shadow:0 0 32px rgba(168,85,247,.3),inset 0 1px 0 rgba(255,255,255,.1);}
    .aside-icon svg{width:18px;height:18px;color:rgba(216,180,254,.8);}
    .aside-dots{display:flex;flex-direction:column;gap:4px;align-items:center;}
    .aside-dot{width:3px;height:3px;border-radius:50%;background:rgba(168,85,247,.3);}
    .aside-dot:nth-child(2){background:rgba(168,85,247,.5);}
    .aside-dot:nth-child(3){background:rgba(168,85,247,.2);}

    /* ── Body ── */
    .cb{padding:22px 28px 24px 32px;}

    /* Input row */
    .inp-label{
      font-family:'Inter',sans-serif;
      font-size:10px;font-weight:500;letter-spacing:.15em;text-transform:uppercase;
      color:rgba(168,85,247,.55);
      margin-bottom:8px;display:flex;align-items:center;gap:6px;
    }
    .inp-label::before{content:'';width:4px;height:4px;border-radius:50%;background:rgba(168,85,247,.55);}

    .inp-wrap{position:relative;margin-bottom:14px;}
    .inp-glow{position:absolute;inset:-1px;border-radius:3px;
      background:linear-gradient(135deg,rgba(168,85,247,.3),rgba(129,140,248,.3));
      opacity:0;transition:opacity .3s;pointer-events:none;filter:blur(4px);}
    .inp-wrap:focus-within .inp-glow{opacity:1;}

    .card-input{
      width:100%;height:52px;
      background:rgba(6,3,16,.7);
      border:1px solid rgba(139,92,246,.22);
      border-radius:3px;
      font-family:'DM Mono',monospace;
      font-size:20px;font-weight:500;
      letter-spacing:.35em;text-transform:uppercase;
      color:#ede9fe;text-align:center;
      padding:0 14px;outline:none;
      transition:border-color .3s,box-shadow .3s;
      position:relative;z-index:1;
      caret-color:#c084fc;
    }
    .card-input::placeholder{
      color:rgba(139,92,246,.22);font-size:11px;
      letter-spacing:.15em;font-weight:400;
    }
    .card-input:focus{
      border-color:rgba(168,85,247,.55);
      box-shadow:0 0 0 3px rgba(139,92,246,.1);
    }

    /* Button — minimal, full-width text with arrow */
    .card-btn{
      width:100%;height:46px;
      background:transparent;
      border:1px solid rgba(139,92,246,.3);
      border-radius:3px;
      color:rgba(216,180,254,.8);
      font-family:'Inter',sans-serif;
      font-size:12px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;
      cursor:pointer;position:relative;overflow:hidden;
      transition:all .3s;
      display:flex;align-items:center;justify-content:space-between;
      padding:0 18px;
    }
    /* Fill on hover */
    .card-btn::before{
      content:'';position:absolute;inset:0;
      background:linear-gradient(135deg,rgba(109,40,217,.5),rgba(79,70,229,.45));
      opacity:0;transition:opacity .3s;
    }
    .card-btn:hover::before{opacity:1;}
    .card-btn:hover{border-color:rgba(139,92,246,.55);color:#f5f3ff;}
    .card-btn:active{transform:scale(.99);}
    .card-btn:disabled{opacity:.25;cursor:not-allowed;}
    .btn-label{position:relative;z-index:1;}
    .btn-arrow{
      position:relative;z-index:1;
      width:20px;height:1px;background:currentColor;
      transition:width .3s;
    }
    .btn-arrow::after{
      content:'';position:absolute;right:0;top:-3px;
      width:7px;height:7px;
      border-right:1px solid currentColor;
      border-top:1px solid currentColor;
      transform:rotate(45deg);
    }
    .card-btn:hover .btn-arrow{width:28px;}

    /* ── Tier section ── */
    .tier-head{
      display:flex;align-items:center;justify-content:space-between;
      margin:20px 0 12px;
    }
    .tier-head-label{
      font-family:'Cormorant Garamond',serif;
      font-size:13px;font-style:italic;font-weight:400;
      color:rgba(196,181,253,.45);letter-spacing:.06em;
    }
    .tier-head-line{flex:1;height:1px;background:rgba(139,92,246,.1);margin-left:10px;}

    /* Horizontal tier list — not grid, stacked rows */
    .tier-list{display:flex;flex-direction:column;gap:6px;}
    .tier-item{
      display:flex;align-items:center;gap:12px;
      padding:10px 14px;
      border-radius:3px;
      border:1px solid var(--ti-border);
      background:var(--ti-bg);
      position:relative;overflow:hidden;
      transition:transform .2s cubic-bezier(.34,1.56,.64,1),border-color .2s;
      cursor:default;
    }
    .tier-item::before{
      content:'';position:absolute;left:0;top:0;bottom:0;width:2px;
      background:var(--ti-accent);
    }
    .tier-item:hover{transform:translateX(4px);border-color:var(--ti-hover-border);}

    .ti-icon{font-size:18px;flex-shrink:0;line-height:1;filter:drop-shadow(0 2px 6px var(--ti-glow));}
    .ti-info{flex:1;}
    .ti-name{
      font-family:'Inter',sans-serif;
      font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;
      color:var(--ti-color);line-height:1;margin-bottom:3px;
    }
    .ti-desc{
      font-family:'Inter',sans-serif;
      font-size:10px;font-weight:300;
      color:rgba(196,181,253,.35);letter-spacing:.03em;
    }
    /* Prob pill — right side */
    .ti-prob{
      font-family:'DM Mono',monospace;
      font-size:10px;font-weight:500;
      color:var(--ti-color);
      background:var(--ti-pill);
      border:1px solid var(--ti-border);
      border-radius:2px;padding:3px 7px;
      letter-spacing:.06em;flex-shrink:0;
      opacity:.8;
    }

    /* VIP */
    .t-vip{
      --ti-bg:linear-gradient(90deg,rgba(120,53,15,.22),rgba(120,53,15,.06));
      --ti-border:rgba(251,191,36,.15);
      --ti-hover-border:rgba(251,191,36,.35);
      --ti-accent:linear-gradient(180deg,#f59e0b,#fcd34d);
      --ti-color:#fcd34d;
      --ti-glow:rgba(251,191,36,.35);
      --ti-pill:rgba(120,53,15,.4);
    }
    /* Lucky */
    .t-lucky{
      --ti-bg:linear-gradient(90deg,rgba(29,78,216,.2),rgba(29,78,216,.05));
      --ti-border:rgba(96,165,250,.15);
      --ti-hover-border:rgba(96,165,250,.35);
      --ti-accent:linear-gradient(180deg,#3b82f6,#7dd3fc);
      --ti-color:#93c5fd;
      --ti-glow:rgba(96,165,250,.35);
      --ti-pill:rgba(29,78,216,.35);
    }
    /* Common */
    .t-common{
      --ti-bg:linear-gradient(90deg,rgba(88,28,135,.2),rgba(88,28,135,.05));
      --ti-border:rgba(192,132,252,.12);
      --ti-hover-border:rgba(192,132,252,.3);
      --ti-accent:linear-gradient(180deg,#9333ea,#d8b4fe);
      --ti-color:#c4b5fd;
      --ti-glow:rgba(192,132,252,.3);
      --ti-pill:rgba(88,28,135,.35);
    }

    /* ── Footer ── */
    .cf{
      padding:14px 28px 18px 32px;
      border-top:1px solid rgba(139,92,246,.08);
      display:flex;align-items:center;justify-content:space-between;
    }
    .cf-left{
      font-family:'Cormorant Garamond',serif;
      font-size:11px;font-style:italic;color:rgba(168,85,247,.4);
      letter-spacing:.06em;
    }
    .cf-dots{display:flex;gap:5px;align-items:center;}
    .cf-dot{width:5px;height:5px;border-radius:50%;background:rgba(168,85,247,.3);}
    .cf-dot:nth-child(2){
      background:rgba(168,85,247,.6);
      box-shadow:0 0 6px rgba(168,85,247,.5);
      animation:dot-glow 2s ease-in-out infinite alternate;
    }
    .cf-dot:nth-child(3){background:rgba(168,85,247,.3);}
    @keyframes dot-glow{from{opacity:.4;transform:scale(.8)}to{opacity:1;transform:scale(1.2)}}
  </style>
</head>
<body>
<div id="root">
  <div class="scene">

    <div class="bg-grad"></div>
    <div class="orb o1"></div>
    <div class="orb o2"></div>
    <div class="orb o3"></div>
    <div class="blobs" id="blobs"></div>
    <div class="grid"></div>
    <div class="stars" id="stars"></div>
    <div class="shapes" id="shapes"></div>
    <div class="noise"></div>

    <div class="card-wrap">
      <!-- Decorative big number -->
      <div class="deco-num">VII</div>

      <div class="card">

        <!-- Header -->
        <div class="ch">
          <div class="ch-aside">
            <div class="aside-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="8" width="18" height="4" rx="1"/>
                <path d="M12 8v13"/>
                <path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/>
                <path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/>
              </svg>
            </div>
            <div class="aside-dots">
              <div class="aside-dot"></div>
              <div class="aside-dot"></div>
              <div class="aside-dot"></div>
            </div>
          </div>

          <div class="ch-num">Phiên thưởng &nbsp;·&nbsp; No. 7</div>
          <div class="ch-title">Mở<br><em>Hộp Quà</em></div>
          <div class="ch-sub">Nhập mã phiên để mở khóa và khám phá phần thưởng đang chờ bạn.</div>
        </div>

        <!-- Body -->
        <div class="cb">
          <div class="inp-label">Mã phiên chơi</div>
          <div class="inp-wrap">
            <div class="inp-glow"></div>
            <input class="card-input" id="sessionCode" type="text"
              placeholder="· · · · · · · ·"
              maxlength="8" autocomplete="off" spellcheck="false"/>
          </div>

          <button class="card-btn" id="startBtn" type="button" disabled onclick="handleStart()">
            <span class="btn-label">Bắt đầu chơi</span>
            <span class="btn-arrow"></span>
          </button>

          <!-- Tiers — horizontal list -->
          <div class="tier-head">
            <span class="tier-head-label">Phần thưởng khả dĩ</span>
            <div class="tier-head-line"></div>
          </div>

          <div class="tier-list">
            <div class="tier-item t-vip">
              <span class="ti-icon">👑</span>
              <div class="ti-info">
                <div class="ti-name">VIP</div>
                <div class="ti-desc">Phần thưởng cấp cao — cực hiếm gặp</div>
              </div>
              <span class="ti-prob">SSR · 18%</span>
            </div>
            <div class="tier-item t-lucky">
              <span class="ti-icon">🎉</span>
              <div class="ti-info">
                <div class="ti-name">Lucky</div>
                <div class="ti-desc">Phần thưởng may mắn — khả năng trung bình</div>
              </div>
              <span class="ti-prob">SR · 42%</span>
            </div>
            <div class="tier-item t-common">
              <span class="ti-icon">🌀</span>
              <div class="ti-info">
                <div class="ti-name">Thường</div>
                <div class="ti-desc">Phổ biến — hãy thử lại lần sau</div>
              </div>
              <span class="ti-prob">R · 72%</span>
            </div>
          </div>
        </div>

        <!-- Footer -->
        <div class="cf">
          <span class="cf-left">Vận may đang chờ bạn</span>
          <div class="cf-dots">
            <div class="cf-dot"></div>
            <div class="cf-dot"></div>
            <div class="cf-dot"></div>
          </div>
        </div>

      </div>
    </div>

  </div>
</div>

<script>
/* Stars */
(function () {
  var c = document.getElementById('stars');
  for (var i = 0; i < 80; i++) {
    var el = document.createElement('div');el.className = 'star';
    var sz = (Math.random() * 2 + .4).toFixed(1),o = (Math.random() * .4 + .08).toFixed(2);
    el.style.cssText = "width:".concat(sz, "px;height:").concat(sz, "px;top:").concat((Math.random() * 100).toFixed(2), "%;left:").concat((Math.random() * 100).toFixed(2), "%;--o:").concat(o, ";--d:").concat((Math.random() * 5 + 2).toFixed(1), "s;--sd:").concat((Math.random() * 8).toFixed(1), "s;");
    c.appendChild(el);
  }
})();

/* Blobs */
(function () {
  var c = document.getElementById('blobs');
  [{ w: 110, h: 40, top: 20, left: 40, blur: 16, color: 'rgba(96,165,250,.16)', bd: 8, bx: '14px', by: '-18px' },
  { w: 85, h: 32, top: 43, left: 30, blur: 13, color: 'rgba(139,92,246,.22)', bd: 11, bx: '-9px', by: '-22px' },
  { w: 170, h: 60, top: 65, left: 22, blur: 20, color: 'rgba(139,92,246,.16)', bd: 13, bx: '-16px', by: '-25px' },
  { w: 130, h: 48, top: 70, left: 44, blur: 17, color: 'rgba(96,165,250,.12)', bd: 10, bx: '11px', by: '-20px' },
  { w: 200, h: 70, top: 60, left: 56, blur: 22, color: 'rgba(139,92,246,.12)', bd: 14, bx: '16px', by: '-26px' }].
  forEach(function (cfg, i) {
    var el = document.createElement('div');el.className = 'blob';
    el.style.cssText = "width:".concat(cfg.w, "px;height:").concat(cfg.h, "px;top:").concat(cfg.top, "%;left:").concat(cfg.left, "%;background:").concat(cfg.color, ";filter:blur(").concat(cfg.blur, "px);--bd:").concat(cfg.bd, "s;--bdelay:").concat(-(i * 1.3).toFixed(1), "s;--bx:").concat(cfg.bx, ";--by:").concat(cfg.by, ";");
    c.appendChild(el);
  });
})();

/* Shapes */
(function () {
  var ct = document.getElementById('shapes');
  var colors = ['#a78bfa', '#818cf8', '#c4b5fd', '#7dd3fc', '#93c5fd', '#ddd6fe', '#e879f9', '#f9a8d4', '#6ee7b7'];
  var defs = {
