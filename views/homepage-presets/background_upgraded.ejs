<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Background</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; }
    body { background: #02060e; font-family: Georgia, serif; overflow: hidden; }
    #root { height: 100%; }

    .min-h-screen {
      min-height: 100vh;
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }

    .overlay-gradient {
      position: absolute; inset: 0;
      background-image: linear-gradient(to top right, var(--tw-gradient-stops));
      --tw-gradient-from: rgb(30 27 75 / 0.8);
      --tw-gradient-via: rgb(46 16 101 / 0.6);
      --tw-gradient-to: rgb(2 6 23 / 0.9);
      --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-via), var(--tw-gradient-to);
    }

    .orb {
      position: absolute; border-radius: 50%;
      filter: blur(90px); opacity: .28; pointer-events: none;
      animation: orb-drift var(--dur) ease-in-out infinite alternate;
      animation-delay: var(--delay, 0s);
    }
    .orb1 { width:520px; height:520px; background:radial-gradient(circle,#6d28d9,transparent 70%); top:-140px; left:-100px; --dur:14s; }
    .orb2 { width:400px; height:400px; background:radial-gradient(circle,#4f46e5,transparent 70%); bottom:-80px; right:40px; --dur:18s; --delay:-6s; }
    .orb3 { width:260px; height:260px; background:radial-gradient(circle,#7c3aed,transparent 70%); top:50%; left:50%; transform:translate(-50%,-50%); --dur:10s; --delay:-3s; }

    .blobs { position:absolute; inset:0; pointer-events:none; }
    .blob {
      position:absolute; border-radius:50%; pointer-events:none;
      animation: blob-float var(--bd) ease-in-out infinite alternate;
      animation-delay: var(--bdelay, 0s);
    }

    .grid-lines {
      position:absolute; inset:0; pointer-events:none;
      background-image:
        linear-gradient(rgba(139,92,246,.05) 1px, transparent 1px),
        linear-gradient(90deg,rgba(139,92,246,.05) 1px, transparent 1px);
      background-size: 56px 56px;
    }

    .stars { position:absolute; inset:0; pointer-events:none; }
    .star {
      position:absolute; border-radius:50%; background:#fff;
      animation: twinkle var(--d) ease-in-out infinite alternate;
      animation-delay: var(--sd, 0s); opacity: var(--o);
    }

    .shapes { position:absolute; inset:0; pointer-events:none; overflow:hidden; }
    .shape {
      position: absolute;
      animation: shape-float var(--sf-dur) ease-in-out infinite alternate;
      animation-delay: var(--s-delay, 0s);
      opacity: var(--s-op, 0.6);
      filter: drop-shadow(0 0 6px var(--s-color, rgba(167,139,250,0.6)));
    }

    .noise {
      position:absolute; inset:0; pointer-events:none; opacity:.14;
      background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.05'/%3E%3C/svg%3E");
    }

    /* ── Card wrapper ── */
    .card-wrapper {
      position: relative; z-index: 10;
      width: 100%; max-width: 32rem;
      animation: scale-in-smooth 1s ease-out both;
      font-family: Inter, sans-serif;
    }
    @keyframes scale-in-smooth {
      from { opacity:0; transform:scale(.88) translateY(28px); }
      to   { opacity:1; transform:scale(1)  translateY(0px); }
    }
    @keyframes fade-in { from{opacity:0} to{opacity:1} }

    /* Card */
    .card {
      background: linear-gradient(135deg, rgba(15,10,40,.96) 0%, rgba(46,16,101,.92) 50%, rgba(20,18,40,.96) 100%);
      border: 2px solid rgba(139,92,246,.35);
      border-radius: 24px;
      overflow: hidden;
      box-shadow:
        0 25px 50px -12px rgba(139,92,246,.45),
        0 0 60px rgba(167,139,250,.2),
        inset 0 1px 0 rgba(255,255,255,.08);
      transition: transform .4s cubic-bezier(.4,0,.2,1), box-shadow .4s cubic-bezier(.4,0,.2,1);
    }
    .card:hover {
      transform: scale(1.018) translateY(-3px);
      box-shadow:
        0 35px 65px -12px rgba(139,92,246,.6),
        0 0 80px rgba(167,139,250,.35),
        inset 0 1px 0 rgba(255,255,255,.1);
    }

    /* Top shimmer line */
    .card-shimmer {
      height: 2px;
      background: linear-gradient(90deg, transparent, #a78bfa, #818cf8, #a78bfa, transparent);
      background-size: 200% 100%;
      animation: shimmer-slide 3s linear infinite;
    }
    @keyframes shimmer-slide {
      0%   { background-position: -200% 0; }
      100% { background-position:  200% 0; }
    }

    /* Card header */
    .card-header {
      background: linear-gradient(135deg, rgba(30,10,70,.85) 0%, rgba(55,20,110,.75) 50%, rgba(10,8,30,.9) 100%);
      padding: 32px 28px 28px;
      text-align: center;
      position: relative;
    }
    .card-header::after {
      content:'';
      position:absolute; bottom:0; left:50%; transform:translateX(-50%);
      width:60%; height:1px;
      background:linear-gradient(90deg,transparent,rgba(167,139,250,.4),transparent);
    }

    /* Decorative corner blobs */
    .deco-blob {
      position:absolute; border-radius:50%; pointer-events:none;
      animation: pulse-slow 3s ease-in-out infinite alternate;
    }
    .deco-blob-1 { width:36px; height:36px; top:12px; left:16px; background:radial-gradient(circle,rgba(167,139,250,.25),transparent 70%); filter:blur(6px); }
    .deco-blob-2 { width:20px; height:20px; top:24px; right:24px; background:radial-gradient(circle,rgba(96,165,250,.3),transparent 70%); filter:blur(4px); animation-delay:.5s; }
    @keyframes pulse-slow { from{opacity:.5;transform:scale(1)} to{opacity:1;transform:scale(1.3)} }

    /* Gift icon container */
    .gift-icon-wrap {
      display:inline-flex; justify-content:center; margin-bottom:24px;
      position:relative;
    }
    .gift-icon-glow {
      position:absolute; inset:-16px;
      background:radial-gradient(circle, rgba(139,92,246,.5) 0%, rgba(99,102,241,.3) 40%, transparent 70%);
      border-radius:50%; filter:blur(12px);
      animation: glow-pulse 2.5s ease-in-out infinite alternate;
    }
    @keyframes glow-pulse {
      from { opacity:.5; transform:scale(.9); }
      to   { opacity:1;  transform:scale(1.15); }
    }
    .gift-icon-box {
      position:relative; z-index:2;
      background:linear-gradient(135deg,#7c3aed,#6d28d9,#4338ca);
      padding:18px; border-radius:18px;
      box-shadow: 0 12px 30px rgba(109,40,217,.5), inset 0 1px 0 rgba(255,255,255,.2);
      transition: transform .4s cubic-bezier(.34,1.56,.64,1), box-shadow .4s;
    }
    .gift-icon-box:hover {
      transform: scale(1.12) rotateY(8deg);
      box-shadow: 0 20px 45px rgba(109,40,217,.7), inset 0 1px 0 rgba(255,255,255,.25);
    }
    .gift-icon-box svg { width:60px; height:60px; color:#fff; display:block; filter:drop-shadow(0 2px 8px rgba(0,0,0,.5)); }

    /* Sparkle badge on icon */
    .sparkle-badge {
      position:absolute; top:-6px; right:-6px; z-index:3;
      width:24px; height:24px;
      animation: spin-slow 6s linear infinite;
    }
    @keyframes spin-slow { to { transform:rotate(360deg); } }
    .ping-dot {
      position:absolute; bottom:-4px; left:-4px; z-index:3;
      width:12px; height:12px; border-radius:50%;
      background:#a78bfa;
    }
    .ping-dot::before {
      content:''; position:absolute; inset:0; border-radius:50%;
      background:#a78bfa; animation:ping 1.5s cubic-bezier(0,0,.2,1) infinite;
    }
    @keyframes ping { 75%,100%{transform:scale(2.2);opacity:0} }

    /* Title */
    .card-title {
      font-size: clamp(1.6rem, 4vw, 2.2rem);
      font-weight: 800;
      letter-spacing: -.025em;
      background: linear-gradient(135deg, #e2d9f3 0%, #a78bfa 40%, #c4b5fd 70%, #818cf8 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
      margin-bottom: 10px;
      text-shadow: none;
      filter: drop-shadow(0 2px 12px rgba(139,92,246,.4));
    }
    .card-subtitle {
      font-size: 14px; font-weight: 500;
      color: rgba(196,181,253,.75);
      line-height: 1.6;
      padding: 0 16px;
    }

    /* Card body */
    .card-body {
      background: linear-gradient(135deg, rgba(20,15,45,.55) 0%, rgba(46,16,101,.3) 50%, rgba(15,10,35,.55) 100%);
      padding: 28px 28px 24px;
    }

    /* Input group */
    .input-label {
      display:block; font-size:13px; font-weight:600;
      color:rgba(196,181,253,.9); margin-bottom:10px; letter-spacing:.02em;
    }
    .input-group { position:relative; margin-bottom:18px; }
    .input-glow {
      position:absolute; inset:0; border-radius:10px;
      background:linear-gradient(90deg,rgba(139,92,246,.2),rgba(99,102,241,.25),rgba(139,92,246,.2));
      opacity:0; transition:opacity .3s; pointer-events:none;
      filter:blur(4px);
    }
    .input-group:focus-within .input-glow { opacity:1; }
    .card-input {
      width:100%; height:58px;
      background:linear-gradient(135deg,#fff,#f8f5ff);
      border:2px solid rgba(139,92,246,.45);
      border-radius:10px;
      font-size:22px; font-weight:800;
      font-family:'Courier New',monospace;
      letter-spacing:.25em;
      color:#5b21b6; text-align:center;
      padding:0 16px;
      outline:none;
      transition:border-color .3s, box-shadow .3s, background .3s;
      position:relative; z-index:1;
    }
    .card-input::placeholder { color:rgba(139,92,246,.45); font-weight:400; font-size:14px; letter-spacing:.05em; }
    .card-input:focus {
      border-color:#7c3aed;
      background:linear-gradient(135deg,#fff,#f3f0ff);
      box-shadow:0 0 0 3px rgba(124,58,237,.2), 0 8px 24px rgba(109,40,217,.15);
    }

    /* Submit button */
    .card-btn {
      width:100%; height:50px;
      background:linear-gradient(135deg,#7c3aed,#6d28d9,#4f46e5);
      background-size:200% 100%;
      border:1px solid rgba(167,139,250,.3);
      border-radius:10px;
      color:#fff; font-family:Inter,sans-serif;
      font-size:16px; font-weight:700;
      cursor:pointer; position:relative; overflow:hidden;
      box-shadow:0 10px 28px rgba(109,40,217,.45);
      transition:all .3s cubic-bezier(.4,0,.2,1);
      display:flex; align-items:center; justify-content:center; gap:8px;
    }
    .card-btn::before {
      content:'';
      position:absolute; inset:0;
      background:linear-gradient(90deg,transparent,rgba(255,255,255,.15),transparent);
      transform:translateX(-100%);
      transition:transform .5s;
    }
    .card-btn:hover::before { transform:translateX(100%); }
    .card-btn:hover {
      transform:translateY(-2px) scale(1.01);
      box-shadow:0 16px 40px rgba(109,40,217,.65);
      background-position:100% 0;
    }
    .card-btn:active { transform:translateY(0) scale(.99); }
    .card-btn:disabled { opacity:.5; cursor:not-allowed; transform:none; }
    .card-btn .btn-top-shine {
      position:absolute; top:0; left:0; right:0; height:1px;
      background:linear-gradient(90deg,transparent,rgba(255,255,255,.45),transparent);
    }

    /* Divider */
    .card-divider {
      border:none; border-top:1px solid rgba(139,92,246,.25);
      margin:20px 0;
    }

    /* Hint pill */
    .hint-pill {
      display:inline-flex; align-items:center; gap:8px;
      background:linear-gradient(135deg,rgba(60,20,100,.65),rgba(80,30,130,.65));
      border:1px solid rgba(139,92,246,.3);
      backdrop-filter:blur(8px);
      padding:8px 18px; border-radius:99px;
      margin-bottom:16px;
    }
    .hint-pill span { font-size:13px; font-weight:500; color:rgba(221,214,254,.85); }
    .hint-bounce { animation:bounce-sm 1.5s ease-in-out infinite; }
    @keyframes bounce-sm { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-4px)} }

    /* Reward grid */
    .reward-grid {
      display:grid; grid-template-columns:repeat(3,1fr); gap:10px;
    }
    .reward-card {
      padding:16px 8px 14px;
      border-radius:14px;
      text-align:center;
      border:1px solid;
      backdrop-filter:blur(8px);
      transition:transform .25s cubic-bezier(.34,1.56,.64,1), box-shadow .25s;
      cursor:default; position: relative; overflow:hidden;
    }
    .reward-card::before {
      content:'';
      position:absolute; top:0; left:0; right:0; height:1px;
      background: linear-gradient(90deg,transparent,rgba(255,255,255,.18),transparent);
    }
    .reward-card:hover { transform:translateY(-4px) scale(1.05); }
    .reward-card .r-icon { font-size:28px; margin-bottom:6px; display:block; filter:drop-shadow(0 2px 8px rgba(0,0,0,.5)); }
    .reward-card .r-label { font-size:11px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; margin-bottom:2px; }
    .reward-card .r-sub   { font-size:10px; font-weight:500; opacity:.65; letter-spacing:.02em; }
    .reward-vip   { background:linear-gradient(160deg,rgba(234,179,8,.22),rgba(217,119,6,.14)); border-color:rgba(250,204,21,.4); box-shadow:0 4px 16px rgba(234,179,8,.12); }
    .reward-vip   .r-label { color:#fde68a; }
    .reward-vip   .r-sub   { color:#fcd34d; }
    .reward-lucky { background:linear-gradient(160deg,rgba(59,130,246,.2),rgba(6,182,212,.14)); border-color:rgba(96,165,250,.4); box-shadow:0 4px 16px rgba(59,130,246,.12); }
    .reward-lucky .r-label { color:#bfdbfe; }
    .reward-lucky .r-sub   { color:#93c5fd; }
    .reward-try   { background:linear-gradient(160deg,rgba(100,116,139,.2),rgba(71,85,105,.14)); border-color:rgba(148,163,184,.3); }
    .reward-try   .r-label { color:#e2e8f0; }
    .reward-try   .r-sub   { color:#cbd5e1; }

    /* ── Trust badges row ── */
    .trust-row {
      display: flex; align-items: center; justify-content: center; gap: 6px;
      margin-bottom: 18px;
    }
    .trust-badge {
      display: inline-flex; align-items: center; gap: 5px;
      background: rgba(255,255,255,.04);
      border: 1px solid rgba(139,92,246,.22);
      border-radius: 99px; padding: 5px 11px;
      font-size: 11px; font-weight: 600; letter-spacing: .03em;
      color: rgba(196,181,253,.8);
      backdrop-filter: blur(6px);
      transition: border-color .25s, background .25s;
    }
    .trust-badge:hover { border-color: rgba(167,139,250,.55); background: rgba(139,92,246,.1); }
    .trust-badge .tb-dot {
      width: 6px; height: 6px; border-radius: 50%; background: #4ade80;
      box-shadow: 0 0 6px rgba(74,222,128,.8);
      animation: ping-green 2s ease-in-out infinite;
    }
    @keyframes ping-green {
      0%,100% { box-shadow:0 0 4px rgba(74,222,128,.6); }
      50%      { box-shadow:0 0 10px rgba(74,222,128,1); }
    }
    .trust-sep { width:3px; height:3px; border-radius:50%; background:rgba(139,92,246,.4); }

    /* ── Stat counter strip ── */
    .stats-strip {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      border: 1px solid rgba(139,92,246,.2);
      border-radius: 14px; overflow: hidden;
      margin-bottom: 20px;
      background: rgba(139,92,246,.12);
    }
    .stat-cell {
      background: linear-gradient(135deg,rgba(20,12,50,.8),rgba(40,20,80,.7));
      padding: 12px 8px; text-align: center;
    }
    .stat-cell .st-num {
      font-size: 18px; font-weight: 800; letter-spacing: -.02em;
      background: linear-gradient(135deg, #c4b5fd, #818cf8);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
      display: block; line-height: 1;
    }
    .stat-cell .st-lbl {
      font-size: 10px; font-weight: 500; color: rgba(196,181,253,.6);
      letter-spacing: .05em; text-transform: uppercase; margin-top: 3px; display: block;
    }

    /* Bottom tagline */
    .tagline-wrap {
      text-align:center; margin-top:16px;
      animation: fade-in .8s .5s ease-out both;
    }
    .tagline-pill {
      display:inline-flex; align-items:center; gap:8px;
      background:linear-gradient(135deg,rgba(55,20,100,.75),rgba(75,30,130,.75));
      border:1px solid rgba(139,92,246,.3);
      backdrop-filter:blur(12px);
      padding:9px 20px; border-radius:99px;
      box-shadow:0 8px 24px rgba(109,40,217,.3);
    }
    .tagline-dot {
      width:8px; height:8px; border-radius:50%; background:#a78bfa;
      animation:pulse-slow 2s ease-in-out infinite alternate;
      box-shadow:0 0 8px rgba(167,139,250,.7);
    }
    .tagline-pill span { font-size:13px; font-weight:500; color:rgba(221,214,254,.85); }

    /* ── Security notice ── */
    .security-note {
      display: flex; align-items: center; justify-content: center; gap: 6px;
      margin-top: 14px; padding: 8px 14px;
      border-radius: 8px;
      background: rgba(74,222,128,.05);
      border: 1px solid rgba(74,222,128,.15);
    }
    .security-note span { font-size: 11px; color: rgba(134,239,172,.75); font-weight: 500; }

    @keyframes orb-drift {
      from { transform:translate(0,0) scale(1); }
      to   { transform:translate(38px,26px) scale(1.1); }
    }
    @keyframes blob-float {
      from { transform:translate(0,0); }
      to   { transform:translate(var(--bx,20px), var(--by,-30px)); }
    }
    @keyframes twinkle {
      from { opacity:var(--o); transform:scale(1); }
      to   { opacity:calc(var(--o)*.2); transform:scale(.5); }
    }
    @keyframes shape-float {
      0%   { transform: translateY(0px) rotate(var(--r0,0deg)); }
      100% { transform: translateY(var(--float-y,-24px)) rotate(var(--r1,15deg)); }
    }
  </style>
</head>
<body>
<div id="root">
  <div class="min-h-screen">

    <div class="overlay-gradient"></div>
    <div class="orb orb1"></div>
    <div class="orb orb2"></div>
    <div class="orb orb3"></div>
    <div class="blobs" id="blobs"></div>
    <div class="grid-lines"></div>
    <div class="stars" id="stars"></div>
    <div class="shapes" id="shapes"></div>
    <div class="noise"></div>

    <!-- ✅ Matches: div.max-w-lg.w-full.relative.z-10.animate-scale-in-smooth -->
    <div class="card-wrapper">

      <!-- Card -->
      <div class="card">
        <!-- Top shimmer -->
        <div class="card-shimmer"></div>

        <!-- Header -->
        <div class="card-header">
          <div class="deco-blob deco-blob-1"></div>
          <div class="deco-blob deco-blob-2"></div>

          <!-- Gift icon -->
          <div class="gift-icon-wrap">
            <div class="gift-icon-glow"></div>
            <div class="gift-icon-box">
              <!-- Gift SVG (lucide-gift) -->
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="8" width="18" height="4" rx="1"/>
                <path d="M12 8v13"/>
                <path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/>
                <path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/>
              </svg>
              <!-- Sparkle -->
              <svg class="sparkle-badge" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="rgba(221,214,254,0.9)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/>
              </svg>
              <div class="ping-dot"></div>
            </div>
          </div>

          <div class="card-title">🎁 Mở Hộp Quà Bí Ẩn</div>
          <div class="card-subtitle">Nhập mã phiên — mở hộp quà — nhận thưởng ngay!<br>Hàng ngàn người đang chơi cùng bạn lúc này 🔥</div>
        </div>

        <!-- Body -->
        <div class="card-body">

          <!-- Trust badges -->
          <div class="trust-row">
            <div class="trust-badge"><div class="tb-dot"></div>Đang trực tuyến</div>
            <div class="trust-sep"></div>
            <div class="trust-badge">🔒 Bảo mật SSL</div>
            <div class="trust-sep"></div>
            <div class="trust-badge">⚡ Tức thì</div>
          </div>

          <!-- Stats strip -->
          <div class="stats-strip">
            <div class="stat-cell">
              <span class="st-num">12,847</span>
              <span class="st-lbl">Người chơi</span>
            </div>
            <div class="stat-cell">
              <span class="st-num">98.6%</span>
              <span class="st-lbl">Hài lòng</span>
            </div>
            <div class="stat-cell">
              <span class="st-num">3,200+</span>
              <span class="st-lbl">Phần thưởng</span>
            </div>
          </div>

          <label class="input-label" for="sessionCode">🔑 Nhập mã phiên chơi của bạn</label>
          <div class="input-group">
            <div class="input-glow"></div>
            <input class="card-input" id="sessionCode" type="text" placeholder="VD: ABC12345" maxlength="8" autocomplete="off" oninput="this.nextElementSibling && updateBtn(this.value)"/>
          </div>

          <button class="card-btn" id="startBtn" type="button" disabled onclick="handleStart()">
            <div class="btn-top-shine"></div>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="6 3 20 12 6 21 6 3"/></svg>
            🎮 Bắt đầu nhận thưởng ngay!
