    c.appendChild(el);
  }
})();

/* ── Blobs ── */
(function () {
  var c = document.getElementById('blobs');
  var cfgs = [
  { w: 120, h: 44, top: 21, left: 41, blur: 18, color: 'rgba(96,165,250,0.22)', bd: 8, bx: '15px', by: '-20px' },
  { w: 90, h: 34, top: 44, left: 31, blur: 14, color: 'rgba(139,92,246,0.28)', bd: 11, bx: '-10px', by: '-25px' },
  { w: 60, h: 22, top: 61, left: 32, blur: 10, color: 'rgba(96,165,250,0.2)', bd: 9, bx: '8px', by: '-18px' },
  { w: 200, h: 72, top: 66, left: 24, blur: 22, color: 'rgba(139,92,246,0.22)', bd: 13, bx: '-20px', by: '-30px' },
  { w: 160, h: 58, top: 72, left: 46, blur: 20, color: 'rgba(96,165,250,0.18)', bd: 10, bx: '12px', by: '-22px' },
  { w: 230, h: 82, top: 63, left: 60, blur: 24, color: 'rgba(139,92,246,0.18)', bd: 14, bx: '18px', by: '-28px' },
  { w: 100, h: 36, top: 18, left: 79, blur: 14, color: 'rgba(167,139,250,0.2)', bd: 9, bx: '-12px', by: '-20px' }];

  cfgs.forEach(function (cfg, i) {
    var el = document.createElement('div');el.className = 'blob';
    el.style.cssText = "width:".concat(cfg.w, "px;height:").concat(cfg.h, "px;top:").concat(cfg.top, "%;left:").concat(cfg.left, "%;background:").concat(cfg.color, ";filter:blur(").concat(cfg.blur, "px);--bd:").concat(cfg.bd, "s;--bdelay:").concat(-(i * 1.3).toFixed(1), "s;--bx:").concat(cfg.bx, ";--by:").concat(cfg.by, ";");
    c.appendChild(el);
  });
})();

/* ── Shapes ── */
(function () {
  var container = document.getElementById('shapes');

  var colors = ['#a78bfa', '#818cf8', '#c4b5fd', '#7dd3fc', '#93c5fd', '#ddd6fe', '#e879f9', '#f9a8d4', '#6ee7b7'];

  // SVG shape definitions (40x40 viewBox)
  var shapeDefs = {

    diamond: function diamond(c) {return "<svg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\">\n      <polygon points=\"20,2 38,20 20,38 2,20\" fill=\"".concat(
        c, "\" fill-opacity=\".18\" stroke=\"").concat(c, "\" stroke-width=\"1.5\"/>\n      <polygon points=\"20,9 31,20 20,31 9,20\" fill=\"").concat(
        c, "\" fill-opacity=\".1\" stroke=\"").concat(c, "\" stroke-width=\".7\"/>\n      <line x1=\"2\" y1=\"20\" x2=\"38\" y2=\"20\" stroke=\"").concat(
        c, "\" stroke-width=\".5\" opacity=\".4\"/>\n      <line x1=\"20\" y1=\"2\" x2=\"20\" y2=\"38\" stroke=\"").concat(
        c, "\" stroke-width=\".5\" opacity=\".4\"/>\n    </svg>");},


    star: function star(c) {return "<svg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\">\n      <polygon points=\"20,2 24,15 38,15 27,23 31,37 20,29 9,37 13,23 2,15 16,15\"\n        fill=\"".concat(

        c, "\" fill-opacity=\".22\" stroke=\"").concat(c, "\" stroke-width=\"1.3\" stroke-linejoin=\"round\"/>\n    </svg>");},


    hexagon: function hexagon(c) {return "<svg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\">\n      <polygon points=\"20,2 35,11 35,29 20,38 5,29 5,11\" fill=\"none\" stroke=\"".concat(
        c, "\" stroke-width=\"1.5\"/>\n      <polygon points=\"20,9 29,14 29,26 20,31 11,26 11,14\" fill=\"").concat(
        c, "\" fill-opacity=\".14\" stroke=\"").concat(c, "\" stroke-width=\".7\"/>\n    </svg>");},


    ornament: function ornament(c) {return "<svg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\">\n      <path d=\"M20 4L20 36M4 20L36 20M8.7 8.7L31.3 31.3M31.3 8.7L8.7 31.3\" stroke=\"".concat(
        c, "\" stroke-width=\"1.3\" stroke-linecap=\"round\"/>\n      <circle cx=\"20\" cy=\"20\" r=\"4\" fill=\"").concat(
        c, "\" opacity=\".55\"/>\n      <circle cx=\"20\" cy=\"20\" r=\"8\" fill=\"none\" stroke=\"").concat(
        c, "\" stroke-width=\".6\" opacity=\".4\"/>\n    </svg>");},


    // 🧑 Human — cute line figure
    human: function human(c) {return "<svg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\">\n      <circle cx=\"20\" cy=\"8\" r=\"5\" fill=\"".concat(
        c, "\" fill-opacity=\".25\" stroke=\"").concat(c, "\" stroke-width=\"1.4\"/>\n      <path d=\"M12 30 Q12 20 20 18 Q28 20 28 30\" fill=\"").concat(
        c, "\" fill-opacity=\".18\" stroke=\"").concat(c, "\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      <line x1=\"20\" y1=\"18\" x2=\"20\" y2=\"28\" stroke=\"").concat(
        c, "\" stroke-width=\"1.2\" stroke-linecap=\"round\"/>\n      <line x1=\"12\" y1=\"22\" x2=\"28\" y2=\"22\" stroke=\"").concat(
        c, "\" stroke-width=\"1.2\" stroke-linecap=\"round\"/>\n      <line x1=\"15\" y1=\"28\" x2=\"13\" y2=\"36\" stroke=\"").concat(
        c, "\" stroke-width=\"1.3\" stroke-linecap=\"round\"/>\n      <line x1=\"25\" y1=\"28\" x2=\"27\" y2=\"36\" stroke=\"").concat(
        c, "\" stroke-width=\"1.3\" stroke-linecap=\"round\"/>\n    </svg>");},


    // 🌲 Tree — pine / christmas style
    tree: function tree(c) {return "<svg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\">\n      <polygon points=\"20,3 33,18 26,18 31,28 24,28 24,37 16,37 16,28 9,28 14,18 7,18\"\n        fill=\"".concat(

        c, "\" fill-opacity=\".2\" stroke=\"").concat(c, "\" stroke-width=\"1.4\" stroke-linejoin=\"round\"/>\n      <line x1=\"20\" y1=\"3\" x2=\"20\" y2=\"37\" stroke=\"").concat(
        c, "\" stroke-width=\".5\" opacity=\".3\"/>\n    </svg>");},


    // 🐶 Puppy — simple cute dog
    puppy: function puppy(c) {return "<svg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\">\n      <!-- body -->\n      <ellipse cx=\"20\" cy=\"26\" rx=\"11\" ry=\"8\" fill=\"".concat(

        c, "\" fill-opacity=\".2\" stroke=\"").concat(c, "\" stroke-width=\"1.3\"/>\n      <!-- head -->\n      <circle cx=\"20\" cy=\"14\" r=\"7\" fill=\"").concat(

        c, "\" fill-opacity=\".22\" stroke=\"").concat(c, "\" stroke-width=\"1.3\"/>\n      <!-- ears -->\n      <ellipse cx=\"13\" cy=\"10\" rx=\"3.5\" ry=\"5\" fill=\"").concat(

        c, "\" fill-opacity=\".3\" stroke=\"").concat(c, "\" stroke-width=\"1\" transform=\"rotate(-15 13 10)\"/>\n      <ellipse cx=\"27\" cy=\"10\" rx=\"3.5\" ry=\"5\" fill=\"").concat(
        c, "\" fill-opacity=\".3\" stroke=\"").concat(c, "\" stroke-width=\"1\" transform=\"rotate(15 27 10)\"/>\n      <!-- eyes -->\n      <circle cx=\"17\" cy=\"13\" r=\"1.2\" fill=\"").concat(

        c, "\" opacity=\".8\"/>\n      <circle cx=\"23\" cy=\"13\" r=\"1.2\" fill=\"").concat(
        c, "\" opacity=\".8\"/>\n      <!-- nose -->\n      <ellipse cx=\"20\" cy=\"17\" rx=\"2\" ry=\"1.2\" fill=\"").concat(

        c, "\" opacity=\".6\"/>\n      <!-- tail -->\n      <path d=\"M31 24 Q38 18 36 26\" fill=\"none\" stroke=\"").concat(

        c, "\" stroke-width=\"1.4\" stroke-linecap=\"round\"/>\n      <!-- legs -->\n      <line x1=\"13\" y1=\"33\" x2=\"12\" y2=\"39\" stroke=\"").concat(

        c, "\" stroke-width=\"1.3\" stroke-linecap=\"round\"/>\n      <line x1=\"17\" y1=\"34\" x2=\"16\" y2=\"39\" stroke=\"").concat(
        c, "\" stroke-width=\"1.3\" stroke-linecap=\"round\"/>\n      <line x1=\"23\" y1=\"34\" x2=\"24\" y2=\"39\" stroke=\"").concat(
        c, "\" stroke-width=\"1.3\" stroke-linecap=\"round\"/>\n      <line x1=\"27\" y1=\"33\" x2=\"28\" y2=\"39\" stroke=\"").concat(
        c, "\" stroke-width=\"1.3\" stroke-linecap=\"round\"/>\n    </svg>");},


    // 🐱 Kitty — simple cute cat
    // 🎁 Gift box
    gift: function gift(c) {return "<svg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\">\n      <!-- box body -->\n      <rect x=\"6\" y=\"18\" width=\"28\" height=\"18\" rx=\"1.5\" fill=\"".concat(

        c, "\" fill-opacity=\".2\" stroke=\"").concat(c, "\" stroke-width=\"1.4\"/>\n      <!-- box lid -->\n      <rect x=\"4\" y=\"13\" width=\"32\" height=\"7\" rx=\"1.5\" fill=\"").concat(

        c, "\" fill-opacity=\".28\" stroke=\"").concat(c, "\" stroke-width=\"1.4\"/>\n      <!-- ribbon vertical -->\n      <rect x=\"18\" y=\"13\" width=\"4\" height=\"23\" fill=\"").concat(

        c, "\" fill-opacity=\".45\"/>\n      <!-- ribbon horizontal on lid -->\n      <rect x=\"4\" y=\"15.5\" width=\"32\" height=\"2\" fill=\"").concat(

        c, "\" fill-opacity=\".45\"/>\n      <!-- bow left loop -->\n      <path d=\"M20 13 Q14 6 10 10 Q8 14 14 14 Z\" fill=\"").concat(

        c, "\" fill-opacity=\".5\" stroke=\"").concat(c, "\" stroke-width=\".9\"/>\n      <!-- bow right loop -->\n      <path d=\"M20 13 Q26 6 30 10 Q32 14 26 14 Z\" fill=\"").concat(

        c, "\" fill-opacity=\".5\" stroke=\"").concat(c, "\" stroke-width=\".9\"/>\n      <!-- shine -->\n      <line x1=\"9\" y1=\"22\" x2=\"9\" y2=\"30\" stroke=\"").concat(

        c, "\" stroke-width=\".6\" opacity=\".35\"/>\n    </svg>");},


    kitty: function kitty(c) {return "<svg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\">\n      <!-- body -->\n      <ellipse cx=\"20\" cy=\"27\" rx=\"10\" ry=\"8\" fill=\"".concat(

        c, "\" fill-opacity=\".2\" stroke=\"").concat(c, "\" stroke-width=\"1.3\"/>\n      <!-- head -->\n      <circle cx=\"20\" cy=\"14\" r=\"7\" fill=\"").concat(

        c, "\" fill-opacity=\".22\" stroke=\"").concat(c, "\" stroke-width=\"1.3\"/>\n      <!-- pointy ears -->\n      <polygon points=\"13,9 10,2 16,7\" fill=\"").concat(

        c, "\" fill-opacity=\".35\" stroke=\"").concat(c, "\" stroke-width=\"1\"/>\n      <polygon points=\"27,9 30,2 24,7\" fill=\"").concat(
        c, "\" fill-opacity=\".35\" stroke=\"").concat(c, "\" stroke-width=\"1\"/>\n      <!-- eyes (almond) -->\n      <ellipse cx=\"17\" cy=\"13\" rx=\"1.8\" ry=\"1.2\" fill=\"").concat(

        c, "\" opacity=\".85\"/>\n      <ellipse cx=\"23\" cy=\"13\" rx=\"1.8\" ry=\"1.2\" fill=\"").concat(
        c, "\" opacity=\".85\"/>\n      <!-- nose + mouth -->\n      <polygon points=\"20,16.5 18.5,18 21.5,18\" fill=\"").concat(

        c, "\" opacity=\".6\"/>\n      <path d=\"M18.5 18 Q17 20 15 19.5 M21.5 18 Q23 20 25 19.5\" fill=\"none\" stroke=\"").concat(
        c, "\" stroke-width=\".9\" stroke-linecap=\"round\"/>\n      <!-- whiskers -->\n      <line x1=\"8\"  y1=\"16\" x2=\"15\" y2=\"17\" stroke=\"").concat(

        c, "\" stroke-width=\".8\" opacity=\".5\"/>\n      <line x1=\"8\"  y1=\"18\" x2=\"15\" y2=\"18\" stroke=\"").concat(
        c, "\" stroke-width=\".8\" opacity=\".4\"/>\n      <line x1=\"25\" y1=\"17\" x2=\"32\" y2=\"16\" stroke=\"").concat(
        c, "\" stroke-width=\".8\" opacity=\".5\"/>\n      <line x1=\"25\" y1=\"18\" x2=\"32\" y2=\"18\" stroke=\"").concat(
        c, "\" stroke-width=\".8\" opacity=\".4\"/>\n      <!-- tail -->\n      <path d=\"M30 27 Q38 20 36 30 Q34 36 30 34\" fill=\"none\" stroke=\"").concat(

        c, "\" stroke-width=\"1.4\" stroke-linecap=\"round\"/>\n      <!-- legs -->\n      <line x1=\"13\" y1=\"34\" x2=\"12\" y2=\"39\" stroke=\"").concat(

        c, "\" stroke-width=\"1.3\" stroke-linecap=\"round\"/>\n      <line x1=\"17\" y1=\"35\" x2=\"17\" y2=\"39\" stroke=\"").concat(
        c, "\" stroke-width=\"1.3\" stroke-linecap=\"round\"/>\n      <line x1=\"23\" y1=\"35\" x2=\"23\" y2=\"39\" stroke=\"").concat(
        c, "\" stroke-width=\"1.3\" stroke-linecap=\"round\"/>\n      <line x1=\"27\" y1=\"34\" x2=\"28\" y2=\"39\" stroke=\"").concat(
        c, "\" stroke-width=\"1.3\" stroke-linecap=\"round\"/>\n    </svg>");}

  };

  var shapeKeys = Object.keys(shapeDefs);

  // Distribute: ensure each type appears multiple times
  var pool = [];
  shapeKeys.forEach(function (k) {
    var count = k === 'gift' ? 5 : k === 'human' || k === 'tree' || k === 'puppy' || k === 'kitty' ? 3 : 4;
    for (var i = 0; i < count; i++) pool.push(k);
  });
  // Shuffle
  for (var i = pool.length - 1; i > 0; i--) {
    var j = Math.floor(Math.random() * (i + 1));var _ref =
    [pool[j], pool[i]];pool[i] = _ref[0];pool[j] = _ref[1];
  }

  pool.forEach(function (key, i) {
    var wrapper = document.createElement('div');
    wrapper.className = 'shape';

    var scale = (Math.random() * 0.8 + 0.7).toFixed(2); // 0.7–1.5x
    var color = colors[Math.floor(Math.random() * colors.length)];
    var svg = shapeDefs[key](color);

    var top = (Math.random() * 88 + 2).toFixed(2);
    var left = (Math.random() * 94 + 1).toFixed(2);
    var floatY = (-(Math.random() * 28 + 10)).toFixed(0) + 'px';
    var r0 = (Math.random() * 30 - 15).toFixed(0) + 'deg';
    var r1 = (Math.random() * 30 - 15).toFixed(0) + 'deg';
    var sfDur = (Math.random() * 6 + 5).toFixed(1) + 's';
    var delay = (-(Math.random() * 14)).toFixed(1) + 's';
    var opacity = (Math.random() * 0.35 + 0.5).toFixed(2);
    var size = Math.round(scale * 40);

    wrapper.style.cssText = "\n      top:".concat(
      top, "%;left:").concat(left, "%;\n      width:").concat(
      size, "px;height:").concat(size, "px;\n      --float-y:").concat(
      floatY, ";--r0:").concat(r0, ";--r1:").concat(r1, ";\n      --sf-dur:").concat(
      sfDur, ";--s-delay:").concat(delay, ";--s-op:").concat(opacity, ";\n      --s-color:").concat(
      color, ";\n    ");

    wrapper.innerHTML = svg;
    container.appendChild(wrapper);
  });
})();
/* ── Input → button enable ── */
var inp = document.getElementById('sessionCode');
var btn = document.getElementById('startBtn');
if (inp && btn) {
  inp.addEventListener('input', function () {
    btn.disabled = inp.value.trim().length < 1;
  });
}
function handleStart() {
  var code = document.getElementById('sessionCode').value.trim();
  if (!code) return;
  var b = document.getElementById('startBtn');
  b.innerHTML = '<div class="btn-top-shine"></div>⏳ Đang vào phòng...';
  b.disabled = true;
  setTimeout(function () {
    b.innerHTML = '<div class="btn-top-shine"></div>✅ Đã kết nối!';
  }, 1800);
}</script>
</body>
</html>
