          </div>
        </div>
      </div>

      <!-- Bottom tagline -->
      <div class="tagline-wrap">
        <div class="tagline-pill">
          <div class="tagline-dot"></div>
          <span>✨ Được tin dùng bởi hơn <strong style="color:#c4b5fd">12,000+</strong> người chơi</span>
        </div>
      </div>

    </div>

  </div>
</div>

<script>
/* ── Stars ── */
(function () {
