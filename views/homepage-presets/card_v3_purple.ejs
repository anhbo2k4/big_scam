<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Background</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap"></noscript>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; }
    body { background: #02060e; font-family: Georgia, serif; overflow: hidden; }
    #root { height: 100%; }

    .min-h-screen {
      min-height: 100vh;
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }

    .overlay-gradient {
      position: absolute; inset: 0;
      background-image: linear-gradient(to top right, var(--tw-gradient-stops));
      --tw-gradient-from: rgb(30 27 75 / 0.8);
      --tw-gradient-via: rgb(46 16 101 / 0.6);
      --tw-gradient-to: rgb(2 6 23 / 0.9);
      --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-via), var(--tw-gradient-to);
    }

    .orb {
      position: absolute; border-radius: 50%;
      filter: blur(90px); opacity: .28; pointer-events: none;
      animation: orb-drift var(--dur) ease-in-out infinite alternate;
      animation-delay: var(--delay, 0s);
    }
    .orb1 { width:520px; height:520px; background:radial-gradient(circle,#6d28d9,transparent 70%); top:-140px; left:-100px; --dur:14s; }
    .orb2 { width:400px; height:400px; background:radial-gradient(circle,#4f46e5,transparent 70%); bottom:-80px; right:40px; --dur:18s; --delay:-6s; }
    .orb3 { width:260px; height:260px; background:radial-gradient(circle,#7c3aed,transparent 70%); top:50%; left:50%; transform:translate(-50%,-50%); --dur:10s; --delay:-3s; }

    .blobs { position:absolute; inset:0; pointer-events:none; }
    .blob {
      position:absolute; border-radius:50%; pointer-events:none;
      animation: blob-float var(--bd) ease-in-out infinite alternate;
      animation-delay: var(--bdelay, 0s);
    }

    .grid-lines {
      position:absolute; inset:0; pointer-events:none;
      background-image:
        linear-gradient(rgba(139,92,246,.05) 1px, transparent 1px),
        linear-gradient(90deg,rgba(139,92,246,.05) 1px, transparent 1px);
      background-size: 56px 56px;
    }

    .stars { position:absolute; inset:0; pointer-events:none; }
    .star {
      position:absolute; border-radius:50%; background:#fff;
      animation: twinkle var(--d) ease-in-out infinite alternate;
      animation-delay: var(--sd, 0s); opacity: var(--o);
    }

    .shapes { position:absolute; inset:0; pointer-events:none; overflow:hidden; }
    .shape {
      position: absolute;
      animation: shape-float var(--sf-dur) ease-in-out infinite alternate;
      animation-delay: var(--s-delay, 0s);
      opacity: var(--s-op, 0.6);
      filter: drop-shadow(0 0 6px var(--s-color, rgba(167,139,250,0.6)));
    }

    .noise {
      position:absolute; inset:0; pointer-events:none; opacity:.14;
      background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.05'/%3E%3C/svg%3E");
    }

    /* Google Fonts loaded via preload below */

    /* ── Card wrapper ── */
    .card-wrapper {
      position: relative; z-index: 10;
      width: 100%; max-width: 31rem;
      font-family: 'Plus Jakarta Sans', sans-serif;
      animation: rise-in 1s cubic-bezier(.22,1,.36,1) both;
    }
    @keyframes rise-in {
      from { opacity:0; transform:translateY(40px) scale(.94); filter:blur(4px); }
      to   { opacity:1; transform:translateY(0) scale(1); filter:blur(0); }
    }
    @keyframes fade-up { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:translateY(0)} }

    /* Card */
    .card {
      background: linear-gradient(160deg,
        rgba(10,6,28,.97) 0%,
        rgba(25,12,65,.95) 40%,
        rgba(18,10,48,.97) 75%,
        rgba(8,5,20,.98) 100%);
      border: 1px solid rgba(139,92,246,.28);
      border-radius: 26px;
      overflow: hidden;
      box-shadow:
        0 32px 72px -16px rgba(0,0,0,.75),
        0 0 0 1px rgba(255,255,255,.04),
        0 0 80px -20px rgba(109,40,217,.35),
        inset 0 1px 0 rgba(255,255,255,.08);
      transition: transform .5s cubic-bezier(.22,1,.36,1), box-shadow .5s;
    }
    .card:hover {
      transform: translateY(-4px) scale(1.01);
      box-shadow:
        0 48px 96px -16px rgba(0,0,0,.85),
        0 0 0 1px rgba(139,92,246,.35),
        0 0 100px -15px rgba(109,40,217,.5),
        inset 0 1px 0 rgba(255,255,255,.1);
    }

    /* ── Header ── */
    .card-header {
      position:relative; overflow:hidden;
      padding: 36px 28px 30px;
      text-align: center;
      background: linear-gradient(160deg,
        rgba(18,8,55,.98) 0%,
        rgba(38,16,90,.9) 50%,
        rgba(12,6,32,.98) 100%);
    }
    /* Subtle radial glows in header */
    .card-header::before {
      content:'';
      position:absolute; inset:0;
      background:
        radial-gradient(ellipse 70% 55% at 15% 0%,  rgba(139,92,246,.2) 0%, transparent 65%),
        radial-gradient(ellipse 50% 45% at 85% 100%, rgba(99,102,241,.18) 0%, transparent 65%),
        radial-gradient(ellipse 35% 40% at 50% 40%,  rgba(167,139,250,.08) 0%, transparent 70%);
      pointer-events:none;
      animation: hdr-breathe 7s ease-in-out infinite alternate;
    }
    @keyframes hdr-breathe {
      from { opacity:.7; } to { opacity:1; }
    }
    /* Bottom separator line */
    .card-header::after {
      content:'';
      position:absolute; bottom:0; left:0; right:0; height:1px;
      background: linear-gradient(90deg, transparent, rgba(139,92,246,.5), rgba(167,139,250,.4), transparent);
    }

    /* ── Gift icon ── */
    .gift-icon-wrap {
      display:inline-flex; justify-content:center; margin-bottom:22px;
      position:relative; z-index:2;
    }
    .gift-icon-glow {
      position:absolute; inset:-20px; border-radius:50%;
      background:radial-gradient(circle, rgba(139,92,246,.55) 0%, rgba(99,102,241,.25) 45%, transparent 70%);
      filter:blur(14px);
      animation: glow-breathe 3s ease-in-out infinite alternate;
    }
    @keyframes glow-breathe {
      from { opacity:.5; transform:scale(.88); }
      to   { opacity:1; transform:scale(1.12); }
    }
    .gift-icon-box {
      position:relative; z-index:2;
      background: linear-gradient(145deg, #6d28d9, #5b21b6, #4338ca);
      padding:20px; border-radius:20px;
      box-shadow:
        0 16px 40px rgba(109,40,217,.55),
        0 0 0 1px rgba(167,139,250,.2),
        inset 0 1px 0 rgba(255,255,255,.2),
        inset 0 -2px 0 rgba(0,0,0,.25);
      transition: transform .45s cubic-bezier(.34,1.56,.64,1), box-shadow .45s;
    }
    .gift-icon-box:hover {
      transform: scale(1.1) rotateY(10deg) rotateX(4deg);
      box-shadow:
        0 24px 55px rgba(109,40,217,.7),
        0 0 0 1px rgba(167,139,250,.35),
        inset 0 1px 0 rgba(255,255,255,.25);
    }
    .gift-icon-box svg { width:58px; height:58px; color:#fff; display:block; filter:drop-shadow(0 2px 8px rgba(0,0,0,.5)); }

    /* Sparkle badge */
    .sparkle-badge {
      position:absolute; top:-8px; right:-8px; z-index:3;
      width:22px; height:22px;
      animation: spin-slow 7s linear infinite;
      filter: drop-shadow(0 0 4px rgba(196,181,253,.6));
    }
    @keyframes spin-slow { to { transform:rotate(360deg); } }
    .ping-dot {
      position:absolute; bottom:-5px; left:-5px; z-index:3;
      width:13px; height:13px; border-radius:50%;
      background: radial-gradient(circle, #c4b5fd, #8b5cf6);
      box-shadow: 0 0 8px rgba(167,139,250,.8);
    }
    .ping-dot::before {
      content:''; position:absolute; inset:0; border-radius:50%;
      background:#a78bfa; animation:ping 1.8s cubic-bezier(0,0,.2,1) infinite;
    }
    @keyframes ping { 75%,100%{transform:scale(2.4);opacity:0} }

    /* ── Live badge ── */
    .live-badge {
      display:inline-flex; align-items:center; gap:5px;
      background:rgba(0,0,0,.45); border:1px solid rgba(74,222,128,.35);
      border-radius:99px; padding:4px 10px; margin-bottom:16px;
      backdrop-filter:blur(8px);
    }
    .live-badge .lb-dot {
      width:6px; height:6px; border-radius:50%; background:#4ade80;
      box-shadow:0 0 6px rgba(74,222,128,.9);
      animation: lb-pulse 1.4s ease-in-out infinite;
    }
    @keyframes lb-pulse { 0%,100%{box-shadow:0 0 4px rgba(74,222,128,.6)} 50%{box-shadow:0 0 12px rgba(74,222,128,1)} }
    .live-badge span { font-size:11px; font-weight:700; color:rgba(134,239,172,.85); letter-spacing:.06em; }

    /* ── Title & subtitle ── */
    .card-title {
      font-size: clamp(1.55rem, 3.8vw, 2.1rem);
      font-weight: 900;
      letter-spacing: -.03em;
      line-height: 1.15;
      background: linear-gradient(140deg, #f3f0ff 0%, #c4b5fd 30%, #a78bfa 55%, #818cf8 80%, #c4b5fd 100%);
      -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;
      margin-bottom:10px;
      filter: drop-shadow(0 2px 16px rgba(139,92,246,.45));
      position:relative; z-index:2;
      animation: fade-up .7s .25s ease-out both;
    }
    .card-subtitle {
      font-size:13.5px; font-weight:500;
      color:rgba(196,181,253,.7); line-height:1.65;
      padding:0 8px; position:relative; z-index:2;
      animation: fade-up .7s .38s ease-out both;
    }

    /* ── Ticker tape ── */
    .ticker-wrap {
      overflow:hidden;
      background: rgba(139,92,246,.05);
      border-top:1px solid rgba(139,92,246,.15);
      border-bottom:1px solid rgba(139,92,246,.15);
      padding:6px 0;
      animation: fade-up .7s .5s ease-out both;
    }
    .ticker-inner {
      display:flex; white-space:nowrap;
      animation: ticker-run 20s linear infinite;
    }
    @keyframes ticker-run { from{transform:translateX(0)} to{transform:translateX(-50%)} }
    .ticker-item {
      display:inline-flex; align-items:center; gap:5px;
      font-size:11.5px; font-weight:600;
      color:rgba(196,181,253,.65); letter-spacing:.03em;
      padding:0 20px;
    }
    .ticker-dot { color:rgba(139,92,246,.4); }

    /* ── Card body ── */
    .card-body { padding:24px 26px 22px; }

    /* ── Stats row ── */
    .stats-row {
      display:grid; grid-template-columns:repeat(3,1fr);
      gap:8px; margin-bottom:22px;
    }
    .stat-tile {
      background: linear-gradient(145deg, rgba(139,92,246,.1), rgba(99,102,241,.06));
      border:1px solid rgba(139,92,246,.2);
      border-radius:13px; padding:12px 6px 10px; text-align:center;
      position:relative; overflow:hidden;
      transition: border-color .25s, background .25s;
    }
    .stat-tile::before {
      content:''; position:absolute; top:0; left:0; right:0; height:1px;
      background:linear-gradient(90deg,transparent,rgba(167,139,250,.55),transparent);
    }
    .stat-tile:hover { border-color:rgba(139,92,246,.4); background:linear-gradient(145deg,rgba(139,92,246,.15),rgba(99,102,241,.1)); }
    .stat-tile .s-num {
      font-size:17px; font-weight:800;
      background:linear-gradient(135deg,#e2d9f3,#a78bfa);
      -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;
      display:block; line-height:1;
    }
    .stat-tile .s-lbl {
      font-size:10px; font-weight:600; text-transform:uppercase; letter-spacing:.07em;
      color:rgba(167,139,250,.55); margin-top:4px; display:block;
    }

    /* ── Input ── */
    .input-label {
      display:flex; align-items:center; gap:6px;
      font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.07em;
      color:rgba(196,181,253,.65); margin-bottom:9px;
    }
    .input-group { position:relative; margin-bottom:16px; }
    .input-glow {
      position:absolute; inset:-2px; border-radius:13px;
      background:linear-gradient(135deg,rgba(139,92,246,.4),rgba(99,102,241,.5),rgba(139,92,246,.4));
      opacity:0; transition:opacity .35s; pointer-events:none; filter:blur(5px);
    }
    .input-group:focus-within .input-glow { opacity:1; }
    .card-input {
      width:100%; height:56px;
      background:linear-gradient(135deg, rgba(255,255,255,.97), rgba(245,240,255,.97));
      border:1.5px solid rgba(139,92,246,.35);
      border-radius:12px;
      font-size:21px; font-weight:800;
      font-family:'Courier New',monospace;
      letter-spacing:.3em; color:#4c1d95; text-align:center;
      padding:0 16px; outline:none;
      transition:border-color .3s, box-shadow .3s;
      position:relative; z-index:1;
    }
    .card-input::placeholder { color:rgba(109,40,217,.35); font-weight:500; font-size:13px; letter-spacing:.05em; font-family:'Plus Jakarta Sans',sans-serif; }
    .card-input:focus {
      border-color:rgba(139,92,246,.7);
      box-shadow:0 0 0 3px rgba(109,40,217,.18), 0 8px 28px rgba(109,40,217,.15);
    }

    /* ── CTA Button ── */
    .card-btn {
      width:100%; height:52px;
      background:linear-gradient(135deg, #7c3aed, #6d28d9, #5b21b6, #4f46e5);
      background-size:250% 100%;
      border:none; border-radius:12px;
      color:#fff; font-family:'Plus Jakarta Sans',sans-serif;
      font-size:15.5px; font-weight:800; letter-spacing:.02em;
      cursor:pointer; position:relative; overflow:hidden;
      box-shadow:
        0 10px 32px rgba(109,40,217,.5),
        inset 0 1px 0 rgba(255,255,255,.2),
        inset 0 -2px 0 rgba(0,0,0,.2);
      transition:all .4s cubic-bezier(.22,1,.36,1);
      display:flex; align-items:center; justify-content:center; gap:8px;
      animation: btn-flow 4s ease-in-out infinite;
    }
    @keyframes btn-flow {
      0%,100% { background-position:0% 0; }
      50%      { background-position:100% 0; }
    }
    .card-btn::before {
      content:'';
      position:absolute; inset:0;
      background:linear-gradient(110deg,transparent 38%,rgba(255,255,255,.22) 50%,transparent 62%);
      transform:translateX(-130%);
      transition:transform .65s cubic-bezier(.22,1,.36,1);
    }
    .card-btn:hover::before { transform:translateX(130%); }
    .card-btn:hover {
      transform:translateY(-3px) scale(1.012);
      box-shadow:0 18px 48px rgba(109,40,217,.65), inset 0 1px 0 rgba(255,255,255,.25);
    }
    .card-btn:active { transform:translateY(0) scale(.99); }
    .card-btn:disabled {
      opacity:.45; cursor:not-allowed;
      transform:none; animation:none;
      box-shadow:0 4px 12px rgba(109,40,217,.2);
    }

    /* ── Divider ── */
    .card-divider {
      border:none; height:1px;
      background:linear-gradient(90deg,transparent,rgba(139,92,246,.22),rgba(99,102,241,.18),transparent);
      margin:20px 0;
    }

    /* ── Reward grid ── */
    .reward-label {
      font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:.1em;
      color:rgba(167,139,250,.45); text-align:center; margin-bottom:10px;
    }
    .reward-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:9px; }
    .reward-card {
      position:relative; overflow:hidden; padding:15px 6px 12px;
      border-radius:14px; text-align:center; border:1px solid;
      backdrop-filter:blur(10px);
      transition:transform .3s cubic-bezier(.34,1.56,.64,1), box-shadow .3s;
      cursor:default;
    }
    .reward-card::after {
      content:''; position:absolute; top:0; left:0; right:0; height:1px;
      background:linear-gradient(90deg,transparent,rgba(255,255,255,.18),transparent);
    }
    .reward-card:hover { transform:translateY(-5px) scale(1.06); }
    .reward-card .r-icon  { font-size:27px; margin-bottom:5px; display:block; }
    .reward-card .r-label { font-size:10.5px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; margin-bottom:2px; }
    .reward-card .r-sub   { font-size:9.5px; font-weight:500; opacity:.6; }
    .reward-vip   { background:linear-gradient(155deg,rgba(250,204,21,.15),rgba(234,179,8,.07)); border-color:rgba(250,204,21,.3); box-shadow:0 4px 18px rgba(234,179,8,.1); }
    .reward-vip   .r-label { color:#fde68a; } .reward-vip .r-sub { color:#fcd34d; }
    .reward-lucky { background:linear-gradient(155deg,rgba(139,92,246,.18),rgba(99,102,241,.1)); border-color:rgba(139,92,246,.35); box-shadow:0 4px 18px rgba(109,40,217,.12); }
    .reward-lucky .r-label { color:#c4b5fd; } .reward-lucky .r-sub { color:#a5b4fc; }
    .reward-try   { background:linear-gradient(155deg,rgba(71,85,105,.18),rgba(51,65,85,.1)); border-color:rgba(100,116,139,.28); }
    .reward-try   .r-label { color:#cbd5e1; } .reward-try .r-sub { color:#94a3b8; }

    /* ── Trust bar ── */
    .trust-bar {
      display:flex; margin-top:16px;
      border:1px solid rgba(74,222,128,.15); border-radius:10px; overflow:hidden;
      background:rgba(74,222,128,.03);
    }
    .trust-item {
      flex:1; display:flex; align-items:center; justify-content:center; gap:5px;
      padding:8px 4px; font-size:10.5px; font-weight:600;
      color:rgba(134,239,172,.7); letter-spacing:.02em;
      border-right:1px solid rgba(74,222,128,.1);
    }
    .trust-item:last-child { border-right:none; }

    /* ── Tagline ── */
    .tagline-wrap {
      text-align:center; margin-top:14px;
      animation: fade-up .7s .6s ease-out both;
    }
    .tagline-pill {
      display:inline-flex; align-items:center; gap:8px;
      background:rgba(10,6,30,.88);
      border:1px solid rgba(139,92,246,.28);
      backdrop-filter:blur(16px);
      padding:9px 22px; border-radius:99px;
      box-shadow:0 8px 32px rgba(0,0,0,.45), 0 0 24px rgba(109,40,217,.1);
    }
    .tagline-dot {
      width:7px; height:7px; border-radius:50%; background:#a78bfa;
      box-shadow:0 0 8px rgba(167,139,250,.8);
      animation:pulse-slow 2.2s ease-in-out infinite alternate;
    }
    .tagline-pill span { font-size:12.5px; font-weight:600; color:rgba(221,214,254,.8); }

    @keyframes orb-drift {
      from { transform:translate(0,0) scale(1); }
      to   { transform:translate(38px,26px) scale(1.1); }
    }
    @keyframes blob-float {
      from { transform:translate(0,0); }
      to   { transform:translate(var(--bx,20px), var(--by,-30px)); }
    }
    @keyframes twinkle {
      from { opacity:var(--o); transform:scale(1); }
      to   { opacity:calc(var(--o)*.2); transform:scale(.5); }
    }
    @keyframes shape-float {
      0%   { transform: translateY(0px) rotate(var(--r0,0deg)); }
      100% { transform: translateY(var(--float-y,-24px)) rotate(var(--r1,15deg)); }
    }
  </style>
</head>
<body>
<div id="root">
  <div class="min-h-screen">

    <div class="overlay-gradient"></div>
    <div class="orb orb1"></div>
    <div class="orb orb2"></div>
    <div class="orb orb3"></div>
    <div class="blobs" id="blobs"></div>
    <div class="grid-lines"></div>
    <div class="stars" id="stars"></div>
    <div class="shapes" id="shapes"></div>
    <div class="noise"></div>

    <!-- Card wrapper -->
    <div class="card-wrapper">
      <div class="card">

        <!-- Header -->
        <div class="card-header">

          <!-- Gift icon (original SVG kept) -->
          <div class="gift-icon-wrap">
            <div class="gift-icon-glow"></div>
            <div class="gift-icon-box">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="8" width="18" height="4" rx="1"/>
                <path d="M12 8v13"/>
                <path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/>
                <path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/>
              </svg>
              <svg class="sparkle-badge" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="rgba(221,214,254,0.9)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/>
              </svg>
              <div class="ping-dot"></div>
            </div>
