    gift: function gift(c) {return "<svg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\">\n      <!-- box body -->\n      <rect x=\"6\" y=\"18\" width=\"28\" height=\"18\" rx=\"1.5\" fill=\"".concat(

