    star: function star(c) {return "<svg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\">\n      <polygon points=\"20,2 24,15 38,15 27,23 31,37 20,29 9,37 13,23 2,15 16,15\"\n        fill=\"".concat(

