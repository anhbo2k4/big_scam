        c, "\" stroke-width=\"1.4\" stroke-linecap=\"round\"/>\n      <!-- legs -->\n      <line x1=\"13\" y1=\"34\" x2=\"12\" y2=\"39\" stroke=\"").concat(

        c, "\" stroke-width=\"1.3\" stroke-linecap=\"round\"/>\n      <line x1=\"17\" y1=\"35\" x2=\"17\" y2=\"39\" stroke=\"").concat(
        c, "\" stroke-width=\"1.3\" stroke-linecap=\"round\"/>\n      <line x1=\"23\" y1=\"35\" x2=\"23\" y2=\"39\" stroke=\"").concat(
        c, "\" stroke-width=\"1.3\" stroke-linecap=\"round\"/>\n      <line x1=\"27\" y1=\"34\" x2=\"28\" y2=\"39\" stroke=\"").concat(
        c, "\" stroke-width=\"1.3\" stroke-linecap=\"round\"/>\n    </svg>");}

  };

  var shapeKeys = Object.keys(shapeDefs);

  // Distribute: ensure each type appears multiple times
  var pool = [];
  shapeKeys.forEach(function (k) {
    var count = k === 'gift' ? 5 : k === 'human' || k === 'tree' || k === 'puppy' || k === 'kitty' ? 3 : 4;
    for (var i = 0; i < count; i++) pool.push(k);
  });
  // Shuffle
  for (var i = pool.length - 1; i > 0; i--) {
    var j = Math.floor(Math.random() * (i + 1));var _ref =
    [pool[j], pool[i]];pool[i] = _ref[0];pool[j] = _ref[1];
  }

  pool.forEach(function (key, i) {
