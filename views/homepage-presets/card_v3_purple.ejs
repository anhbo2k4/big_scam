        c, "\" opacity=\".85\"/>\n      <!-- nose + mouth -->\n      <polygon points=\"20,16.5 18.5,18 21.5,18\" fill=\"").concat(

        c, "\" opacity=\".6\"/>\n      <path d=\"M18.5 18 Q17 20 15 19.5 M21.5 18 Q23 20 25 19.5\" fill=\"none\" stroke=\"").concat(
        c, "\" stroke-width=\".9\" stroke-linecap=\"round\"/>\n      <!-- whiskers -->\n      <line x1=\"8\"  y1=\"16\" x2=\"15\" y2=\"17\" stroke=\"").concat(

        c, "\" stroke-width=\".8\" opacity=\".5\"/>\n      <line x1=\"8\"  y1=\"18\" x2=\"15\" y2=\"18\" stroke=\"").concat(
        c, "\" stroke-width=\".8\" opacity=\".4\"/>\n      <line x1=\"25\" y1=\"17\" x2=\"32\" y2=\"16\" stroke=\"").concat(
        c, "\" stroke-width=\".8\" opacity=\".5\"/>\n      <line x1=\"25\" y1=\"18\" x2=\"32\" y2=\"18\" stroke=\"").concat(
