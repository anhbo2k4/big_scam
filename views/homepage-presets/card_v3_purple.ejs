        c, "\" fill-opacity=\".22\" stroke=\"").concat(c, "\" stroke-width=\"1.3\"/>\n      <!-- ears -->\n      <ellipse cx=\"13\" cy=\"10\" rx=\"3.5\" ry=\"5\" fill=\"").concat(

        c, "\" fill-opacity=\".3\" stroke=\"").concat(c, "\" stroke-width=\"1\" transform=\"rotate(-15 13 10)\"/>\n      <ellipse cx=\"27\" cy=\"10\" rx=\"3.5\" ry=\"5\" fill=\"").concat(
        c, "\" fill-opacity=\".3\" stroke=\"").concat(c, "\" stroke-width=\"1\" transform=\"rotate(15 27 10)\"/>\n      <!-- eyes -->\n      <circle cx=\"17\" cy=\"13\" r=\"1.2\" fill=\"").concat(

