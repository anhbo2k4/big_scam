/* ── Shapes ── */
(function () {
  var container = document.getElementById('shapes');

  var colors = ['#a78bfa', '#818cf8', '#c4b5fd', '#7dd3fc', '#93c5fd', '#ddd6fe', '#e879f9', '#f9a8d4', '#6ee7b7'];

  // SVG shape definitions (40x40 viewBox)
  var shapeDefs = {

    diamond: function diamond(c) {return "<svg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\">\n      <polygon points=\"20,2 38,20 20,38 2,20\" fill=\"".concat(
        c, "\" fill-opacity=\".18\" stroke=\"").concat(c, "\" stroke-width=\"1.5\"/>\n      <polygon points=\"20,9 31,20 20,31 9,20\" fill=\"").concat(
        c, "\" fill-opacity=\".1\" stroke=\"").concat(c, "\" stroke-width=\".7\"/>\n      <line x1=\"2\" y1=\"20\" x2=\"38\" y2=\"20\" stroke=\"").concat(
        c, "\" stroke-width=\".5\" opacity=\".4\"/>\n      <line x1=\"20\" y1=\"2\" x2=\"20\" y2=\"38\" stroke=\"").concat(
