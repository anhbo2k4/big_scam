    kitty: function kitty(c) {return "<svg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\">\n      <!-- body -->\n      <ellipse cx=\"20\" cy=\"27\" rx=\"10\" ry=\"8\" fill=\"".concat(

        c, "\" fill-opacity=\".2\" stroke=\"").concat(c, "\" stroke-width=\"1.3\"/>\n      <!-- head -->\n      <circle cx=\"20\" cy=\"14\" r=\"7\" fill=\"").concat(

        c, "\" fill-opacity=\".22\" stroke=\"").concat(c, "\" stroke-width=\"1.3\"/>\n      <!-- pointy ears -->\n      <polygon points=\"13,9 10,2 16,7\" fill=\"").concat(

        c, "\" fill-opacity=\".35\" stroke=\"").concat(c, "\" stroke-width=\"1\"/>\n      <polygon points=\"27,9 30,2 24,7\" fill=\"").concat(
        c, "\" fill-opacity=\".35\" stroke=\"").concat(c, "\" stroke-width=\"1\"/>\n      <!-- eyes (almond) -->\n      <ellipse cx=\"17\" cy=\"13\" rx=\"1.8\" ry=\"1.2\" fill=\"").concat(

