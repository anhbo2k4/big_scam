        c, "\" fill-opacity=\".28\" stroke=\"").concat(c, "\" stroke-width=\"1.4\"/>\n      <!-- ribbon vertical -->\n      <rect x=\"18\" y=\"13\" width=\"4\" height=\"23\" fill=\"").concat(

        c, "\" fill-opacity=\".45\"/>\n      <!-- ribbon horizontal on lid -->\n      <rect x=\"4\" y=\"15.5\" width=\"32\" height=\"2\" fill=\"").concat(

        c, "\" fill-opacity=\".45\"/>\n      <!-- bow left loop -->\n      <path d=\"M20 13 Q14 6 10 10 Q8 14 14 14 Z\" fill=\"").concat(

        c, "\" fill-opacity=\".5\" stroke=\"").concat(c, "\" stroke-width=\".9\"/>\n      <!-- bow right loop -->\n      <path d=\"M20 13 Q26 6 30 10 Q32 14 26 14 Z\" fill=\"").concat(

        c, "\" fill-opacity=\".5\" stroke=\"").concat(c, "\" stroke-width=\".9\"/>\n      <!-- shine -->\n      <line x1=\"9\" y1=\"22\" x2=\"9\" y2=\"30\" stroke=\"").concat(

