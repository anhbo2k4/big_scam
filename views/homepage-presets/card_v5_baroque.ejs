<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Background</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=IM+Fell+English:ital@0;1&family=Uncial+Antiqua&family=Cinzel:wght@400;600;700;900&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IM+Fell+English:ital@0;1&family=Uncial+Antiqua&family=Cinzel:wght@400;600;700;900&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap"></noscript>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; }
    body { background: #02060e; font-family: Georgia, serif; overflow: hidden; }
    #root { height: 100%; }

    .min-h-screen {
      min-height: 100vh;
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }

    .overlay-gradient {
      position: absolute; inset: 0;
      background-image: linear-gradient(to top right, var(--tw-gradient-stops));
      --tw-gradient-from: rgb(30 27 75 / 0.8);
      --tw-gradient-via: rgb(46 16 101 / 0.6);
      --tw-gradient-to: rgb(2 6 23 / 0.9);
      --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-via), var(--tw-gradient-to);
    }

    .orb {
      position: absolute; border-radius: 50%;
      filter: blur(90px); opacity: .28; pointer-events: none;
      animation: orb-drift var(--dur) ease-in-out infinite alternate;
      animation-delay: var(--delay, 0s);
    }
    .orb1 { width:520px; height:520px; background:radial-gradient(circle,#6d28d9,transparent 70%); top:-140px; left:-100px; --dur:14s; }
    .orb2 { width:400px; height:400px; background:radial-gradient(circle,#4f46e5,transparent 70%); bottom:-80px; right:40px; --dur:18s; --delay:-6s; }
    .orb3 { width:260px; height:260px; background:radial-gradient(circle,#7c3aed,transparent 70%); top:50%; left:50%; transform:translate(-50%,-50%); --dur:10s; --delay:-3s; }

    .blobs { position:absolute; inset:0; pointer-events:none; }
    .blob {
      position:absolute; border-radius:50%; pointer-events:none;
      animation: blob-float var(--bd) ease-in-out infinite alternate;
      animation-delay: var(--bdelay, 0s);
    }

    .grid-lines {
      position:absolute; inset:0; pointer-events:none;
      background-image:
        linear-gradient(rgba(139,92,246,.05) 1px, transparent 1px),
        linear-gradient(90deg,rgba(139,92,246,.05) 1px, transparent 1px);
      background-size: 56px 56px;
    }

    .stars { position:absolute; inset:0; pointer-events:none; }
    .star {
      position:absolute; border-radius:50%; background:#fff;
      animation: twinkle var(--d) ease-in-out infinite alternate;
      animation-delay: var(--sd, 0s); opacity: var(--o);
    }

    .shapes { position:absolute; inset:0; pointer-events:none; overflow:hidden; }
    .shape {
      position: absolute;
      animation: shape-float var(--sf-dur) ease-in-out infinite alternate;
      animation-delay: var(--s-delay, 0s);
      opacity: var(--s-op, 0.6);
      filter: drop-shadow(0 0 6px var(--s-color, rgba(167,139,250,0.6)));
    }

    .noise {
      position:absolute; inset:0; pointer-events:none; opacity:.14;
      background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.05'/%3E%3C/svg%3E");
    }

    /* Google Fonts loaded via preload below */

    /* ── Card wrapper ── */
    .card-wrapper {
      position:relative; z-index:10;
      width:100%; max-width:30rem;
      animation: parchment-in 1.2s cubic-bezier(.22,1,.36,1) both;
    }
    @keyframes parchment-in {
      from { opacity:0; transform:translateY(32px) scale(.95); filter:sepia(.5) blur(4px); }
      to   { opacity:1; transform:translateY(0) scale(1); filter:sepia(0) blur(0); }
    }

    /* ── Decorative outer corners ── */
    .corner { position:absolute; width:52px; height:52px; z-index:20; pointer-events:none; }
    .corner svg { width:100%; height:100%; }
    .corner-tl { top:-4px; left:-4px; }
    .corner-tr { top:-4px; right:-4px; transform:scaleX(-1); }
    .corner-bl { bottom:-4px; left:-4px; transform:scaleY(-1); }
    .corner-br { bottom:-4px; right:-4px; transform:scale(-1,-1); }

    /* ── Card ── */
    .card {
      background:
        radial-gradient(ellipse 80% 60% at 50% 0%,  rgba(90,20,10,.55) 0%, transparent 65%),
        radial-gradient(ellipse 60% 50% at 50% 100%, rgba(60,30,5,.4) 0%, transparent 65%),
        linear-gradient(170deg, rgba(22,10,8,.97) 0%, rgba(35,15,8,.96) 40%, rgba(18,10,5,.98) 100%);
      border:1px solid rgba(180,130,50,.35);
      border-radius:6px;
      overflow:hidden;
      box-shadow:
        0 0 0 3px rgba(14,8,4,.95),
        0 0 0 4px rgba(140,90,30,.25),
        0 32px 72px rgba(0,0,0,.9),
        0 0 60px rgba(140,60,20,.15),
        inset 0 1px 0 rgba(220,170,80,.12);
      transition:box-shadow .5s;
    }
    .card:hover {
      box-shadow:
        0 0 0 3px rgba(14,8,4,.95),
        0 0 0 4px rgba(180,120,40,.35),
        0 40px 90px rgba(0,0,0,.95),
        0 0 80px rgba(160,80,20,.2),
        inset 0 1px 0 rgba(220,170,80,.18);
    }

    /* ── Top ornament bar ── */
    .ornament-bar {
      height:6px;
      background: linear-gradient(90deg,
        transparent 0%,
        rgba(160,100,20,.4) 8%,
        rgba(200,150,50,.8) 25%,
        rgba(220,170,70,.95) 50%,
        rgba(200,150,50,.8) 75%,
        rgba(160,100,20,.4) 92%,
        transparent 100%);
      box-shadow:0 0 12px rgba(200,140,40,.35), 0 0 24px rgba(180,100,20,.15);
    }

    /* ── Header ── */
    .card-header {
      position:relative; overflow:hidden;
      padding:30px 28px 26px; text-align:center;
      background:
        radial-gradient(ellipse 90% 70% at 50% -10%, rgba(80,20,5,.7) 0%, transparent 65%),
        linear-gradient(180deg, rgba(28,10,6,.99) 0%, rgba(22,10,5,.97) 100%);
    }
    /* Subtle texture lines */
    .card-header::before {
      content:''; position:absolute; inset:0; pointer-events:none;
      background-image:
        repeating-linear-gradient(0deg, transparent, transparent 32px, rgba(180,120,40,.025) 32px, rgba(180,120,40,.025) 33px);
    }
    /* Bottom ornament divider */
    .card-header::after {
      content:''; position:absolute; bottom:0; left:0; right:0; height:1px;
      background:linear-gradient(90deg, transparent 0%, rgba(180,120,40,.2) 15%, rgba(220,160,60,.7) 40%, rgba(240,190,80,.9) 50%, rgba(220,160,60,.7) 60%, rgba(180,120,40,.2) 85%, transparent 100%);
    }

    /* ── Gift icon ── */
    .gift-icon-wrap {
      display:inline-flex; justify-content:center;
      margin-bottom:20px; position:relative; z-index:2;
    }
    .gift-icon-glow {
      position:absolute; inset:-20px; border-radius:50%;
      background:radial-gradient(circle, rgba(200,130,40,.45) 0%, rgba(160,80,20,.2) 50%, transparent 70%);
      filter:blur(14px);
      animation:flame-breathe 3s ease-in-out infinite alternate;
    }
    @keyframes flame-breathe {
      from { opacity:.5; transform:scale(.88); }
      to   { opacity:1;  transform:scale(1.12); }
    }
    .gift-icon-box {
      position:relative; z-index:2;
      background:linear-gradient(145deg, rgba(35,15,5,.98), rgba(50,22,8,.96));
      border:1px solid rgba(180,120,40,.5);
      padding:18px; border-radius:8px;
      box-shadow:
        0 0 0 1px rgba(100,60,10,.4),
        0 0 20px rgba(180,100,30,.3),
        0 8px 32px rgba(0,0,0,.7),
        inset 0 1px 0 rgba(220,160,60,.2),
        inset 0 -1px 0 rgba(0,0,0,.4);
      transition:transform .45s cubic-bezier(.34,1.56,.64,1), box-shadow .45s;
    }
    .gift-icon-box:hover {
      transform:scale(1.08) translateY(-3px);
      box-shadow:
        0 0 0 1px rgba(180,130,50,.5),
        0 0 30px rgba(200,120,40,.4),
        0 16px 40px rgba(0,0,0,.8),
        inset 0 1px 0 rgba(240,180,70,.25);
    }
    .gift-icon-box svg { width:56px; height:56px; color:#d4a04a; display:block; filter:drop-shadow(0 0 8px rgba(200,130,40,.6)); }

    .sparkle-badge {
      position:absolute; top:-8px; right:-8px; z-index:3;
      width:20px; height:20px;
      animation:spin-slow 8s linear infinite;
      filter:drop-shadow(0 0 4px rgba(220,170,60,.8));
    }
    @keyframes spin-slow { to { transform:rotate(360deg); } }

    .ping-dot {
      position:absolute; bottom:-5px; left:-5px; z-index:3;
      width:11px; height:11px; border-radius:50%;
      background:radial-gradient(circle, #e8b84b, #b8722a);
      box-shadow:0 0 8px rgba(220,160,50,.9);
    }
    .ping-dot::before {
      content:''; position:absolute; inset:0; border-radius:50%;
      background:#d4a040; animation:ping 2s cubic-bezier(0,0,.2,1) infinite;
    }
    @keyframes ping { 75%,100%{transform:scale(2.4);opacity:0} }

    /* ── Seal badge ── */
    .seal-badge {
      display:inline-flex; align-items:center; gap:6px;
      border:1px solid rgba(180,120,40,.3);
      border-radius:3px; padding:4px 12px; margin-bottom:16px;
      background:rgba(180,100,20,.06);
      position:relative; z-index:2;
    }
    .seal-badge .seal-dot {
      width:6px; height:6px; border-radius:50%;
      background:#d4a040; box-shadow:0 0 6px rgba(212,160,64,.9);
      animation:pulse-slow 2.5s ease-in-out infinite alternate;
    }
    .seal-badge span {
      font-family:'Lora',serif; font-style:italic;
      font-size:11.5px; color:rgba(212,170,80,.75); letter-spacing:.05em;
    }

    /* ── Title ── */
    .card-title {
      font-family:'Cinzel',serif;
      font-size:clamp(1.4rem,3.8vw,1.9rem);
      font-weight:900; letter-spacing:.08em; text-transform:uppercase;
      background:linear-gradient(160deg, #f5e0a0 0%, #d4a040 30%, #e8c870 55%, #fff8dc 75%, #c8902a 100%);
      -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;
      margin-bottom:10px; line-height:1.2;
      filter:drop-shadow(0 2px 12px rgba(200,130,30,.4));
      position:relative; z-index:2;
    }
    .card-subtitle {
      font-family:'Lora',serif; font-style:italic;
      font-size:13.5px; color:rgba(210,170,90,.65); line-height:1.7;
      padding:0 10px; position:relative; z-index:2;
    }

    /* ── Ornament divider (decorative) ── */
    .ornament-divider {
      display:flex; align-items:center; gap:10px;
      margin:0 0 8px; position:relative; z-index:2;
    }
    .ornament-divider .od-line {
      flex:1; height:1px;
      background:linear-gradient(90deg, transparent, rgba(180,120,40,.4));
    }
    .ornament-divider .od-line.right { background:linear-gradient(90deg, rgba(180,120,40,.4), transparent); }
    .ornament-divider .od-symbol { font-size:14px; color:rgba(200,140,50,.6); line-height:1; }

    /* ── Card body ── */
    .card-body {
      padding:22px 26px 20px;
      background:
        radial-gradient(ellipse 80% 60% at 50% 100%, rgba(50,20,5,.5) 0%, transparent 65%),
        rgba(16,8,4,.95);
    }

    /* ── Stats ── */
    .stats-row {
      display:grid; grid-template-columns:repeat(3,1fr);
      gap:8px; margin-bottom:20px;
    }
    .stat-tile {
      background:rgba(180,100,20,.06);
      border:1px solid rgba(160,100,30,.2);
      border-radius:4px; padding:11px 6px 10px; text-align:center;
      position:relative; overflow:hidden;
      transition:border-color .25s, background .25s;
    }
    .stat-tile::before {
      content:''; position:absolute; top:0; left:0; right:0; height:1px;
      background:linear-gradient(90deg,transparent,rgba(200,140,50,.5),transparent);
    }
    .stat-tile:hover { border-color:rgba(200,140,50,.4); background:rgba(180,100,20,.1); }
    .stat-tile .s-num {
      font-family:'Cinzel',serif; font-size:16px; font-weight:700;
      background:linear-gradient(135deg,#f0d080,#c88030);
      -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;
      display:block; line-height:1;
    }
    .stat-tile .s-lbl {
      font-family:'Lora',serif; font-style:italic;
      font-size:10px; color:rgba(200,150,60,.5); letter-spacing:.04em;
      margin-top:4px; display:block;
    }

    /* ── Input ── */
    .input-label {
      display:flex; align-items:center; gap:7px;
      font-family:'Cinzel',serif; font-size:11px; font-weight:600;
      letter-spacing:.12em; text-transform:uppercase;
      color:rgba(200,150,60,.6); margin-bottom:9px;
    }
    .input-group { position:relative; margin-bottom:16px; }
    .input-glow {
      position:absolute; inset:-2px; border-radius:6px;
      background:linear-gradient(135deg,rgba(200,130,40,.35),rgba(160,90,20,.3));
      opacity:0; transition:opacity .35s; pointer-events:none; filter:blur(5px);
    }
    .input-group:focus-within .input-glow { opacity:1; }
    .card-input {
      width:100%; height:54px;
      background:linear-gradient(135deg, rgba(255,245,220,.96), rgba(250,235,200,.94));
      border:1px solid rgba(160,100,30,.45);
      border-radius:4px;
      font-family:'IM Fell English',serif; font-style:italic;
      font-size:22px; font-weight:400;
      letter-spacing:.25em; color:#5a3010; text-align:center;
      padding:0 16px; outline:none;
      transition:border-color .3s, box-shadow .3s;
      position:relative; z-index:1;
      box-shadow:inset 0 2px 6px rgba(100,50,10,.1);
    }
    .card-input::placeholder {
      color:rgba(120,80,30,.35); font-size:13px; letter-spacing:.06em; font-style:italic;
    }
    .card-input:focus {
      border-color:rgba(200,130,40,.7);
      box-shadow:0 0 0 2px rgba(180,110,30,.18), 0 0 16px rgba(180,100,20,.15), inset 0 2px 6px rgba(100,50,10,.08);
    }

    /* ── CTA Button ── */
    .card-btn {
      width:100%; height:52px;
      background:linear-gradient(160deg, #6b2010, #8b2a10, #a03515, #7a2010, #5a1a08);
      background-size:250% 100%;
      border:1px solid rgba(200,100,30,.45);
      border-radius:4px;
      color:#f5dfa0;
      font-family:'Cinzel',serif; font-size:13px; font-weight:700; letter-spacing:.1em; text-transform:uppercase;
      cursor:pointer; position:relative; overflow:hidden;
      box-shadow:
        0 8px 28px rgba(80,20,5,.6),
        0 0 20px rgba(160,60,20,.2),
        inset 0 1px 0 rgba(255,200,100,.15),
        inset 0 -2px 0 rgba(0,0,0,.35);
      transition:all .4s cubic-bezier(.22,1,.36,1);
      display:flex; align-items:center; justify-content:center; gap:10px;
      animation:btn-ember 4s ease-in-out infinite;
    }
    @keyframes btn-ember {
      0%,100% { background-position:0% 0; box-shadow:0 8px 28px rgba(80,20,5,.6),0 0 20px rgba(160,60,20,.2),inset 0 1px 0 rgba(255,200,100,.15),inset 0 -2px 0 rgba(0,0,0,.35); }
      50% { background-position:100% 0; box-shadow:0 8px 28px rgba(100,25,5,.7),0 0 30px rgba(180,70,20,.3),inset 0 1px 0 rgba(255,210,110,.2),inset 0 -2px 0 rgba(0,0,0,.35); }
    }
    .card-btn::before {
      content:''; position:absolute; inset:0;
      background:linear-gradient(110deg,transparent 35%,rgba(255,200,100,.12) 50%,transparent 65%);
      transform:translateX(-130%);
      transition:transform .65s cubic-bezier(.22,1,.36,1);
    }
    .card-btn:hover::before { transform:translateX(130%); }
    .card-btn:hover {
      transform:translateY(-2px);
      border-color:rgba(220,130,50,.6);
      box-shadow:0 14px 40px rgba(100,25,5,.75),0 0 40px rgba(180,70,20,.3),inset 0 1px 0 rgba(255,210,110,.2);
      color:#fcefc0;
    }
    .card-btn:active { transform:translateY(0); }
    .card-btn:disabled {
      opacity:.35; cursor:not-allowed; transform:none; animation:none;
      box-shadow:0 4px 12px rgba(0,0,0,.4);
    }

    /* ── Divider ── */
    .card-divider {
      border:none; height:1px;
      background:linear-gradient(90deg,transparent,rgba(180,120,40,.25),rgba(160,100,30,.2),transparent);
      margin:18px 0;
    }

    /* ── Reward grid ── */
    .reward-label {
      font-family:'Lora',serif; font-style:italic;
      font-size:11px; color:rgba(180,130,50,.45);
      text-align:center; margin-bottom:10px; letter-spacing:.05em;
    }
    .reward-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
    .reward-card {
      position:relative; overflow:hidden; padding:14px 6px 11px;
      border-radius:4px; text-align:center; border:1px solid;
      transition:transform .3s cubic-bezier(.34,1.56,.64,1), box-shadow .3s;
      cursor:default;
    }
    .reward-card::after {
      content:''; position:absolute; top:0; left:0; right:0; height:1px;
      background:linear-gradient(90deg,transparent,rgba(255,255,255,.12),transparent);
    }
    .reward-card:hover { transform:translateY(-4px) scale(1.04); }
    .reward-card .r-icon { font-size:26px; margin-bottom:5px; display:block; }
    .reward-card .r-label { font-family:'Cinzel',serif; font-size:9.5px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; margin-bottom:2px; }
    .reward-card .r-sub   { font-family:'Lora',serif; font-style:italic; font-size:9.5px; opacity:.55; }
    .reward-vip {
      background:linear-gradient(155deg,rgba(200,140,30,.14),rgba(160,100,15,.07));
      border-color:rgba(200,140,40,.32); box-shadow:0 4px 16px rgba(160,100,20,.1);
    }
    .reward-vip .r-label { color:#e8c060; } .reward-vip .r-sub { color:#c8a040; }
    .reward-lucky {
      background:linear-gradient(155deg,rgba(140,90,160,.14),rgba(100,60,120,.07));
      border-color:rgba(160,100,180,.28); box-shadow:0 4px 16px rgba(120,70,140,.1);
    }
    .reward-lucky .r-label { color:#d4a0e8; } .reward-lucky .r-sub { color:#b880cc; }
    .reward-try {
      background:linear-gradient(155deg,rgba(80,55,35,.18),rgba(60,40,25,.1));
      border-color:rgba(120,80,40,.25);
    }
    .reward-try .r-label { color:#c0a070; } .reward-try .r-sub { color:#9a7850; }

    /* ── Trust bar ── */
    .trust-bar {
      display:flex; margin-top:16px;
      border:1px solid rgba(160,100,30,.18); border-radius:4px; overflow:hidden;
      background:rgba(160,80,10,.04);
    }
    .trust-item {
      flex:1; display:flex; align-items:center; justify-content:center; gap:5px;
      padding:8px 4px;
      font-family:'Lora',serif; font-size:10.5px;
      color:rgba(190,140,60,.65); letter-spacing:.02em;
      border-right:1px solid rgba(160,100,30,.12);
    }
    .trust-item:last-child { border-right:none; }

    /* ── Tagline ── */
    .tagline-wrap {
      text-align:center; margin-top:14px;
      animation:parchment-in .8s .6s ease-out both;
    }
    .tagline-pill {
      display:inline-flex; align-items:center; gap:8px;
      background:rgba(16,8,4,.9);
      border:1px solid rgba(160,100,30,.25);
      backdrop-filter:blur(12px);
      padding:9px 22px; border-radius:4px;
      box-shadow:0 8px 28px rgba(0,0,0,.5), 0 0 16px rgba(140,80,20,.08);
    }
    .tagline-dot {
      width:6px; height:6px; border-radius:50%;
      background:radial-gradient(circle,#e8b840,#a06020);
      box-shadow:0 0 8px rgba(220,160,50,.8);
      animation:pulse-slow 2.5s ease-in-out infinite alternate;
    }
    .tagline-pill span {
      font-family:'Lora',serif; font-style:italic;
      font-size:12.5px; color:rgba(200,160,70,.75); letter-spacing:.03em;
    }

    @keyframes ticker-run { from{transform:translateX(0)} to{transform:translateX(-50%)} }
    @keyframes pulse-slow { from{opacity:.5;transform:scale(1)} to{opacity:1;transform:scale(1.3)} }

    @keyframes orb-drift {
      from { transform:translate(0,0) scale(1); }
      to   { transform:translate(38px,26px) scale(1.1); }
    }
    @keyframes blob-float {
      from { transform:translate(0,0); }
      to   { transform:translate(var(--bx,20px), var(--by,-30px)); }
    }
    @keyframes twinkle {
      from { opacity:var(--o); transform:scale(1); }
      to   { opacity:calc(var(--o)*.2); transform:scale(.5); }
    }
    @keyframes shape-float {
      0%   { transform: translateY(0px) rotate(var(--r0,0deg)); }
      100% { transform: translateY(var(--float-y,-24px)) rotate(var(--r1,15deg)); }
    }
  </style>
</head>
<body>
<div id="root">
  <div class="min-h-screen">

    <div class="overlay-gradient"></div>
