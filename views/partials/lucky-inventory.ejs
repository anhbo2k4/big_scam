<!-- INVENTORY PAGE -->
<div id="page-inventory" class="page">
  <div class="page-content">
    <button class="back-btn" onclick="goBack()">← Quay lại</button>
    <div class="page-title-row">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z" stroke="url(#inv1)" stroke-width="2" stroke-linejoin="round"/><defs><linearGradient id="inv1" x1="3" y1="3" x2="21" y2="21"><stop stop-color="#a855f7"/><stop offset="1" stop-color="#22d3ee"/></linearGradient></defs></svg>
