  </div>
  </div>

  <!-- Mobile Menu Overlay (Hidden by Default) -->
  <div class="navbar-mobile-menu" id="navbarMobileMenu">
    <button onclick="goToBoxSelection(); closeNavbarMenu()" class="mobile-menu-item">
      <svg width="20" height="20" fill="none" viewBox="0 0 24 24"><path d="M4 7h16M4 12h12M4 17h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M17 14l3 3-3 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>Quay lại phiên chơi</span>
    </button>
    <button onclick="goHome(); closeNavbarMenu()" class="mobile-menu-item">
      <svg width="20" height="20" fill="none" viewBox="0 0 24 24"><path d="M3 12L12 3L21 12V21H15V15H9V21H3V12Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
      <span>Trang chủ</span>
    </button>
    <button onclick="showPage('search'); closeNavbarMenu()" class="mobile-menu-item">
      <svg width="20" height="20" fill="none" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"/><path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <span>Tra cứu</span>
    </button>
    <button onclick="showPage('inventory'); closeNavbarMenu()" class="mobile-menu-item">
      <svg width="20" height="20" fill="none" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><polyline points="3.27 6.96 12 12.01 20.73 6.96" stroke="currentColor" stroke-width="2"/><line x1="12" y1="22.08" x2="12" y2="12" stroke="currentColor" stroke-width="2"/></svg>
      <span>Kho vật phẩm</span>
    </button>
    <button onclick="showPage('exchange'); closeNavbarMenu()" class="mobile-menu-item">
      <svg width="20" height="20" fill="none" viewBox="0 0 24 24"><path d="M7 16V4m0 0L3 8m4-4l4 4M17 8v12m0 0l4-4m-4 4l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>Đổi quà</span>
    </button>
    <button onclick="showPage('wallet'); closeNavbarMenu()" class="mobile-menu-item">
      <svg width="20" height="20" fill="none" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2" stroke="currentColor" stroke-width="2"/><path d="M16 14a1 1 0 100-2 1 1 0 000 2z" fill="currentColor"/><path d="M22 11V7a2 2 0 00-2-2H4a2 2 0 00-2 2v4" stroke="currentColor" stroke-width="2"/></svg>
      <span>Ví tiền</span>
    </button>
    <button onclick="toggleUserTheme(); closeNavbarMenu()" class="mobile-menu-item" id="userThemeToggleMobile" type="button">
      <svg width="20" height="20" fill="none" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1111.2 3 7 7 0 0021 12.8z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span id="userThemeToggleMobileText">Chế độ sáng</span>
    </button>
  </div>

  <!-- Close Mobile Menu on Route Change -->
  <script>
function toggleNavbarMenu() {
  var menu = document.getElementById('navbarMobileMenu');
  var hamburger = document.getElementById('navbarHamburger');
  menu.classList.toggle('active');
  hamburger.classList.toggle('active');
  event.stopPropagation();
}
function closeNavbarMenu() {
  var menu = document.getElementById('navbarMobileMenu');
  var hamburger = document.getElementById('navbarHamburger');
  menu.classList.remove('active');
  hamburger.classList.remove('active');
}
// Close menu on window resize to desktop
window.addEventListener('resize', function () {
  if (window.innerWidth >= 768) {
    closeNavbarMenu();
  }
});
// Close menu on click outside (but NOT on menu items or hamburger)
document.addEventListener('click', function (e) {
  var navbar = document.querySelector('.navbar');
  var menu = document.getElementById('navbarMobileMenu');
  var hamburger = document.getElementById('navbarHamburger');

  if (menu && menu.classList.contains('active')) {
    // Don't close if clicking hamburger or menu itself
    if (e.target === hamburger || hamburger.contains(e.target)) {
      return;
    }
    // Close if clicking outside navbar and menu
    if (!navbar.contains(e.target) && !menu.contains(e.target)) {
      closeNavbarMenu();
    }
  }
});</script>
</nav>
