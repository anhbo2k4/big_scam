<!-- OPENING ANIMATION PAGE -->
<div id="page-opening" class="page" style="background:#000">
  <div class="opening-scene">
    <div class="opening-particle p1"></div>
    <div class="opening-particle p2"></div>
    <div class="opening-particle p3"></div>
    <div class="opening-particle p4"></div>

    <div class="opening-spark s1"></div>
    <div class="opening-spark s2"></div>
    <div class="opening-spark s3"></div>
    <div class="opening-spark s4"></div>

    <div class="opening-glow"></div>
    <div class="opening-beam" aria-hidden="true"></div>
    <div class="opening-shockwave" aria-hidden="true"></div>
    <div class="opening-flash" aria-hidden="true"></div>

    <div class="opening-icon" id="openingGiftBox" aria-hidden="true">
      <div class="gift-lid"></div>
      <div class="gift-ribbon-v"></div>
      <div class="gift-ribbon-h"></div>
      <div class="gift-body"></div>
    </div>

    <div class="opening-burst" aria-hidden="true"></div>
    <div class="opening-ring" aria-hidden="true"></div>
  </div>

  <div class="opening-meta">
    <div class="opening-box-label" id="openingBoxLabel">🎁 Hộp quà bí ẩn</div>
    <p class="opening-text" id="openingText">Đang mở hộp quà...</p>
    <div class="opening-dots" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
  </div>
</div>
