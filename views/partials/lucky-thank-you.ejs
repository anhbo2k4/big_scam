  </div>

  <div class="confirmation-card">
    <div class="confirmation-id">
      Mã xác nhận: <strong id="confirmationIdDisplay">#--</strong>
    </div>

    <div class="result-summary">
      <div class="summary-section" id="summaryPrizeSection">
        <div class="summary-title">📦 KẾT QUẢ QUAY SỐ</div>
        <div class="summary-item">
          <span class="summary-label">Phần thưởng:</span>
