        <div class="summary-title">👤 THÔNG TIN CÁ NHÂN</div>
        <div class="summary-item">
          <span class="summary-label">Họ tên:</span>
          <span class="summary-value" id="summaryNameDisplay">--</span>
        </div>
        <div class="summary-item">
          <span class="summary-label">Số ĐT:</span>
          <span class="summary-value" id="summaryPhoneDisplay">--</span>
        </div>
        <div class="summary-item" id="summaryEmailSection" style="display: none;">
          <span class="summary-label">Email:</span>
          <span class="summary-value" id="summaryEmailDisplay">--</span>
        </div>
      </div>

      <div class="summary-section" id="exchangeMethodSection" style="display: none;">
        <div class="summary-title">💼 HÌNH THỨC NHẬN PHẦN THƯỞNG</div>
        <div class="summary-item">
          <span class="summary-label">Phương thức:</span>
          <span class="summary-value" id="summaryMethodDisplay">--</span>
        </div>
        <div class="summary-item" id="summaryBankSection" style="display: none;">
          <span class="summary-label">Ngân hàng:</span>
          <span class="summary-value" id="summaryBankDisplay">--</span>
        </div>
        <div class="summary-item" id="summaryAccountSection" style="display: none;">
          <span class="summary-label">Số TK (ẩn):</span>
          <span class="summary-value" id="summaryAccountDisplay">****</span>
        </div>
        <div class="summary-item" id="summaryAddressSection" style="display: none;">
          <span class="summary-label">Địa chỉ giao:</span>
          <span class="summary-value" id="summaryAddressDisplay">--</span>
        </div>
      </div>
    </div>

    <div class="processing-info">
      <div class="processing-icon">⏱️</div>
      <div class="processing-title">Quá trình xử lý</div>
      <p class="processing-message" id="processingMessage">
         <strong>Hàng sẽ sớm được giao đến bạn!!</strong>.<br>
        Vui lòng nhắn cho nhân viên hỗ trợ để cập nhật đơn hàng!
      </p>
    </div>
  </div>

  <div class="action-buttons">
    <button class="btn-share" onclick="shareResult()">
      📲 Chia sẻ kết quả
    </button>
    <button class="btn-back-session" onclick="goToBoxSelection()">
      🎮 Quay lại phiên chơi
    </button>
    <button class="btn-back-home" onclick="backToHome()">
      🏠 Quay về trang chủ
    </button>
  </div>
</div>

