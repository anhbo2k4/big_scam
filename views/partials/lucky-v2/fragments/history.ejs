<div class="modal-ov" id="hubOv" onclick="if(event.target===this)closeHub()">
  <div class="mbox hub-box">
    <div class="mhdr">
      <div class="mhdr-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="8" width="18" height="13" rx="2"/><path d="M12 8V21M3 13h18"/></svg></div>
      <div><div class="mttl" id="hubTitle">Quản lý phiên</div><div class="mstl" id="hubSubtitle">Các chức năng đầy đủ theo mã phiên</div></div>
      <button class="mx" onclick="closeHub()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/></svg></button>
    </div>
    <div class="mbody">
      <div id="hubTabInventory" class="hub-tab" style="display:none;">
        <div class="hub-head-row">
          <div class="hub-chip"><span id="hubSessionCodeLabel">Mã phiên</span>: <span id="hubSessionCode">-</span></div>
          <button class="wbtn doi" id="hubRefreshInventoryBtn" type="button" onclick="refreshHubData()">Làm mới</button>
        </div>
        <div id="inventoryList" class="hub-list"></div>
      </div>

      <div id="hubTabExchange" class="hub-tab" style="display:none;">
        <div class="hub-head-row">
          <div class="hub-chip" id="hubExchangeDesc">Đổi quà/nhận quà theo từng hộp đã mở</div>
          <button class="wbtn doi" id="hubRefreshExchangeBtn" type="button" onclick="refreshHubData()">Làm mới</button>
        </div>
        <div id="exchangeList" class="hub-list"></div>
      </div>

      <div id="hubTabWallet" class="hub-tab" style="display:none;">
        <div class="hub-stats">
          <div class="hub-stat-card">
            <div class="hub-stat-label" id="hubWalletBalanceLabel">Số dư ví</div>
            <div class="hub-stat-value" id="hubWalletBalance">0</div>
          </div>
          <div class="hub-stat-card">
            <div class="hub-stat-label" id="hubPendingConversionLabel">Đang chờ duyệt quy đổi</div>
            <div class="hub-stat-value" id="hubPendingConversion">0</div>
          </div>
          <div class="hub-stat-card">
            <div class="hub-stat-label" id="hubTrustScoreLabel">Điểm tín nhiệm</div>
            <div class="hub-stat-value" id="hubTrustScore">--</div>
          </div>
        </div>
        <div id="hubUnifiedList" class="hub-list"></div>
      </div>

      <div id="hubTabSearch" class="hub-tab" style="display:none;">
        <div class="hub-head-row">
          <input class="fi" id="searchInput" type="text" placeholder="Nhập mã phiên cần tra cứu..." />
          <button class="wbtn rut" id="hubSearchButton" type="button" onclick="searchSession()">Tra cứu</button>
        </div>
        <div id="searchResult" class="hub-list"></div>
      </div>
    </div>
  </div>
</div>

<div class="modal-ov" id="sessionDetailOv" onclick="if(event.target===this)closeSessionDetailModal()">
  <div class="mbox session-detail-box">
    <div class="mhdr session-detail-hdr">
      <div class="mhdr-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M7 9h10M7 13h6" stroke-linecap="round"/></svg></div>
      <div>
        <div class="mttl" id="sessionDetailTitle">Chi tiết phiên chơi</div>
        <div class="mstl" id="sessionDetailSub">Tổng hợp đầy đủ hộp quà, ví, giao dịch và trạng thái xử lý</div>
      </div>
      <button class="mx" onclick="closeSessionDetailModal()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/></svg></button>
    </div>
    <div class="mbody session-detail-body" id="sessionDetailBody">
      <div class="session-detail-loading" id="sessionDetailLoadingText">Đang tải dữ liệu phiên...</div>
    </div>
  </div>
</div>

<div class="modal-ov" id="thankYouOv" onclick="if(event.target===this)closeThankYou()">
  <div class="mbox">
    <div class="mhdr">
      <div class="mhdr-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
      <div><div class="mttl" id="thankYouTitle">Cảm ơn bạn!</div><div class="mstl" id="thankYouSub">Yêu cầu của bạn đã được ghi nhận</div></div>
      <button class="mx" onclick="closeThankYou()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/></svg></button>
    </div>
    <div class="mbody">
      <div class="hub-card">
        <div class="hub-card-title" id="thankYouMethod">Phương thức: --</div>
        <div class="hub-card-meta" id="thankYouName">Người nhận: --</div>
        <div class="hub-card-meta" id="thankYouPhone">Điện thoại: --</div>
        <div class="hub-card-meta" id="thankYouDetail">Chi tiết: --</div>
      </div>
      <div class="modal-actions" style="margin-top:14px;">
        <button class="btn-cancel" id="thankYouCloseBtn" type="button" onclick="closeThankYou()">Đóng</button>
        <button class="btn-confirm-withdraw" id="thankYouViewTxBtn" type="button" onclick="openHub('wallet'); closeThankYou();">Xem giao dịch</button>
      </div>
    </div>
  </div>
</div>
