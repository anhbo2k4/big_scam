<div id="screen-game">
  <div class="game-theme-bg" id="gameThemeBg" aria-hidden="true">
    <iframe class="game-theme-bg-frame" id="gameThemeBgFrame" title="Nền giao diện người chơi" loading="eager"></iframe>
  </div>
  <nav class="g-nav">
    <div class="nav-brand">
      <div class="nav-icon-box">
        <picture>
          <source
            type="image/webp"
            srcset="/images/logo-64.webp 64w, /images/logo-96.webp 96w"
            sizes="32px"
          >
          <img
            src="/images/logo.png"
            srcset="/images/logo.png 1x"
            alt="<%= (typeof content !== 'undefined' && content && content.brandName) ? content.brandName : 'Logo thương hiệu' %>"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            width="32"
            height="32"
          >
        </picture>
      </div>
      <span class="nav-brand-name"><%= (typeof content !== 'undefined' && content && content.brandName) ? content.brandName : '' %></span>
    </div>
    <div class="nav-sess"><span id="navCode">DEMO</span><span class="dot-active"></span><span id="navCurrBadge" class="nav-curr-badge" style="display:none"></span></div>
    <button class="nav-home-btn" id="navHomeBtn" type="button" onclick="backToHome()">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 10.5 12 3l9 7.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 10v10h14V10" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span data-i18n="navHome">Về trang chủ</span>
    </button>
  </nav>

  <div id="lazyWalletModule" class="lmb-lazy-slot" data-lazy-fragment="wallet"></div>

  <div class="game-floating-feed" id="gameFloatingFeed" aria-live="polite" aria-label="Thông báo nhận thưởng gần đây"></div>

  <div class="stars" id="stars"></div>

  <div class="boxes-wrap">
    <div class="game-hero" aria-label="Giới thiệu trò chơi">
      <div class="game-hero-logo" role="img" aria-label="Game Logo">
        <picture>
          <source
            type="image/webp"
            srcset="/images/logo-96.webp 96w, /images/logo-128.webp 128w, /images/logo-160.webp 160w, /images/logo-192.webp 192w"
            sizes="(max-width: 768px) 104px, 154px"
          >
          <img
            src="/images/logo.png"
            alt="Game Logo"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            width="154"
            height="154"
          >
        </picture>
      </div>
      <h1 class="game-hero-title" data-i18n="heroTitle">Mở Hộp Quà</h1>
      <p class="game-hero-subtitle" id="gameHeroSubtitle" data-full-text="Chọn một hộp quà và khám phá phần thưởng bên trong!">Chọn một hộp quà và khám phá phần thưởng bên trong!</p>
    </div>
    <div class="scene boxes-row" id="boxesRow"></div>
  </div>

  <div class="win-ov" id="winOv">
    <div class="wov-modal">
      <div class="wov-header">
        <span class="wov-badge" id="winCongratsBadge" data-i18n="winCongrats">✨ CHÚC MỪNG!</span>
        <button class="wov-x" type="button" onclick="closeWin()">✕</button>
      </div>
      <div class="wov-sess-chip">Mã phiên: <span id="wSessionCode"></span></div>
      <div class="wcard">
        <div class="wem" id="wPrizeIcon">🎁</div>
        <div class="wname" id="wPrizeName">Tên giải thưởng</div>
        <div class="wcateg" id="wPrizeCategory"></div>
        <div class="wpreview-tags" id="wPreviewTags"></div>
        <div class="wpreview-meta" id="wPreviewMeta"></div>
        <div class="wlevel lucky" id="wLevelBadge">🎁 GIẢI THƯỞNG MAY MẮN!</div>
        <div class="wpreview-timeline" id="wPreviewTimeline"></div>
        <div id="wActionBox"></div>
      </div>
      <div class="wov-pro-actions">
        <button class="wsnap wsnap-download" id="winDownloadBtn" type="button" onclick="downloadCurrentPrizeImage()">🖼️ Tải ảnh phần quà</button>
        <button class="wsnap wsnap-capture" id="winCaptureBtn" type="button" onclick="captureResult()">📷 Chụp ảnh kết quả</button>
        <button class="wsnap wsnap-next" id="winOpenNextBtn" type="button" onclick="openNextAvailableBox()">Mở tiếp</button>
      </div>
      <div class="wthanks" id="winThanksText" data-i18n="winThanks">Cảm ơn Quý khách đã tham gia trò chơi!</div>
    </div>
  </div>

  <div class="loot-track-ov" id="lootTrackOv" aria-hidden="true">
    <div class="loot-track-mask">
      <div class="loot-track-center-line"></div>
      <div class="loot-track-strip" id="lootTrackStrip"></div>
    </div>
  </div>
  <!-- Prize image lightbox -->
  <div class="wov-lightbox" id="wovLightbox" onclick="closePrizeLightbox(event)">
    <div class="wov-lb-inner">
      <button class="wov-lb-close" type="button" onclick="closePrizeLightbox()">✕</button>
      <img class="wov-lb-img" id="wovLbImg" src="" alt="Phần thưởng" />
    </div>
  </div>

  <div class="celebrate-ov" id="celebrate" style="display:none">
    <div class="celebrate-backdrop"></div>
    <div class="celebrate-card" role="dialog" aria-modal="true" aria-label="Chuc mung nhan thuong">
      <div class="celebrate-media" id="celebrateMedia">
        <div class="celebrate-icon" id="celebrateIcon">🎁</div>
      </div>
      <div class="celebrate-rarity" id="celebrateRarity">LUCKY REWARD</div>
      <div class="celebrate-name" id="celebrateName">Phần thưởng</div>
      <div class="celebrate-value" id="celebrateValue">Quà hiện vật đặc biệt</div>
      <div class="celebrate-hint">Nhấn vào màn hình để đóng</div>

      <div class="celebrate-ring" id="celebrateCountdown">
        4
        <svg viewBox="0 0 40 40" aria-hidden="true">
          <circle cx="20" cy="20" r="15" class="celebrate-ring-bg"/>
          <circle cx="20" cy="20" r="15" id="celebrateCountdownCircle" class="celebrate-ring-fg"/>
        </svg>
      </div>
    </div>
  </div>

  <div id="lazyAdminStatusModule" class="lmb-lazy-slot" data-lazy-fragment="admin-status"></div>
  <div id="lazyHistoryModule" class="lmb-lazy-slot" data-lazy-fragment="history"></div>

  <div id="winNotiContainer"></div>

  <div class="toast" id="toast"></div>
</div>
