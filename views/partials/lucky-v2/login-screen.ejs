<!-- ═══════════════════════════════════════════════════════
     STYLES — scoped với prefix nhp- để không xung đột
═══════════════════════════════════════════════════════ -->
<style>
#screen-login.nhp-min-h-screen {
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
  overflow-y: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  background: #02060e;
  font-family: Georgia, serif;
}

/* ── Overlay & Orbs ── */
.nhp-overlay-gradient {
  position: absolute; inset: 0; pointer-events: none;
  background-image: linear-gradient(to top right,
    rgba(30,27,75,0.8),
    rgba(46,16,101,0.6),
    rgba(2,6,23,0.9));
}
.nhp-orb {
  position: absolute; border-radius: 50%;
  filter: blur(90px); opacity: .28; pointer-events: none;
  animation: nhp-orb-drift var(--dur) ease-in-out infinite alternate;
  animation-delay: var(--delay, 0s);
}
.nhp-orb1 { width:520px; height:520px; background:radial-gradient(circle,#6d28d9,transparent 70%); top:-140px; left:-100px; --dur:14s; }
.nhp-orb2 { width:400px; height:400px; background:radial-gradient(circle,#4f46e5,transparent 70%); bottom:-80px; right:40px; --dur:18s; --delay:-6s; }
.nhp-orb3 { width:260px; height:260px; background:radial-gradient(circle,#7c3aed,transparent 70%); top:50%; left:50%; transform:translate(-50%,-50%); --dur:10s; --delay:-3s; }

.nhp-blobs { position:absolute; inset:0; pointer-events:none; }
.nhp-glow-blobs { position:absolute; inset:0; pointer-events:none; }

/* ── Glow blobs to tròn mờ (kiểu ảnh) ── */
.nhp-glow-blob {
  position:absolute; border-radius:50%; pointer-events:none;
  filter: blur(var(--gb-blur, 60px));
  opacity: var(--gb-op, 0.22);
  background: var(--gb-color, radial-gradient(circle, #3b2d8a, transparent 70%));
  animation: nhp-gb-drift var(--gb-dur, 12s) ease-in-out infinite alternate;
  animation-delay: var(--gb-delay, 0s);
}
@keyframes nhp-gb-drift {
  from { transform: translate(0, 0) scale(1); }
  to   { transform: translate(var(--gb-tx, 20px), var(--gb-ty, -25px)) scale(var(--gb-sc, 1.08)); }
}

.nhp-stars { position:absolute; inset:0; pointer-events:none; }
.nhp-star {
  position:absolute; border-radius:50%; background:#fff;
  animation: nhp-twinkle var(--d) ease-in-out infinite alternate;
  animation-delay: var(--sd, 0s); opacity: var(--o);
}

.nhp-shapes { position:absolute; inset:0; pointer-events:none; overflow:hidden; }
.nhp-shape {
  position: absolute;
  animation: nhp-shape-float var(--sf-dur) ease-in-out infinite alternate;
  animation-delay: var(--s-delay, 0s);
  opacity: var(--s-op, 0.6);
  filter: drop-shadow(0 0 8px var(--s-color, rgba(167,139,250,0.7)));
}

/* ── Light streaks (vệt mờ) ── */
.nhp-streaks { position:absolute; inset:0; pointer-events:none; overflow:hidden; }
.nhp-streak {
  position:absolute;
  border-radius:999px;
  filter: blur(var(--sk-blur, 28px));
  opacity: var(--sk-op, 0.13);
  background: var(--sk-color, rgba(139,92,246,0.6));
  transform: rotate(var(--sk-rot, -35deg));
  animation: nhp-streak-pulse var(--sk-dur, 8s) ease-in-out infinite alternate;
  animation-delay: var(--sk-delay, 0s);
}
@keyframes nhp-streak-pulse {
  from { opacity: var(--sk-op); transform: rotate(var(--sk-rot)) scaleX(1); }
  to   { opacity: calc(var(--sk-op) * 0.4); transform: rotate(var(--sk-rot)) scaleX(1.15); }
}

.nhp-noise {
  position:absolute; inset:0; pointer-events:none; opacity:.14;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.05'/%3E%3C/svg%3E");
}

/* ── Card Wrapper ── */
.nhp-card-wrapper {
  position: relative; z-index: 10;
  width: 100%; max-width: 32rem;
  animation: nhp-scale-in 1s ease-out both;
  font-family: Inter, sans-serif;
}
@keyframes nhp-scale-in {
  from { opacity:0; transform:scale(.88) translateY(28px); }
  to   { opacity:1; transform:scale(1)  translateY(0px); }
}
@keyframes nhp-fade-in { from{opacity:0} to{opacity:1} }

/* ── Card ── */
.nhp-card {
  background: linear-gradient(135deg, rgba(15,10,40,.96) 0%, rgba(46,16,101,.92) 50%, rgba(20,18,40,.96) 100%);
  border: 2px solid rgba(139,92,246,.35);
  border-radius: 24px;
  overflow: hidden;
  box-shadow:
    0 25px 50px -12px rgba(139,92,246,.45),
    0 0 60px rgba(167,139,250,.2),
    inset 0 1px 0 rgba(255,255,255,.08);
  transition: transform .4s cubic-bezier(.4,0,.2,1), box-shadow .4s cubic-bezier(.4,0,.2,1);
}
.nhp-card:hover {
  transform: scale(1.018) translateY(-3px);
  box-shadow:
    0 35px 65px -12px rgba(139,92,246,.6),
    0 0 80px rgba(167,139,250,.35),
    inset 0 1px 0 rgba(255,255,255,.1);
}

.nhp-card-shimmer {
  height: 2px;
  background: linear-gradient(90deg, transparent, #a78bfa, #818cf8, #a78bfa, transparent);
  background-size: 200% 100%;
  animation: nhp-shimmer 3s linear infinite;
}
@keyframes nhp-shimmer {
  0%   { background-position: -200% 0; }
  100% { background-position:  200% 0; }
}

/* ── Card Header ── */
.nhp-card-header {
  background: linear-gradient(135deg, rgba(30,10,70,.85) 0%, rgba(55,20,110,.75) 50%, rgba(10,8,30,.9) 100%);
  padding: 32px 28px 28px;
  text-align: center;
  position: relative;
}
.nhp-card-header::after {
  content:'';
  position:absolute; bottom:0; left:50%; transform:translateX(-50%);
  width:60%; height:1px;
  background:linear-gradient(90deg,transparent,rgba(167,139,250,.4),transparent);
}

.nhp-deco-blob {
  position:absolute; border-radius:50%; pointer-events:none;
  animation: nhp-pulse-slow 3s ease-in-out infinite alternate;
}
.nhp-deco-blob-1 { width:36px; height:36px; top:12px; left:16px; background:radial-gradient(circle,rgba(167,139,250,.25),transparent 70%); filter:blur(6px); }
.nhp-deco-blob-2 { width:20px; height:20px; top:24px; right:24px; background:radial-gradient(circle,rgba(96,165,250,.3),transparent 70%); filter:blur(4px); animation-delay:.5s; }
@keyframes nhp-pulse-slow { from{opacity:.5;transform:scale(1)} to{opacity:1;transform:scale(1.3)} }

/* Gift icon */
.nhp-gift-icon-wrap {
  display:inline-flex; justify-content:center; margin-bottom:24px;
  position:relative;
}
.nhp-gift-icon-glow {
  position:absolute; inset:-16px;
  background:radial-gradient(circle, rgba(139,92,246,.5) 0%, rgba(99,102,241,.3) 40%, transparent 70%);
  border-radius:50%; filter:blur(12px);
  animation: nhp-glow-pulse 2.5s ease-in-out infinite alternate;
}
@keyframes nhp-glow-pulse {
  from { opacity:.5; transform:scale(.9); }
  to   { opacity:1;  transform:scale(1.15); }
}
.nhp-gift-icon-box {
  position:relative; z-index:2;
  background:linear-gradient(135deg,#7c3aed,#6d28d9,#4338ca);
  padding:18px; border-radius:18px;
  box-shadow: 0 12px 30px rgba(109,40,217,.5), inset 0 1px 0 rgba(255,255,255,.2);
  transition: transform .4s cubic-bezier(.34,1.56,.64,1), box-shadow .4s;
}
.nhp-gift-icon-box:hover {
  transform: scale(1.12) rotateY(8deg);
  box-shadow: 0 20px 45px rgba(109,40,217,.7), inset 0 1px 0 rgba(255,255,255,.25);
}
.nhp-gift-icon-box svg:first-child { width:60px; height:60px; color:#fff; display:block; filter:drop-shadow(0 2px 8px rgba(0,0,0,.5)); }

.nhp-sparkle-badge {
  position:absolute; top:-6px; right:-6px; z-index:3;
  width:24px; height:24px;
  transform-origin:center;
  filter:drop-shadow(0 0 8px rgba(196,181,253,.85));
  animation:
    nhp-spin-slow 4.8s linear infinite,
    nhp-sparkle-blink 1.1s ease-in-out infinite alternate,
    nhp-sparkle-drift 2.4s ease-in-out infinite;
}
@keyframes nhp-spin-slow { to { transform:rotate(360deg); } }
@keyframes nhp-sparkle-blink {
  0% { opacity:.58; filter:drop-shadow(0 0 3px rgba(196,181,253,.5)); }
  100% { opacity:1; filter:drop-shadow(0 0 12px rgba(196,181,253,.95)); }
}
@keyframes nhp-sparkle-drift {
  0%,100% { margin-top:0; }
  50% { margin-top:-2px; }
}

.nhp-ping-dot {
  position:absolute; bottom:-4px; left:-4px; z-index:3;
  width:12px; height:12px; border-radius:50%;
  background:#a78bfa;
}
.nhp-ping-dot::before {
  content:''; position:absolute; inset:0; border-radius:50%;
  background:#a78bfa; animation:nhp-ping 1.5s cubic-bezier(0,0,.2,1) infinite;
}
@keyframes nhp-ping { 75%,100%{transform:scale(2.2);opacity:0} }

.nhp-card-title {
  font-size: clamp(1.6rem, 4vw, 2.2rem);
  font-weight: 800;
  letter-spacing: -.025em;
  background: linear-gradient(135deg, #e2d9f3 0%, #a78bfa 40%, #c4b5fd 70%, #818cf8 100%);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  margin-bottom: 10px;
  filter: drop-shadow(0 2px 12px rgba(139,92,246,.4));
}
.nhp-card-subtitle {
  font-size: 14px; font-weight: 500;
  color: rgba(196,181,253,.75);
  line-height: 1.6;
  padding: 0 16px;
}

/* ── Card Body ── */
.nhp-card-body {
  background: linear-gradient(135deg, rgba(20,15,45,.55) 0%, rgba(46,16,101,.3) 50%, rgba(15,10,35,.55) 100%);
  padding: 28px 28px 24px;
}

.nhp-input-label {
  display:block; font-size:13px; font-weight:600;
  color:rgba(196,181,253,.9); margin-bottom:10px; letter-spacing:.02em;
}
.nhp-input-group { position:relative; margin-bottom:18px; }
.nhp-input-glow {
  position:absolute; inset:0; border-radius:10px;
  background:linear-gradient(90deg,rgba(139,92,246,.2),rgba(99,102,241,.25),rgba(139,92,246,.2));
  opacity:0; transition:opacity .3s; pointer-events:none;
  filter:blur(4px);
}
.nhp-input-group:focus-within .nhp-input-glow { opacity:1; }
.nhp-card-input {
  width:100%; height:58px;
  background:linear-gradient(135deg,#fff,#f8f5ff);
  border:2px solid rgba(139,92,246,.45);
  border-radius:10px;
  font-size:22px; font-weight:800;
  font-family:'Courier New',monospace;
  letter-spacing:.25em;
  color:#5b21b6; text-align:center;
  padding:0 16px;
  outline:none;
  transition:border-color .3s, box-shadow .3s, background .3s;
  position:relative; z-index:1;
}
.nhp-card-input::placeholder { color:rgba(139,92,246,.45); font-weight:400; font-size:14px; letter-spacing:.05em; }
.nhp-card-input:focus {
  border-color:#7c3aed;
  background:linear-gradient(135deg,#fff,#f3f0ff);
  box-shadow:0 0 0 3px rgba(124,58,237,.2), 0 8px 24px rgba(109,40,217,.15);
}

.nhp-card-btn {
  width:100%; height:50px;
  background:linear-gradient(135deg,#7c3aed,#6d28d9,#4f46e5);
  background-size:200% 100%;
  border:1px solid rgba(167,139,250,.3);
  border-radius:10px;
  color:#fff; font-family:Inter,sans-serif;
  font-size:16px; font-weight:700;
  cursor:pointer; position:relative; overflow:hidden;
  box-shadow:0 10px 28px rgba(109,40,217,.45);
  transition:all .3s cubic-bezier(.4,0,.2,1);
  display:flex; align-items:center; justify-content:center; gap:8px;
}
.nhp-card-btn::before {
  content:'';
  position:absolute; inset:0;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.15),transparent);
  transform:translateX(-100%);
  transition:transform .5s;
}
.nhp-card-btn:hover::before { transform:translateX(100%); }
.nhp-card-btn:hover {
  transform:translateY(-2px) scale(1.01);
  box-shadow:0 16px 40px rgba(109,40,217,.65);
}
.nhp-card-btn:active { transform:translateY(0) scale(.99); }
.nhp-btn-top-shine {
  position:absolute; top:0; left:0; right:0; height:1px;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.45),transparent);
}

.nhp-card-divider {
  border:none; border-top:1px solid rgba(139,92,246,.25);
  margin:20px 0;
}

.nhp-hint-pill {
  display:inline-flex; align-items:center; gap:8px;
  background:linear-gradient(135deg,rgba(60,20,100,.65),rgba(80,30,130,.65));
  border:1px solid rgba(139,92,246,.3);
  backdrop-filter:blur(8px);
  padding:8px 18px; border-radius:99px;
  margin-bottom:16px;
}
.nhp-hint-pill span { font-size:13px; font-weight:500; color:rgba(221,214,254,.85); }
.nhp-hint-bounce { animation:nhp-bounce-sm 1.5s ease-in-out infinite; }
@keyframes nhp-bounce-sm { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-4px)} }

.nhp-reward-grid {
  display:grid; grid-template-columns:repeat(3,1fr); gap:10px;
}
.nhp-reward-card {
  padding:14px 8px;
  border-radius:12px;
  text-align:center;
  border:1px solid;
  backdrop-filter:blur(6px);
  transition:transform .2s, box-shadow .2s;
  cursor:default;
}
.nhp-reward-card:hover { transform:translateY(-3px) scale(1.04); }
.nhp-r-icon {
  font-size:26px; margin-bottom:6px; display:block;
  filter:drop-shadow(0 2px 6px rgba(0,0,0,.4));
  animation: nhp-icon-pop var(--pop-dur, 1.4s) cubic-bezier(.36,.07,.19,.97) infinite;
  animation-delay: var(--pop-delay, 0s);
  transform-origin: center bottom;
}
@keyframes nhp-icon-pop {
  0%,100% { transform: scale(1) translateY(0);   }
  30%     { transform: scale(1.28) translateY(-5px); }
  45%     { transform: scale(0.95) translateY(1px);  }
  60%     { transform: scale(1.1)  translateY(-2px); }
  75%     { transform: scale(1)    translateY(0);    }
}
.nhp-reward-vip   .nhp-r-icon { --pop-delay: 0s;    --pop-dur: 1.5s; }
.nhp-reward-lucky .nhp-r-icon { --pop-delay: 0.5s;  --pop-dur: 1.5s; }
.nhp-reward-try   .nhp-r-icon { --pop-delay: 1.0s;  --pop-dur: 1.5s; }
.nhp-r-label { font-size:11px; font-weight:700; letter-spacing:.05em; }
.nhp-reward-vip   { background:linear-gradient(135deg,rgba(234,179,8,.18),rgba(217,119,6,.18)); border-color:rgba(250,204,21,.35); }
.nhp-reward-vip   .nhp-r-label { color:#fde68a; }
.nhp-reward-lucky { background:linear-gradient(135deg,rgba(59,130,246,.18),rgba(6,182,212,.18)); border-color:rgba(96,165,250,.35); }
.nhp-reward-lucky .nhp-r-label { color:#bfdbfe; }
.nhp-reward-try   { background:linear-gradient(135deg,rgba(100,116,139,.18),rgba(71,85,105,.18)); border-color:rgba(148,163,184,.3); }
.nhp-reward-try   .nhp-r-label { color:#e2e8f0; }

.nhp-tagline-wrap {
  text-align:center; margin-top:20px;
  animation: nhp-fade-in .8s .5s ease-out both;
}
.nhp-tagline-pill {
  display:inline-flex; align-items:center; gap:8px;
  background:linear-gradient(135deg,rgba(55,20,100,.75),rgba(75,30,130,.75));
  border:1px solid rgba(139,92,246,.3);
  backdrop-filter:blur(12px);
  padding:9px 20px; border-radius:99px;
  box-shadow:0 8px 24px rgba(109,40,217,.3);
}
.nhp-tagline-dot {
  width:8px; height:8px; border-radius:50%; background:#a78bfa;
  animation:nhp-pulse-slow 2s ease-in-out infinite alternate;
  box-shadow:0 0 8px rgba(167,139,250,.7);
}
.nhp-tagline-pill span { font-size:13px; font-weight:500; color:rgba(221,214,254,.85); }

@media (max-width: 680px) {
  #screen-login.nhp-min-h-screen {
    align-items: center;
    justify-content: center;
    min-height: 100dvh;
    overflow: hidden;
    padding: 10px 10px;
  }

  .nhp-card-wrapper {
    width: min(100%, 30rem);
    max-width: 30rem;
    max-height: calc(100dvh - 20px - env(safe-area-inset-top) - env(safe-area-inset-bottom));
    padding: 6px 0;
    margin: 0 auto;
  }

  .nhp-card {
    max-height: calc(100dvh - 54px - env(safe-area-inset-top) - env(safe-area-inset-bottom));
    overflow: hidden;
  }

  .nhp-card-header {
    padding: 22px 16px 18px;
  }

  .nhp-card-body {
    padding: 16px 14px 14px;
  }

  .nhp-card-input {
    height: 46px;
    font-size: 16px;
    letter-spacing: .14em;
  }

  .nhp-card-btn {
    height: 41px;
    font-size: 13px;
  }

  .nhp-reward-card {
    padding: 8px 5px;
  }

  .nhp-r-icon {
    font-size: 20px;
    margin-bottom: 3px;
  }

  .nhp-r-label {
    font-size: 10px;
  }

  .nhp-tagline-wrap {
    margin-top: 8px;
  }
}

@media (max-width: 680px) and (max-height: 760px) {
  .nhp-tagline-wrap {
    display: none;
  }

  .nhp-card-header {
    padding: 18px 14px 14px;
  }

  .nhp-card-body {
    padding: 12px 12px 10px;
  }

  .nhp-gift-icon-wrap {
    margin-bottom: 14px;
  }

  .nhp-gift-icon-box {
    padding: 12px;
    border-radius: 14px;
  }

  .nhp-gift-icon-box svg:first-child {
    width: 44px;
    height: 44px;
  }
}

/* ── Keyframes ── */
@keyframes nhp-orb-drift {
  from { transform:translate(0,0) scale(1); }
  to   { transform:translate(38px,26px) scale(1.1); }
}
@keyframes nhp-blob-float {
  from { transform:translate(0,0); }
  to   { transform:translate(var(--bx,20px), var(--by,-30px)); }
}
@keyframes nhp-twinkle {
  from { opacity:var(--o); transform:scale(1); }
  to   { opacity:calc(var(--o)*.2); transform:scale(.5); }
}
@keyframes nhp-shape-float {
  0%   { transform: translateY(0px) rotate(var(--r0,0deg)); }
  100% { transform: translateY(var(--float-y,-24px)) rotate(var(--r1,15deg)); }
}
</style>

