<!-- WITHDRAW MODAL -->
<div class="modal-overlay" id="withdrawModal">
  <div class="modal-card">
    <div class="modal-header">
      <span class="modal-title">Rút tiền</span>
      <button class="modal-close" onclick="closeWithdrawModal()">✕</button>
    </div>
    <div class="modal-avail">Số dư khả dụng: <span id="modalBalance">4.900.000 đ</span></div>

    <div class="form-group">
      <label class="form-label">
        <svg width="14" height="14" fill="none" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="7" r="4" stroke="currentColor" stroke-width="2"/></svg>
        Họ và tên liên hệ
      </label>
      <input type="text" class="form-input" id="withdrawCustomerName" placeholder="Nguyễn Văn A" />
      <div class="field-error" id="withdrawCustomerNameError"></div>
    </div>

    <div class="form-group">
      <label class="form-label">
        <svg width="14" height="14" fill="none" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.01 1.18 2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Số điện thoại liên hệ
      </label>
      <input type="tel" class="form-input" id="withdrawCustomerPhone" placeholder="0912345678" />
      <div class="field-error" id="withdrawCustomerPhoneError"></div>
    </div>

    <div class="form-group">
      <label class="form-label">
        <svg width="14" height="14" fill="none" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="2"/><path d="m22 6-10 7L2 6" stroke="currentColor" stroke-width="2"/></svg>
        Email liên hệ
      </label>
      <input type="email" class="form-input" id="withdrawCustomerEmail" placeholder="mail@example.com" />
      <div class="field-error" id="withdrawCustomerEmailError"></div>
    </div>

    <div class="form-group">
      <label class="form-label">
        <svg width="14" height="14" fill="none" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2" stroke="currentColor" stroke-width="2"/><path d="M16 14a1 1 0 100-2 1 1 0 000 2z" fill="currentColor"/></svg>
        Ngân hàng
      </label>
      <select class="form-select" id="withdrawBank">
        <option value="">-- Đang tải danh sách ngân hàng --</option>
      </select>
      <div class="field-error" id="withdrawBankError"></div>
      <div id="bankLoadingSpinner" class="bank-loading-spinner" style="display: none; font-size: 12px; color: #6366f1; margin-top: 4px;">
        ⏳ Đang tải...
      </div>
    </div>

    <div class="form-group">
      <label class="form-label">
        <svg width="14" height="14" fill="none" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2" stroke="currentColor" stroke-width="2"/></svg>
        Số tài khoản
      </label>
      <input type="text" class="form-input" id="withdrawAccount" placeholder="Nhập số tài khoản" />
      <div class="field-error" id="withdrawAccountError"></div>
    </div>

    <div class="form-group">
      <label class="form-label">
        <svg width="14" height="14" fill="none" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="7" r="4" stroke="currentColor" stroke-width="2"/></svg>
        Tên tài khoản
      </label>
      <input type="text" class="form-input" id="withdrawName" placeholder="NGUYEN VAN A" style="text-transform:uppercase" />
      <div class="field-error" id="withdrawNameError"></div>
    </div>

    <div class="form-group">
      <label class="form-label">
        <svg width="14" height="14" fill="none" viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23" stroke="currentColor" stroke-width="2"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        Số tiền rút
      </label>
        <input type="text" class="form-input" id="withdrawAmount" placeholder="Nhập số tiền (VD: 1,000,000)" inputmode="numeric" />
      <div class="field-error" id="withdrawAmountError"></div>
      <div class="form-note">Số tiền tối thiểu: 10,000 VND</div>
    </div>

    <div class="withdraw-notice">
      <span>⚠️</span>
      <span>Yêu cầu rút tiền sẽ được xử lý trong vòng 12 giờ. Vui lòng kiểm tra thông tin tài khoản trước khi xác nhận.</span>
      
    </div>

    <div id="existingWithdrawalNotice" class="existing-withdrawal-notice" style="display:none;"></div>

    <div class="modal-actions">
      <button class="btn-cancel" onclick="closeWithdrawModal()">Hủy</button>
      <button id="withdrawSubmitBtn" class="btn-confirm-withdraw" onclick="confirmWithdraw()">Xác nhận rút tiền</button>
    </div>
  </div>
</div>
